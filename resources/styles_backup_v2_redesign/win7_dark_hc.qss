/* Torrent 2000 -- "Windows 7 (Aero)" skin, HIGH-CONTRAST DARK variant.
   FULL REWRITE.

   Follows the project-wide dark_hc contract (see theme_manager.py's
   title_bar_style_for(): every theme's caption goes solid black/white with
   a #FFFF00 yellow accent in "dark_hc", regardless of that theme's normal
   look) rather than Win7-specific photographic research -- true
   accessibility high-contrast mode intentionally drops decorative identity
   (no gradients, no glass, no bevels) in favor of flat, unambiguous edges,
   the same way it does on a real Windows "High Contrast Black" system
   theme. The 6px window-echoing corner radius and Segoe UI font are kept
   so it still reads as "this app's Aero shape", just in accessibility mode.

   Token palette (name -> hex -> role):
     --win7-bg      #000000   every surface (flat -- HC mode separates areas
                               with border weight, not fill)
     --win7-border   #FFFFFF  every control outline, 2px
     --win7-text     #FFFFFF  primary text
     --win7-muted    #7F7F7F  disabled text/borders
     --win7-accent   #FFFF00  universal focus/hover/selection accent (matches
                               the title bar's dark_hc convention)
     --win7-danger   #FF3B30  destructive actions at rest (still yellow on
                               focus/hover -- red only marks the resting state)

   The title bar is NOT drawn by this stylesheet -- see
   src/torrent2000/ui/widgets/app_title_bar.py.
*/

* {
    font-family: "Segoe UI", "MS Shell Dlg 2", sans-serif;
    font-size: 9pt;
}

QMainWindow, QWidget#centralWidget {
    background-color: #000000;
}

/* Deliberately no background-color here (only color) -- see win7.qss for
   the reproduced mechanism: a generic QWidget { background-color; } rule
   defeats QComboBox QAbstractItemView's selection-background-color for
   the popup's current/selected row. QMainWindow/#centralWidget/QDialog
   below carry the actual #000000 fill; plain QWidget containers stay
   transparent and show that ancestor fill through, which looks identical. */
QWidget {
    color: #FFFFFF;
}

QDialog {
    background-color: #000000;
    color: #FFFFFF;
}

/* ---------------------------------------------------------------------
   Tabs
   --------------------------------------------------------------------- */

QTabWidget::pane {
    border: 2px solid #FFFFFF;
    background-color: #000000;
    top: -1px;
}

QTabBar::tab {
    background-color: #000000;
    border: 2px solid #FFFFFF;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 5px 16px;
    margin-right: 2px;
    color: #FFFFFF;
}

QTabBar::tab:selected {
    background-color: #000000;
    border-color: #FFFF00;
    border-bottom: 2px solid #000000;
    margin-top: 0px;
}

QTabBar::tab:!selected {
    margin-top: 2px;
}

QTabBar::tab:hover:!selected {
    background-color: #1A1A1A;
    border-color: #FFFF00;
    color: #FFFF00;
}

QTabBar::tab:disabled {
    color: #7F7F7F;
    border-color: #7F7F7F;
}

QTabBar::tab:focus {
    outline: 3px solid #FFFF00;
    outline-offset: -4px;
}

QTabWidget#mainTabs::pane {
    border-top: none;
    top: 0px;
}

/* ---------------------------------------------------------------------
   Group boxes
   --------------------------------------------------------------------- */

QGroupBox {
    border: 2px solid #FFFFFF;
    border-radius: 6px;
    margin-top: 10px;
    padding-top: 6px;
    background-color: #000000;
    font-weight: normal;
    color: #FFFFFF;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #FFFFFF;
}

/* ---------------------------------------------------------------------
   Buttons -- flat, no gradients; the resting/hover/pressed cue is border
   and fill swap only.
   --------------------------------------------------------------------- */

QPushButton {
    background-color: #000000;
    border: 2px solid #FFFFFF;
    border-radius: 6px;
    padding: 4px 14px;
    min-height: 18px;
    color: #FFFFFF;
}

QPushButton:hover:!pressed {
    border: 2px solid #FFFF00;
    color: #FFFF00;
}

QPushButton:pressed {
    background-color: #FFFF00;
    border: 2px solid #FFFF00;
    color: #000000;
    padding: 5px 13px 3px 15px;
}

QPushButton:default {
    border-width: 3px;
    border-color: #FFFFFF;
}

QPushButton:disabled {
    background-color: #000000;
    border: 2px solid #7F7F7F;
    color: #7F7F7F;
}

QPushButton:focus {
    outline: 3px solid #FFFF00;
    outline-offset: 2px;
    outline-radius: 8px;
}

QPushButton#dangerButton {
    background-color: #000000;
    border: 2px solid #FF3B30;
    border-radius: 6px;
    padding: 2px 12px;
    min-height: 16px;
    color: #FF3B30;
}

QPushButton#dangerButton:hover:!pressed {
    border: 2px solid #FFFF00;
    color: #FFFF00;
}

QPushButton#dangerButton:pressed {
    background-color: #FF3B30;
    border: 2px solid #FF3B30;
    color: #000000;
    padding: 3px 11px 1px 13px;
}

QPushButton#dangerButton:disabled {
    background-color: #000000;
    border: 2px solid #7F7F7F;
    color: #7F7F7F;
}

QPushButton#dangerButton:focus {
    outline: 3px solid #FFFF00;
    outline-offset: 2px;
    outline-radius: 8px;
}

/* ---------------------------------------------------------------------
   Inputs
   --------------------------------------------------------------------- */

QLineEdit, QSpinBox, QAbstractSpinBox {
    background-color: #000000;
    border: 2px solid #FFFFFF;
    border-radius: 6px;
    padding: 2px 5px;
    color: #FFFFFF;
    selection-background-color: #FFFF00;
    selection-color: #000000;
}

QLineEdit:hover, QSpinBox:hover, QAbstractSpinBox:hover {
    border: 2px solid #FFFF00;
}

QLineEdit:focus, QSpinBox:focus, QAbstractSpinBox:focus {
    outline: 3px solid #FFFF00;
    outline-offset: 1px;
    outline-radius: 7px;
}

QLineEdit:disabled, QSpinBox:disabled, QAbstractSpinBox:disabled {
    background-color: #000000;
    border: 2px solid #7F7F7F;
    color: #7F7F7F;
}

QAbstractSpinBox::up-button, QAbstractSpinBox::down-button {
    subcontrol-origin: border;
    width: 18px;
    background-color: #000000;
    border-left: 2px solid #FFFFFF;
}

QAbstractSpinBox::up-button {
    subcontrol-position: top right;
    border-top-right-radius: 6px;
}

QAbstractSpinBox::down-button {
    subcontrol-position: bottom right;
    border-bottom-right-radius: 6px;
}

QAbstractSpinBox::up-button:hover, QAbstractSpinBox::down-button:hover {
    background-color: #1A1A1A;
    border-left: 2px solid #FFFF00;
}

QAbstractSpinBox::up-button:pressed, QAbstractSpinBox::down-button:pressed {
    background-color: #FFFF00;
    border-left: 2px solid #FFFF00;
}

QAbstractSpinBox::up-arrow {
    width: 0; height: 0;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-bottom: 4px solid #FFFFFF;
}

QAbstractSpinBox::down-arrow {
    width: 0; height: 0;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-top: 4px solid #FFFFFF;
}

/* ---------------------------------------------------------------------
   Combo box -- and its POPUP. Same fix as the other two variants: QComboBox
   needs its own selection-background-color/selection-color in addition to
   the popup view's, or the popup's currently-selected row opens with no
   visible highlight (see win7.qss header for the full root-cause) --
   high contrast makes an unstyled fallback state especially dangerous, so
   this is spelled out just as explicitly here.
   --------------------------------------------------------------------- */

QComboBox {
    background-color: #000000;
    border: 2px solid #FFFFFF;
    border-radius: 6px;
    padding: 2px 5px;
    color: #FFFFFF;
    /* Also required (not just on the popup view below) -- see win7.qss for
       the reproduced/bisected mechanism: without this, the popup's
       currently-selected row opens with no visible highlight at all. */
    selection-background-color: #FFFF00;
    selection-color: #000000;
}

QComboBox:hover {
    border: 2px solid #FFFF00;
}

QComboBox:focus {
    outline: 3px solid #FFFF00;
    outline-offset: 1px;
    outline-radius: 7px;
}

QComboBox:disabled {
    background-color: #000000;
    border: 2px solid #7F7F7F;
    color: #7F7F7F;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: right;
    width: 20px;
    background-color: #000000;
    border-left: 2px solid #FFFFFF;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
}

QComboBox::drop-down:hover {
    border-left: 2px solid #FFFF00;
}

QComboBox::down-arrow {
    width: 8px;
    height: 8px;
    image: none;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-top: 4px solid #FFFFFF;
}

QComboBox QAbstractItemView {
    background-color: #000000;
    color: #FFFFFF;
    border: 2px solid #FFFFFF;
    outline: none;
    selection-background-color: #FFFF00;
    selection-color: #000000;
    padding: 2px;
}

QComboBox QAbstractItemView::item {
    padding: 4px 8px;
    border-radius: 4px;
    color: #FFFFFF;
    background-color: transparent;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #333300;
    color: #FFFF00;
}

/* The bug-fix rule: explicit, always-contrasting selected/current state,
   independent of whether the popup window itself is "active" yet. */
QComboBox QAbstractItemView::item:selected,
QComboBox QAbstractItemView::item:selected:active,
QComboBox QAbstractItemView::item:selected:!active {
    background-color: #FFFF00;
    color: #000000;
}

/* ---------------------------------------------------------------------
   Checkboxes
   --------------------------------------------------------------------- */

QCheckBox::indicator {
    width: 14px;
    height: 14px;
    background-color: #000000;
    border: 2px solid #FFFFFF;
    border-radius: 3px;
}

QCheckBox::indicator:hover {
    border: 2px solid #FFFF00;
}

QCheckBox::indicator:checked {
    background-color: #FFFF00;
    border: 2px solid #FFFF00;
    image: url(theme:checkmark.png);
}

QCheckBox::indicator:focus {
    outline: 3px solid #FFFF00;
    outline-offset: 1px;
    outline-radius: 5px;
}

QCheckBox::indicator:disabled {
    background-color: #000000;
    border: 2px solid #7F7F7F;
}

QCheckBox:disabled {
    color: #7F7F7F;
}

/* ---------------------------------------------------------------------
   Sliders
   --------------------------------------------------------------------- */

QSlider::groove:horizontal {
    height: 4px;
    background-color: #FFFFFF;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    width: 15px;
    height: 15px;
    margin: -7px 0;
    background-color: #FFFF00;
    border: 2px solid #FFFF00;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background-color: #000000;
    border: 2px solid #FFFF00;
}

QSlider::handle:horizontal:focus {
    outline: 3px solid #FFFF00;
    outline-offset: 2px;
    outline-radius: 9px;
}

QSlider::handle:horizontal:disabled {
    background-color: #000000;
    border: 2px solid #7F7F7F;
}

/* ---------------------------------------------------------------------
   Tables / trees
   --------------------------------------------------------------------- */

QTableWidget, QTreeWidget {
    background-color: #000000;
    alternate-background-color: #1A1A1A;
    gridline-color: #7F7F7F;
    border: 2px solid #FFFFFF;
    border-radius: 6px;
    color: #FFFFFF;
    selection-background-color: #FFFF00;
    selection-color: #000000;
}

QTableWidget::item, QTreeWidget::item {
    padding: 2px 4px;
}

QTableWidget::item:hover, QTreeWidget::item:hover {
    background-color: #333300;
    color: #FFFF00;
}

QTableWidget::item:selected, QTreeWidget::item:selected {
    background-color: #FFFF00;
    color: #000000;
}

QHeaderView::section {
    background-color: #000000;
    border: 2px solid #FFFFFF;
    padding: 3px 6px;
    font-weight: normal;
    color: #FFFFFF;
}

QHeaderView::section:hover {
    border: 2px solid #FFFF00;
    color: #FFFF00;
}

/* ---------------------------------------------------------------------
   List widget
   --------------------------------------------------------------------- */

QListWidget {
    background-color: #000000;
    border: 2px solid #FFFFFF;
    border-radius: 6px;
    padding: 2px;
    outline: none;
    color: #FFFFFF;
}

QListWidget::item {
    padding: 4px 6px;
    border-radius: 4px;
    color: #FFFFFF;
}

QListWidget::item:hover:!selected {
    background-color: #333300;
    color: #FFFF00;
}

QListWidget::item:selected {
    background-color: #FFFF00;
    color: #000000;
}

QListWidget::item:selected:!active {
    background-color: #FFFF00;
    color: #000000;
}

QListWidget:focus {
    outline: 3px solid #FFFF00;
    outline-offset: -2px;
}

/* ---------------------------------------------------------------------
   Context menus
   --------------------------------------------------------------------- */

QMenu {
    background-color: #000000;
    border: 2px solid #FFFFFF;
    border-radius: 6px;
    padding: 4px;
    color: #FFFFFF;
}

QMenu::item {
    background: transparent;
    padding: 6px 28px 6px 14px;
    margin: 1px;
    border-radius: 4px;
    color: #FFFFFF;
}

QMenu::item:selected {
    background-color: #FFFF00;
    border: 1px solid #FFFF00;
    color: #000000;
}

QMenu::item:disabled {
    color: #7F7F7F;
}

QMenu::separator {
    height: 2px;
    background-color: #FFFFFF;
    margin: 4px 8px;
}

QMenu::indicator {
    width: 14px;
    height: 14px;
    left: 4px;
}

/* ---------------------------------------------------------------------
   Progress bar
   --------------------------------------------------------------------- */

QProgressBar {
    border: 2px solid #FFFFFF;
    border-radius: 6px;
    background-color: #000000;
    text-align: center;
    color: #FFFFFF;
}

QProgressBar::chunk {
    background-color: #FFFF00;
    border-radius: 4px;
    margin: 1px;
}

QToolTip {
    background-color: #000000;
    color: #FFFFFF;
    border: 2px solid #FFFFFF;
    border-radius: 4px;
    padding: 4px 8px;
}

QLabel {
    background: transparent;
    color: #FFFFFF;
}

QLabel:disabled {
    color: #7F7F7F;
}

QSplitter::handle {
    background-color: #000000;
}

QScrollBar:vertical {
    background: #000000;
    width: 16px;
    border: 2px solid #FFFFFF;
}

QScrollBar::handle:vertical {
    background-color: #FFFFFF;
    border-radius: 3px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background-color: #FFFF00;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
    background: none;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background: #000000;
    height: 16px;
    border: 2px solid #FFFFFF;
}

QScrollBar::handle:horizontal {
    background-color: #FFFFFF;
    border-radius: 3px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #FFFF00;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
    background: none;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

QSizeGrip {
    background-color: #000000;
    width: 16px;
    height: 16px;
}
