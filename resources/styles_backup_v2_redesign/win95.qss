/* Torrent 2000 -- "Windows 95" retro skin (Chicago).

   Rebuilt from real Windows 95 screenshots (GUIdebook Gallery, Wikimedia
   Commons), pixel-sampled with PIL (see scratchpad/win95research/ for the
   downloaded PNGs, the sampling script, and the derived charte graphique).
   Every token below is a measured value, not a guess:

     bg            #C0C0C0   window / dialog / menu / button face
                             (measured: dialog face in About/Open/Mouse
                             Properties screenshots, Start-menu panel)
     bg-secondary  #FFFFFF   editable surfaces: fields, lists, tables, dropdowns
                             (measured: Open dialog's file listbox and fields)
     text          #000000   window text
     text-muted    #808080   disabled text (real 95 also embosses a +1px white
                             offset for a carved look; QSS can't paint two-tone
                             text, so flat gray is the assumed ceiling here)
     accent        #000080   navy selection / focus / title bar
                             (measured: caption bar, Start-menu highlighted item)
     accent-hover  #0000FF   pure VGA "Blue" -- a real basic-palette swatch
                             (measured from the classic Color dialog's 16-color
                             grid), reused here as a border-only hover tint.
                             Real 95 had no hover state at all; this is the
                             same restrained modernization used project-wide
                             elsewhere -- a border tint, never a fill.
     danger        #800000   VGA "Maroon" -- also a measured basic-palette
                             swatch, used for the destructive-action accent
     border-shadow #808080   mid-gray bevel edge (measured: listbox/field
                             outer sunken edge, gridlines)
     border-frame  #000000   innermost dark bevel edge (measured: field's
                             inner sunken edge, button's outer shadow side)

   Bevel grammar, confirmed by scanning real pixel rows across a sunken
   field's border in the Open dialog screenshot:
     raised (buttons, headers, scrollbar parts): top/left #FFFFFF,
       bottom/right #000000, 2px.
     sunken (fields, lists, groupbox): top/left #808080 then #000000,
       bottom/right #FFFFFF -- inverse of raised.

   Sharp square corners everywhere (border-radius: 0, no exceptions -- this
   also matches window_corner_radius=0 for win95_classic in theme_manager.py),
   thick crisp 2px bevels, no gradients, no soft edges.

   The title bar (solid navy caption, no gradient) is NOT drawn by this
   stylesheet -- see src/torrent2000/ui/widgets/app_title_bar.py.
*/

* {
    font-family: "MS Sans Serif", "Tahoma", sans-serif;
    font-size: 9pt;
}

QMainWindow, QWidget#centralWidget {
    background-color: #C0C0C0;
}

QWidget {
    background-color: #C0C0C0;
    color: #000000;
}

/* ---------------------------------------------------------------------
   Tabs
   --------------------------------------------------------------------- */

QTabWidget::pane {
    border-width: 2px;
    border-style: solid;
    border-top-color: #FFFFFF;
    border-left-color: #FFFFFF;
    border-right-color: #000000;
    border-bottom-color: #000000;
    border-radius: 0px;
    background-color: #C0C0C0;
    top: -1px;
}

QTabWidget#mainTabs::pane {
    border-top: none;
    top: 0px;
}

QTabBar::tab {
    background-color: #C0C0C0;
    border-width: 2px;
    border-style: outset;
    border-top-color: #FFFFFF;
    border-left-color: #FFFFFF;
    border-right-color: #808080;
    border-bottom: none;
    border-radius: 0px;
    padding: 4px 14px;
    margin-right: 0px;
    color: #000000;
}

QTabBar::tab:selected {
    background-color: #C0C0C0;
    border-bottom: 2px solid #C0C0C0;
    margin-top: 0px;
}

QTabBar::tab:!selected {
    margin-top: 2px;
    color: #202020;
}

QTabBar::tab:hover:!selected {
    border-top-color: #0000FF;
    border-left-color: #0000FF;
    color: #000000;
}

QTabBar::tab:disabled {
    color: #808080;
}

QTabBar::tab:focus {
    outline: 2px solid #000080;
    outline-offset: 1px;
}

/* ---------------------------------------------------------------------
   Group boxes -- etched (sunken) frame, matching real 95 static groups
   --------------------------------------------------------------------- */

QGroupBox {
    border-width: 2px;
    border-style: solid;
    border-top-color: #808080;
    border-left-color: #808080;
    border-right-color: #FFFFFF;
    border-bottom-color: #FFFFFF;
    border-radius: 0px;
    margin-top: 10px;
    padding-top: 6px;
    background-color: #C0C0C0;
    font-weight: bold;
    color: #000000;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #000000;
}

/* ---------------------------------------------------------------------
   Buttons -- raised bevel, inverts to sunken when pressed
   --------------------------------------------------------------------- */

QPushButton {
    background-color: #C0C0C0;
    border-width: 2px;
    border-style: outset;
    border-radius: 0px;
    border-top-color: #FFFFFF;
    border-left-color: #FFFFFF;
    border-right-color: #000000;
    border-bottom-color: #000000;
    padding: 4px 12px;
    min-height: 18px;
    color: #000000;
}

QPushButton:hover:!pressed {
    border-top-color: #FFFFFF;
    border-left-color: #FFFFFF;
    border-right-color: #0000FF;
    border-bottom-color: #0000FF;
}

QPushButton:focus {
    outline: 2px solid #000080;
    outline-offset: 2px;
}

QPushButton:pressed {
    background-color: #C0C0C0;
    border-style: inset;
    border-top-color: #000000;
    border-left-color: #000000;
    border-right-color: #FFFFFF;
    border-bottom-color: #FFFFFF;
    padding: 5px 11px 3px 13px;
}

QPushButton:default {
    /* Real 95 draws an extra 1px black outer rim around the default
       button (confirmed on the About dialog's OK button); a wider bevel
       is the closest a single QSS border can get to that look. */
    border-width: 3px;
}

QPushButton:disabled {
    background-color: #C0C0C0;
    border-width: 2px;
    border-style: outset;
    border-top-color: #FFFFFF;
    border-left-color: #FFFFFF;
    border-right-color: #808080;
    border-bottom-color: #808080;
    color: #808080;
}

QPushButton#dangerButton {
    background-color: #C0A0A0;
    border-width: 2px;
    border-style: outset;
    border-radius: 0px;
    border-top-color: #E8C8C8;
    border-left-color: #E8C8C8;
    border-right-color: #800000;
    border-bottom-color: #800000;
    padding: 2px 10px;
    min-height: 16px;
    color: #000000;
}

QPushButton#dangerButton:hover:!pressed {
    border-top-color: #E8C8C8;
    border-left-color: #E8C8C8;
    border-right-color: #000080;
    border-bottom-color: #000080;
}

QPushButton#dangerButton:focus {
    outline: 2px solid #000080;
    outline-offset: 2px;
}

QPushButton#dangerButton:pressed {
    background-color: #A87878;
    border-style: inset;
    border-top-color: #800000;
    border-left-color: #800000;
    border-right-color: #E8C8C8;
    border-bottom-color: #E8C8C8;
    padding: 3px 9px 1px 11px;
}

QPushButton#dangerButton:disabled {
    background-color: #C0C0C0;
    border-top-color: #FFFFFF;
    border-left-color: #FFFFFF;
    border-right-color: #808080;
    border-bottom-color: #808080;
    color: #808080;
}

/* ---------------------------------------------------------------------
   Text fields / spin boxes -- sunken bevel, white editable surface
   --------------------------------------------------------------------- */

QLineEdit, QSpinBox, QAbstractSpinBox {
    background-color: #FFFFFF;
    border-width: 2px;
    border-style: inset;
    border-top-color: #808080;
    border-left-color: #808080;
    border-right-color: #FFFFFF;
    border-bottom-color: #FFFFFF;
    border-radius: 0px;
    padding: 2px 4px;
    color: #000000;
    selection-background-color: #000080;
    selection-color: #FFFFFF;
}

QLineEdit:hover, QSpinBox:hover, QAbstractSpinBox:hover {
    border-top-color: #0000FF;
    border-left-color: #0000FF;
}

QLineEdit:focus, QSpinBox:focus, QAbstractSpinBox:focus {
    outline: 2px solid #000080;
    outline-offset: 1px;
}

QLineEdit:disabled, QSpinBox:disabled, QAbstractSpinBox:disabled {
    background-color: #C0C0C0;
    border-top-color: #808080;
    border-left-color: #808080;
    border-right-color: #C0C0C0;
    border-bottom-color: #C0C0C0;
    color: #808080;
}

QAbstractSpinBox::up-button, QAbstractSpinBox::down-button {
    subcontrol-origin: border;
    width: 15px;
    background-color: #C0C0C0;
    border-width: 1px;
    border-style: outset;
    border-top-color: #FFFFFF;
    border-left-color: #FFFFFF;
    border-right-color: #000000;
    border-bottom-color: #000000;
}

QAbstractSpinBox::up-button {
    subcontrol-position: top right;
}

QAbstractSpinBox::down-button {
    subcontrol-position: bottom right;
}

QAbstractSpinBox::up-button:pressed, QAbstractSpinBox::down-button:pressed {
    border-style: inset;
    border-top-color: #000000;
    border-left-color: #000000;
    border-right-color: #FFFFFF;
    border-bottom-color: #FFFFFF;
}

QAbstractSpinBox::up-arrow {
    image: none;
    width: 0px;
    height: 0px;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-bottom: 4px solid #000000;
}

QAbstractSpinBox::down-arrow {
    image: none;
    width: 0px;
    height: 0px;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-top: 4px solid #000000;
}

QAbstractSpinBox::up-arrow:disabled, QAbstractSpinBox::down-arrow:disabled {
    border-bottom-color: #808080;
    border-top-color: #808080;
}

/* ---------------------------------------------------------------------
   Combo boxes
   --------------------------------------------------------------------- */

QComboBox {
    background-color: #FFFFFF;
    border-width: 2px;
    border-style: inset;
    border-top-color: #808080;
    border-left-color: #808080;
    border-right-color: #FFFFFF;
    border-bottom-color: #FFFFFF;
    border-radius: 0px;
    padding: 2px 4px;
    color: #000000;
    /* Also required on QComboBox itself, not just on the popup's
       QAbstractItemView below -- without this, the popup's currently
       selected row opens with no visible highlight at all (confirmed by
       rendering the popup offscreen; harmonization pass, matches the
       win7 family's own documented fix for the same Qt behavior). */
    selection-background-color: #000080;
    selection-color: #FFFFFF;
}

QComboBox:hover {
    border-top-color: #0000FF;
    border-left-color: #0000FF;
}

QComboBox:focus {
    outline: 2px solid #000080;
    outline-offset: 1px;
}

QComboBox:disabled {
    background-color: #C0C0C0;
    color: #808080;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: right;
    width: 18px;
    background-color: #C0C0C0;
    border-width: 2px;
    border-style: outset;
    border-top-color: #FFFFFF;
    border-left-color: #FFFFFF;
    border-right-color: #000000;
    border-bottom-color: #000000;
}

QComboBox::drop-down:hover {
    border-top-color: #FFFFFF;
    border-left-color: #FFFFFF;
    border-right-color: #0000FF;
    border-bottom-color: #0000FF;
}

QComboBox::down-arrow {
    width: 8px;
    height: 8px;
    image: none;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-top: 4px solid #000000;
}

QComboBox::down-arrow:disabled {
    border-top-color: #808080;
}

/* Popup list -- explicitly gives every item, including the CURRENTLY
   SELECTED one, its own text color via item:selected so it can never
   land on the same color as its background (the known Windows 7 v1 bug
   this rebuild must not repeat). The base rule's selection-color only
   covers the transient keyboard-highlight paint path; item:selected is
   what Qt actually paints for the item matching the combo's current
   value when the popup opens, so it needs its own explicit color too. */
QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 2px solid #000000;
    border-radius: 0px;
    padding: 1px;
    outline: none;
    color: #000000;
    selection-background-color: #000080;
    selection-color: #FFFFFF;
}

QComboBox QAbstractItemView::item {
    color: #000000;
    background-color: #FFFFFF;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #000080;
    color: #FFFFFF;
}

/* ---------------------------------------------------------------------
   Checkboxes
   --------------------------------------------------------------------- */

QCheckBox::indicator {
    width: 12px;
    height: 12px;
    background-color: #FFFFFF;
    border-width: 2px;
    border-style: inset;
    border-top-color: #808080;
    border-left-color: #808080;
    border-right-color: #FFFFFF;
    border-bottom-color: #FFFFFF;
}

QCheckBox::indicator:checked {
    background-color: #FFFFFF;
    image: url(theme:checkmark.png);
}

QCheckBox::indicator:hover {
    border-top-color: #0000FF;
    border-left-color: #0000FF;
}

QCheckBox::indicator:focus {
    outline: 2px solid #000080;
    outline-offset: 1px;
}

QCheckBox::indicator:disabled {
    background-color: #C0C0C0;
    border-top-color: #808080;
    border-left-color: #808080;
    border-right-color: #C0C0C0;
    border-bottom-color: #C0C0C0;
}

QCheckBox:disabled {
    color: #808080;
}

/* ---------------------------------------------------------------------
   Sliders
   --------------------------------------------------------------------- */

QSlider::groove:horizontal {
    height: 4px;
    background-color: #808080;
    border: 2px solid #000000;
}

QSlider::handle:horizontal {
    width: 12px;
    margin: -6px 0;
    background-color: #C0C0C0;
    border-width: 2px;
    border-style: outset;
    border-top-color: #FFFFFF;
    border-left-color: #FFFFFF;
    border-right-color: #000000;
    border-bottom-color: #000000;
}

QSlider::handle:horizontal:hover {
    border-right-color: #0000FF;
    border-bottom-color: #0000FF;
}

QSlider::handle:horizontal:focus {
    outline: 2px solid #000080;
    outline-offset: 2px;
}

QSlider::handle:horizontal:disabled {
    border-top-color: #FFFFFF;
    border-left-color: #FFFFFF;
    border-right-color: #808080;
    border-bottom-color: #808080;
}

/* ---------------------------------------------------------------------
   Tables / trees / lists -- sunken bevel, white content surface
   --------------------------------------------------------------------- */

QTableWidget, QTreeWidget, QListWidget {
    background-color: #FFFFFF;
    alternate-background-color: #E8E8E8;
    gridline-color: #808080;
    border-width: 2px;
    border-style: inset;
    border-top-color: #808080;
    border-left-color: #808080;
    border-right-color: #FFFFFF;
    border-bottom-color: #FFFFFF;
    border-radius: 0px;
    color: #000000;
    selection-background-color: #000080;
    selection-color: #FFFFFF;
    outline: none;
}

QListWidget::item {
    padding: 2px 4px;
}

QListWidget::item:selected {
    background-color: #000080;
    color: #FFFFFF;
}

QListWidget::item:hover:!selected {
    background-color: rgba(0, 0, 128, 0.18);
    color: #000000;
}

QHeaderView::section {
    background-color: #C0C0C0;
    border-width: 1px;
    border-style: outset;
    border-top-color: #FFFFFF;
    border-left-color: #FFFFFF;
    border-right-color: #000000;
    border-bottom-color: #000000;
    padding: 3px;
    font-weight: bold;
    color: #000000;
}

/* ---------------------------------------------------------------------
   Menus -- raised bevel popup, gray face like every other 95 panel
   (measured: the Start menu's own popup face and its navy highlighted
   item in desktop_full.png)
   --------------------------------------------------------------------- */

QMenu {
    background-color: #C0C0C0;
    border-width: 2px;
    border-style: outset;
    border-top-color: #FFFFFF;
    border-left-color: #FFFFFF;
    border-right-color: #000000;
    border-bottom-color: #000000;
    border-radius: 0px;
    padding: 2px;
    color: #000000;
}

QMenu::item {
    background-color: transparent;
    padding: 4px 22px 4px 20px;
    border: 1px solid transparent;
}

QMenu::item:selected {
    background-color: #000080;
    color: #FFFFFF;
    border: 1px solid #000080;
}

QMenu::item:disabled {
    color: #808080;
}

QMenu::separator {
    height: 2px;
    margin: 4px 2px;
    background-color: #808080;
    border-bottom: 1px solid #FFFFFF;
}

/* ---------------------------------------------------------------------
   Dialogs -- must be styled explicitly: top-level QDialog windows do not
   inherit the generic QWidget background at the OS paint layer, so
   without this rule every dialog (Create Torrent, file priorities,
   profiles, ...) falls back to native/white chrome and breaks the theme.
   --------------------------------------------------------------------- */

QDialog {
    background-color: #C0C0C0;
    color: #000000;
}

/* ---------------------------------------------------------------------
   Misc: progress bar, labels, splitter, scrollbars, size grip, tooltip
   --------------------------------------------------------------------- */

QProgressBar {
    border-width: 2px;
    border-style: solid;
    border-top-color: #808080;
    border-left-color: #808080;
    border-right-color: #FFFFFF;
    border-bottom-color: #FFFFFF;
    border-radius: 0px;
    background-color: #FFFFFF;
    text-align: center;
    color: #000000;
}

QProgressBar::chunk {
    background-color: #000080;
    margin: 1px;
}

QLabel {
    background: transparent;
    color: #000000;
}

QLabel:disabled {
    color: #808080;
}

QSplitter::handle {
    background-color: #C0C0C0;
}

QScrollBar:vertical {
    background: #C0C0C0;
    width: 16px;
    border: 1px solid #000000;
}

QScrollBar::handle:vertical {
    background-color: #C0C0C0;
    border-width: 2px;
    border-style: outset;
    border-top-color: #FFFFFF;
    border-left-color: #FFFFFF;
    border-right-color: #000000;
    border-bottom-color: #000000;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    border-right-color: #0000FF;
    border-bottom-color: #0000FF;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    subcontrol-origin: margin;
    height: 16px;
    background-color: #C0C0C0;
    border-width: 2px;
    border-style: outset;
    border-top-color: #FFFFFF;
    border-left-color: #FFFFFF;
    border-right-color: #000000;
    border-bottom-color: #000000;
}

QScrollBar::add-line:vertical {
    subcontrol-position: bottom;
}

QScrollBar::sub-line:vertical {
    subcontrol-position: top;
}

QScrollBar::up-arrow:vertical {
    width: 0px;
    height: 0px;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-bottom: 4px solid #000000;
}

QScrollBar::down-arrow:vertical {
    width: 0px;
    height: 0px;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-top: 4px solid #000000;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: #C0C0C0;
}

QScrollBar:horizontal {
    background: #C0C0C0;
    height: 16px;
    border: 1px solid #000000;
}

QScrollBar::handle:horizontal {
    background-color: #C0C0C0;
    border-width: 2px;
    border-style: outset;
    border-top-color: #FFFFFF;
    border-left-color: #FFFFFF;
    border-right-color: #000000;
    border-bottom-color: #000000;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    border-right-color: #0000FF;
    border-bottom-color: #0000FF;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    subcontrol-origin: margin;
    width: 16px;
    background-color: #C0C0C0;
    border-width: 2px;
    border-style: outset;
    border-top-color: #FFFFFF;
    border-left-color: #FFFFFF;
    border-right-color: #000000;
    border-bottom-color: #000000;
}

QScrollBar::add-line:horizontal {
    subcontrol-position: right;
}

QScrollBar::sub-line:horizontal {
    subcontrol-position: left;
}

QScrollBar::left-arrow:horizontal {
    width: 0px;
    height: 0px;
    border-top: 3px solid transparent;
    border-bottom: 3px solid transparent;
    border-right: 4px solid #000000;
}

QScrollBar::right-arrow:horizontal {
    width: 0px;
    height: 0px;
    border-top: 3px solid transparent;
    border-bottom: 3px solid transparent;
    border-left: 4px solid #000000;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: #C0C0C0;
}

QSizeGrip {
    background-color: #C0C0C0;
    width: 16px;
    height: 16px;
}

QToolTip {
    background-color: #FFFFE1;
    border: 1px solid #000000;
    color: #000000;
    padding: 3px 6px;
}
