/* =====================================================================
   Torrent 2000 -- "CCCP" skin, HIGH-CONTRAST DARK variant

   Matches the real Windows "High Contrast Black" accessibility contract --
   pure black background, pure white text/borders, a single universal
   yellow for focus/selection/accent, zero reliance on hue alone to carry
   meaning -- while keeping this theme's sharp square corners, thick
   borders, and bold Arial. This isn't a poster-measurement exercise like
   cccp.qss/cccp_dark.qss: the accessibility contract dictates the palette
   outright, and the yellow slot is the SAME one already fixed for every
   theme's dark_hc title bar (theme_manager.py's title_bar_style_for,
   minmax_hover_color/close_hover_color -> #FFFF00), so this variant is
   reused as an anchor rather than re-derived.

   TOKENS (hex, named)
   ------------------------------------------------------------------
     bg               #000000   pure black, everywhere -- HC does not
                                 distinguish surfaces by shade, only by the
                                 2px white borders between them
     surface          #000000   panels/cards are the same flat black; depth
                                 comes from borders, not tinting
     border           #FFFFFF   pure white
     text             #FFFFFF   pure white
     text-muted       #FFFFFF   HC has no "dimmer" text tier -- disabled is
                                 the only state allowed to read differently
     accent / focus   #FFFF00   universal yellow -- ALREADY FIXED (title
                                 bar dark_hc convention, theme_manager.py).
                                 Every hover, focus ring, selection, and
                                 progress fill in this file resolves to
                                 this one color.
     disabled-text    #7F7F7F   the one place a mid-gray is allowed --
                                 matches the real Windows HC "GrayText"
                                 system color

   No "danger" red exists in this variant on purpose: Windows High Contrast
   themes intentionally avoid leaning on hue to distinguish a destructive
   control from a normal one (a red-blind user would see no difference).
   #dangerButton instead gets a *structural* tell -- a yellow border by
   default that fully inverts (solid yellow fill, black text) on press,
   exactly like every other button's pressed state, so the affordance
   survives without relying on color alone.

   The title bar is NOT drawn by this stylesheet -- see
   src/torrent2000/ui/widgets/app_title_bar.py and ui/theme/theme_manager.py
   (dark_hc forces every theme's caption to this same black/white/yellow
   contract).
   ===================================================================== */

* {
    font-family: "Arial", "Segoe UI", sans-serif;
    font-size: 9pt;
}

QMainWindow, QWidget#centralWidget, QDialog {
    background-color: #000000;
    color: #FFFFFF;
}

QWidget {
    background-color: #000000;
    color: #FFFFFF;
}

/* ---------------------------------------------------------------- Tabs */

QTabWidget::pane {
    border: 2px solid #FFFFFF;
    background-color: #000000;
    top: -1px;
}

QTabWidget#mainTabs::pane {
    border-top: none;
    top: 0px;
}

QTabBar::tab {
    background-color: #000000;
    border: 2px solid #FFFFFF;
    border-bottom: none;
    border-radius: 0px;
    padding: 5px 16px;
    margin-right: 1px;
    color: #FFFFFF;
    font-weight: bold;
}

QTabBar::tab:hover:!selected {
    background-color: #1A1A00;
    color: #FFFF00;
    border-color: #FFFF00;
}

QTabBar::tab:selected {
    background-color: #000000;
    border-color: #FFFF00;
    border-bottom: 3px solid #000000;
    margin-top: 0px;
    color: #FFFF00;
}

QTabBar::tab:!selected {
    margin-top: 2px;
}

QTabBar::tab:disabled {
    color: #7F7F7F;
    border-color: #7F7F7F;
}

QTabBar::tab:focus {
    outline: 2px solid #FFFF00;
    outline-offset: -3px;
}

/* ------------------------------------------------------------ GroupBox */

QGroupBox {
    border: 2px solid #FFFFFF;
    border-top: 4px solid #FFFF00;
    border-radius: 0px;
    margin-top: 10px;
    padding-top: 10px;
    background-color: #000000;
    font-weight: bold;
    color: #FFFF00;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    top: -2px;
    padding: 0 6px;
    background-color: #000000;
    color: #FFFF00;
}

/* ------------------------------------------------------------- Buttons */

QPushButton {
    background-color: #000000;
    border: 2px solid #FFFFFF;
    border-radius: 0px;
    padding: 4px 12px;
    min-height: 18px;
    color: #FFFFFF;
    font-weight: bold;
}

QPushButton:hover:!pressed {
    background-color: #1A1A00;
    border: 2px solid #FFFF00;
    color: #FFFF00;
}

QPushButton:pressed {
    background-color: #FFFF00;
    border: 2px solid #FFFF00;
    color: #000000;
}

QPushButton:focus {
    outline: 2px solid #FFFF00;
    outline-offset: 2px;
}

QPushButton:default {
    border-width: 3px;
    border-color: #FFFF00;
}

QPushButton:disabled {
    background-color: #000000;
    border: 2px solid #7F7F7F;
    color: #7F7F7F;
}

/* No hue-based "danger" here (see file header) -- a yellow border by
   default, full yellow/black inversion on press, same as every other
   button, so the destructive affordance is structural, not chromatic. */
QPushButton#dangerButton {
    background-color: #000000;
    border: 2px solid #FFFF00;
    border-radius: 0px;
    padding: 2px 10px;
    min-height: 16px;
    color: #FFFF00;
    font-weight: bold;
}

QPushButton#dangerButton:hover:!pressed {
    background-color: #1A1A00;
    border: 2px solid #FFFF00;
    color: #FFFF00;
}

QPushButton#dangerButton:pressed {
    background-color: #FFFF00;
    border: 2px solid #FFFF00;
    color: #000000;
}

QPushButton#dangerButton:focus {
    outline: 2px solid #FFFF00;
    outline-offset: 2px;
}

QPushButton#dangerButton:disabled {
    background-color: #000000;
    border: 2px solid #7F7F7F;
    color: #7F7F7F;
}

/* ---------------------------------------------------------- Text input */

QLineEdit, QSpinBox, QAbstractSpinBox {
    background-color: #000000;
    border: 2px solid #FFFFFF;
    border-radius: 0px;
    padding: 2px 4px;
    color: #FFFFFF;
    selection-background-color: #FFFF00;
    selection-color: #000000;
}

QLineEdit:hover, QSpinBox:hover, QAbstractSpinBox:hover {
    border: 2px solid #FFFF00;
}

QLineEdit:focus, QSpinBox:focus, QAbstractSpinBox:focus {
    border: 2px solid #FFFF00;
    outline: 2px solid #FFFF00;
    outline-offset: 1px;
}

QLineEdit:disabled, QSpinBox:disabled, QAbstractSpinBox:disabled {
    background-color: #000000;
    border: 2px solid #7F7F7F;
    color: #7F7F7F;
}

QAbstractSpinBox::up-button, QAbstractSpinBox::down-button {
    subcontrol-origin: border;
    width: 16px;
    background-color: #000000;
    border-left: 2px solid #FFFFFF;
}

QAbstractSpinBox::up-button {
    subcontrol-position: top right;
    border-bottom: 1px solid #FFFFFF;
}

QAbstractSpinBox::up-button:hover, QAbstractSpinBox::down-button:hover {
    background-color: #1A1A00;
}

QAbstractSpinBox::down-button {
    subcontrol-position: bottom right;
}

QAbstractSpinBox::up-arrow {
    width: 0;
    height: 0;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-bottom: 4px solid #FFFFFF;
}

QAbstractSpinBox::down-arrow {
    width: 0;
    height: 0;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-top: 4px solid #FFFFFF;
}

QAbstractSpinBox::up-arrow:disabled, QAbstractSpinBox::down-arrow:disabled {
    border-bottom-color: #7F7F7F;
    border-top-color: #7F7F7F;
}

/* -------------------------------------------------------------- Combo */

QComboBox {
    background-color: #000000;
    border: 2px solid #FFFFFF;
    border-radius: 0px;
    padding: 2px 4px;
    color: #FFFFFF;
}

QComboBox:hover {
    border: 2px solid #FFFF00;
}

QComboBox:focus {
    border: 2px solid #FFFF00;
    outline: 2px solid #FFFF00;
    outline-offset: 1px;
}

QComboBox:disabled {
    background-color: #000000;
    border: 2px solid #7F7F7F;
    color: #7F7F7F;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: right;
    width: 20px;
    background-color: #000000;
    border-left: 2px solid #FFFFFF;
}

QComboBox::drop-down:hover {
    background-color: #1A1A00;
}

QComboBox::down-arrow {
    width: 8px;
    height: 8px;
    image: none;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-top: 4px solid #FFFFFF;
}

QComboBox::down-arrow:disabled {
    border-top: 4px solid #7F7F7F;
}

/* Popup list -- the currently-selected/current item must never render
   with text the same color as its own background (see cccp.qss's comment
   on this same selector for the full empirical finding). selection-
   background-color/selection-color set the palette Highlight roles
   directly (verified correct via palette introspection); the ::item rules
   are redundant coverage for native styles this offscreen harness can't
   exercise. Selected text is BLACK on a YELLOW fill in every code path --
   never yellow on yellow, never white on white. */
QComboBox QAbstractItemView {
    background-color: #000000;
    color: #FFFFFF;
    border: 2px solid #FFFF00;
    outline: none;
    padding: 2px;
    selection-background-color: #FFFF00;
    selection-color: #000000;
}

QComboBox QAbstractItemView::item {
    padding: 4px 8px;
    min-height: 20px;
    background-color: #000000;
    color: #FFFFFF;
    border: none;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #FFFF00;
    color: #000000;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #FFFF00;
    color: #000000;
}

/* ------------------------------------------------------------ Checkbox */

QCheckBox {
    color: #FFFFFF;
    spacing: 6px;
}

QCheckBox:disabled {
    color: #7F7F7F;
}

QCheckBox::indicator {
    width: 13px;
    height: 13px;
    background-color: #000000;
    border: 2px solid #FFFFFF;
}

QCheckBox::indicator:hover {
    border: 2px solid #FFFF00;
}

QCheckBox::indicator:focus {
    outline: 2px solid #FFFF00;
    outline-offset: 1px;
}

QCheckBox::indicator:checked {
    background-color: #FFFF00;
    border: 2px solid #FFFF00;
    image: url(theme:checkmark.png);
}

QCheckBox::indicator:disabled {
    background-color: #000000;
    border: 2px solid #7F7F7F;
}

QCheckBox::indicator:checked:disabled {
    background-color: #7F7F7F;
    border: 2px solid #7F7F7F;
}

/* -------------------------------------------------------------- Slider */

QSlider::groove:horizontal {
    height: 4px;
    background-color: #FFFFFF;
    border: none;
}

QSlider::groove:horizontal:disabled {
    background-color: #7F7F7F;
}

QSlider::handle:horizontal {
    width: 14px;
    margin: -6px 0;
    background-color: #FFFF00;
    border: 2px solid #FFFF00;
}

QSlider::handle:horizontal:hover {
    background-color: #FFFFFF;
    border: 2px solid #FFFFFF;
}

QSlider::handle:horizontal:pressed {
    background-color: #FFFFFF;
    border: 2px solid #FFFF00;
}

QSlider::handle:horizontal:focus {
    outline: 2px solid #FFFF00;
    outline-offset: 1px;
}

QSlider::handle:horizontal:disabled {
    background-color: #7F7F7F;
    border: 2px solid #7F7F7F;
}

/* ---------------------------------------------------- Tables and trees */

QTableWidget, QTreeWidget {
    background-color: #000000;
    alternate-background-color: #1A1A1A;
    gridline-color: #7F7F7F;
    border: 2px solid #FFFFFF;
    color: #FFFFFF;
    selection-background-color: #FFFF00;
    selection-color: #000000;
    outline: none;
}

QTableWidget::item, QTreeWidget::item {
    padding: 2px;
}

QTableWidget::item:hover, QTreeWidget::item:hover {
    background-color: #1A1A00;
}

QTableWidget::item:selected, QTreeWidget::item:selected {
    background-color: #FFFF00;
    color: #000000;
}

QHeaderView::section {
    background-color: #000000;
    border: 2px solid #FFFFFF;
    padding: 3px 6px;
    font-weight: bold;
    color: #FFFF00;
}

QHeaderView::section:hover {
    color: #FFFF00;
    border-color: #FFFF00;
}

/* ------------------------------------------------------------- ListBox */

QListWidget {
    background-color: #000000;
    border: 2px solid #FFFFFF;
    color: #FFFFFF;
    outline: none;
}

QListWidget::item {
    padding: 4px 6px;
    border-left: 3px solid transparent;
}

QListWidget::item:hover {
    background-color: #1A1A00;
    border-left: 3px solid #FFFF00;
}

QListWidget::item:selected {
    background-color: #FFFF00;
    color: #000000;
    border-left: 3px solid #FFFFFF;
}

QListWidget::item:selected:!active {
    background-color: #7F7F00;
    color: #000000;
}

/* ------------------------------------------------------------------ Menu */

QMenu {
    background-color: #000000;
    border: 2px solid #FFFFFF;
    color: #FFFFFF;
    padding: 3px;
}

QMenu::item {
    background-color: transparent;
    padding: 5px 24px 5px 16px;
    border-left: 3px solid transparent;
}

QMenu::item:selected {
    background-color: #FFFF00;
    color: #000000;
    border-left: 3px solid #FFFFFF;
}

QMenu::item:disabled {
    color: #7F7F7F;
}

QMenu::separator {
    height: 2px;
    background-color: #FFFFFF;
    margin: 4px 8px;
}

QMenu::icon {
    padding-left: 6px;
}

/* --------------------------------------------------------- ProgressBar */

QProgressBar {
    border: 2px solid #FFFFFF;
    background-color: #000000;
    text-align: center;
    color: #FFFFFF;
    font-weight: bold;
}

QProgressBar::chunk {
    background-color: #FFFF00;
    margin: 1px;
}

/* ---------------------------------------------------------- Misc chrome */

QLabel {
    background: transparent;
    color: #FFFFFF;
}

QLabel:disabled {
    color: #7F7F7F;
}

QSplitter::handle {
    background-color: #000000;
}

QSplitter::handle:hover {
    background-color: #FFFF00;
}

QScrollBar:vertical {
    background: #000000;
    width: 16px;
    border: 2px solid #FFFFFF;
}

QScrollBar::handle:vertical {
    background-color: #FFFFFF;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background-color: #FFFF00;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
    background: none;
    border: none;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background: #000000;
    height: 16px;
    border: 2px solid #FFFFFF;
}

QScrollBar::handle:horizontal {
    background-color: #FFFFFF;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #FFFF00;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
    background: none;
    border: none;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

QSizeGrip {
    background-color: #000000;
    width: 16px;
    height: 16px;
}

QToolTip {
    background-color: #000000;
    color: #FFFFFF;
    border: 2px solid #FFFF00;
    border-radius: 0px;
    padding: 4px 6px;
}

/* ---------------------------------------------------------------------
   Propaganda side panel (src/torrent2000/ui/widgets/propaganda_panel.py)
   -- the extra strip of window width shown only under this theme.
   --------------------------------------------------------------------- */

QWidget#cccpPropagandaPanel {
    background-color: #000000;
    border-left: 3px solid #FFFFFF;
}

QLabel#propagandaHeader {
    color: #FFFF00;
    font-weight: bold;
    font-size: 10pt;
}

QLabel#propagandaMessage {
    color: #FFFFFF;
    font-size: 9pt;
}

QFrame#propagandaDivider {
    background-color: #FFFF00;
    border: none;
}
