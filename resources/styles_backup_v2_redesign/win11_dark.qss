/* =========================================================================
   Torrent 2000 -- "Windows 11" skin (Mica), DARK variant.

   No authentic Windows 11 dark-mode chrome screenshot could be sourced by
   search/curl in the time available (see CHARTER_win11.md in the scratch
   folder) -- only third-party apps' own dark themes turned up, which don't
   reflect the OS-native Mica dark surface. Palette below is cross-referenced
   from 2 independent sources instead of pixel-sampled:
     1. This codebase's theme_manager.py TITLE_BAR_STYLES["win11_mica"] +
        _DARK_TITLE_BAR_OVERRIDES, which already fixes the dark-mode Mica
        title bar at #202020 / white text -- authoritative, read not
        modified, and it's the same Mica surface the body chrome sits under.
     2. Microsoft's Fluent 2 design-token docs: colorNeutralBackground1 dark
        = #292929, colorNeutralBackground2 dark = #1F1F1F -- corroborates a
        dark neutral-surface ladder in the same #1F-#29 neighborhood as
        #202020.

   Token palette:
     --mica-bg    #202020  theme_manager.py's fixed win11_mica dark caption
     --card       #2B2B2B  one step above mica-bg, echoing Fluent's
                            colorNeutralBackground1 dark (#292929)
     --surface    #333333  inputs/lists, one step lighter again (standard
                            raised-input convention on dark backgrounds)
     --border     #3D3D3D  derived, lighter-than-surface hairline
     --accent     #3C96E8  light-mode measured accent (#0F70C4) brightened
                            per Fluent's standard dark-mode brand-ramp shift
     --text       #FFFFFF  theme_manager.py's fixed dark title-bar text
     --text-muted #C5C5C5  derived contrast step

   Shape, selector coverage and structure mirror win11.qss exactly -- only
   the tokens change for the dark surface.
   ========================================================================= */

* {
    font-family: "Segoe UI Variable", "Segoe UI", "MS Shell Dlg 2", sans-serif;
    font-size: 9pt;
}

QMainWindow, QWidget#centralWidget {
    background-color: #202020;
}

QWidget {
    background-color: #202020;
    color: #FFFFFF;
    /* Also declared here, not just on the specific popup rule below: Qt's
       QComboBox popup draws its "current item" indicator from the
       application-wide palette this universal rule establishes, not just
       from the more specific QComboBox QAbstractItemView rule -- verified
       empirically (leaving this undeclared made the current row silently
       fall back to a mismatched default color, reproducing the exact
       invisible-selected-item bug this file's popup section guards
       against). */
    selection-background-color: #3C96E8;
    selection-color: #0A1A2A;
}

/* ---------------------------------------------------------------------
   Tabs
   --------------------------------------------------------------------- */

QTabWidget::pane {
    border: 1px solid #3D3D3D;
    border-radius: 8px;
    background-color: #2B2B2B;
    top: -1px;
    padding: 6px;
}

QTabBar::tab {
    background-color: #262626;
    border: 1px solid #3D3D3D;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    padding: 8px 20px;
    margin-right: 3px;
    color: #C5C5C5;
}

QTabBar::tab:selected {
    background-color: #2B2B2B;
    border-color: #3D3D3D;
    border-bottom: 3px solid #3C96E8;
    color: #FFFFFF;
    margin-top: 0px;
    padding-bottom: 5px;
}

QTabBar::tab:!selected {
    margin-top: 3px;
}

QTabBar::tab:hover:!selected {
    background-color: #333333;
    color: #FFFFFF;
}

QTabBar::tab:focus {
    border-width: 2px;
    border-color: #3C96E8;
}

/* ---------------------------------------------------------------------
   Group boxes
   --------------------------------------------------------------------- */

QGroupBox {
    border: 1px solid #3D3D3D;
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 10px;
    background-color: #2B2B2B;
    font-weight: 600;
    color: #FFFFFF;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    color: #FFFFFF;
}

/* ---------------------------------------------------------------------
   Buttons
   --------------------------------------------------------------------- */

QPushButton {
    background-color: #2B2B2B;
    border: 1px solid #3D3D3D;
    border-radius: 8px;
    padding: 7px 20px;
    min-height: 20px;
    color: #FFFFFF;
}

QPushButton:hover:!pressed {
    background-color: #333333;
    border: 1px solid #4A5A6E;
}

QPushButton:pressed {
    background-color: #1C3B57;
    border: 1px solid #3C96E8;
}

QPushButton:default {
    background-color: #3C96E8;
    border: 1px solid #3C96E8;
    color: #0A1A2A;
}

QPushButton:default:hover:!pressed {
    background-color: #5FAAF0;
    border: 1px solid #5FAAF0;
}

QPushButton:default:pressed {
    background-color: #2B7AC8;
    border: 1px solid #2B7AC8;
}

QPushButton:focus {
    border-width: 2px;
    border-color: #3C96E8;
}

QPushButton:disabled {
    background-color: #202020;
    border: 1px solid #3D3D3D;
    color: #6B6B6B;
}

/* Destructive actions -- red at rest, deepens on hover/press; focus ring
   stays the theme's normal accent blue so focus is never confused with
   hover. */
QPushButton#dangerButton {
    background-color: #3A2321;
    border: 1px solid #6E3A34;
    border-radius: 8px;
    padding: 5px 16px;
    min-height: 18px;
    color: #F1948A;
}

QPushButton#dangerButton:hover:!pressed {
    background-color: #532B26;
    border: 1px solid #D9534A;
    color: #F8C7C1;
}

QPushButton#dangerButton:pressed {
    background-color: #C42B1C;
    border: 1px solid #F1948A;
    color: #FFFFFF;
}

QPushButton#dangerButton:focus {
    border-width: 2px;
    border-color: #3C96E8;
}

QPushButton#dangerButton:disabled {
    background-color: #202020;
    border: 1px solid #3D3D3D;
    color: #6B6B6B;
}

/* ---------------------------------------------------------------------
   Inputs
   --------------------------------------------------------------------- */

QLineEdit, QSpinBox, QAbstractSpinBox {
    background-color: #333333;
    border: 1px solid #3D3D3D;
    border-radius: 8px;
    padding: 5px 10px;
    color: #FFFFFF;
    selection-background-color: #3C96E8;
    selection-color: #0A1A2A;
}

QLineEdit:hover, QSpinBox:hover, QAbstractSpinBox:hover {
    border: 1px solid #5A7A9E;
}

QLineEdit:focus, QSpinBox:focus, QAbstractSpinBox:focus {
    border-width: 2px;
    border-color: #3C96E8;
    padding: 4px 9px;
}

QLineEdit:disabled, QSpinBox:disabled, QAbstractSpinBox:disabled {
    background-color: #202020;
    border: 1px solid #3D3D3D;
    color: #6B6B6B;
}

QComboBox {
    background-color: #333333;
    border: 1px solid #3D3D3D;
    border-radius: 8px;
    padding: 5px 10px;
    min-height: 20px;
    color: #FFFFFF;
}

QComboBox:hover {
    border: 1px solid #5A7A9E;
}

QComboBox:focus {
    border-width: 2px;
    border-color: #3C96E8;
    padding: 4px 9px;
}

QComboBox:disabled {
    background-color: #202020;
    border: 1px solid #3D3D3D;
    color: #6B6B6B;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: right;
    width: 26px;
    background-color: transparent;
    border: none;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
}

QComboBox::down-arrow {
    width: 8px;
    height: 8px;
    image: none;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-top: 4px solid #FFFFFF;
}

QComboBox::down-arrow:disabled {
    border-top: 4px solid #6B6B6B;
}

/* Open popup -- v1's Windows 7 theme had a bug where the currently-selected
   item became invisible (same text/bg color). Guarded explicitly here, and
   confirmed by actually rendering the popup open offscreen: QComboBox's
   popup paints rows via the view's palette (background-color/color for
   unselected, selection-background-color/selection-color for the current
   row), NOT via ::item/::item:selected pseudo-states -- those silently do
   not paint for a QComboBox popup in this Qt build, verified empirically
   (a saturated debug color placed on ::item:selected rendered zero
   pixels), so this theme relies solely on the mechanism that actually
   renders. */
QComboBox QAbstractItemView {
    background-color: #2B2B2B;
    border: 1px solid #3D3D3D;
    border-radius: 8px;
    padding: 4px;
    outline: none;
    color: #FFFFFF;
    selection-background-color: #3C96E8;
    selection-color: #0A1A2A;
}

/* ---------------------------------------------------------------------
   Checkboxes -- 16px box scales the 8px window radius down to 4px.
   --------------------------------------------------------------------- */

QCheckBox {
    spacing: 8px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    background-color: #333333;
    border: 1px solid #3D3D3D;
    border-radius: 4px;
}

QCheckBox::indicator:hover {
    border: 1px solid #3C96E8;
}

QCheckBox::indicator:checked {
    background-color: #3C96E8;
    border: 1px solid #3C96E8;
    image: url(theme:checkmark.png);
}

QCheckBox::indicator:checked:hover {
    background-color: #5FAAF0;
    border: 1px solid #5FAAF0;
}

QCheckBox::indicator:focus {
    border-width: 2px;
    border-color: #3C96E8;
}

QCheckBox::indicator:disabled {
    background-color: #202020;
    border: 1px solid #3D3D3D;
}

QCheckBox::indicator:checked:disabled {
    background-color: #4A4A4A;
    border: 1px solid #4A4A4A;
}

QCheckBox:disabled {
    color: #6B6B6B;
}

/* ---------------------------------------------------------------------
   Sliders -- thin flat groove, round accent handle (16px handle = 8px
   radius, a perfect circle).
   --------------------------------------------------------------------- */

QSlider::groove:horizontal {
    height: 4px;
    background-color: #4A4A4A;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    width: 16px;
    height: 16px;
    margin: -6px 0;
    background-color: #3C96E8;
    border: 1px solid #2B7AC8;
    border-radius: 8px;
}

QSlider::handle:horizontal:hover {
    background-color: #5FAAF0;
}

QSlider::handle:horizontal:focus {
    border-width: 2px;
    border-color: #3C96E8;
}

QSlider::handle:horizontal:disabled {
    background-color: #4A4A4A;
    border: 1px solid #3D3D3D;
}

/* ---------------------------------------------------------------------
   Tables / trees / lists
   --------------------------------------------------------------------- */

QTableWidget, QTreeWidget {
    background-color: #262626;
    alternate-background-color: #2B2E33;
    gridline-color: #3D3D3D;
    border: 1px solid #3D3D3D;
    border-radius: 8px;
    color: #FFFFFF;
    selection-background-color: #3C96E8;
    selection-color: #0A1A2A;
}

QTableWidget::item, QTreeWidget::item {
    padding: 3px;
}

QTableWidget::item:hover, QTreeWidget::item:hover {
    background-color: #333333;
}

QTableWidget::item:selected, QTreeWidget::item:selected {
    background-color: #3C96E8;
    color: #0A1A2A;
}

QHeaderView::section {
    background-color: #2B2B2B;
    border: none;
    border-right: 1px solid #3D3D3D;
    border-bottom: 1px solid #3D3D3D;
    padding: 6px 8px;
    font-weight: 600;
    color: #FFFFFF;
}

QListWidget {
    background-color: #262626;
    border: 1px solid #3D3D3D;
    border-radius: 8px;
    padding: 4px;
    outline: none;
    color: #FFFFFF;
    selection-background-color: #3C96E8;
    selection-color: #0A1A2A;
}

QListWidget::item {
    padding: 6px 10px;
    border-radius: 6px;
    color: #FFFFFF;
    margin: 1px 2px;
}

QListWidget::item:hover {
    background-color: #333333;
}

QListWidget::item:selected {
    background-color: #3C96E8;
    color: #0A1A2A;
}

/* ---------------------------------------------------------------------
   Context menus
   --------------------------------------------------------------------- */

QMenu {
    background-color: #2B2B2B;
    border: 1px solid #3D3D3D;
    border-radius: 8px;
    padding: 6px;
}

QMenu::item {
    background-color: transparent;
    padding: 7px 16px;
    border-radius: 6px;
    margin: 1px 4px;
    color: #FFFFFF;
}

QMenu::item:selected {
    background-color: #3C96E8;
    color: #0A1A2A;
}

QMenu::item:disabled {
    color: #6B6B6B;
    background-color: transparent;
}

QMenu::separator {
    height: 1px;
    background-color: #3D3D3D;
    margin: 6px 10px;
}

/* ---------------------------------------------------------------------
   Dialogs
   --------------------------------------------------------------------- */

QDialog {
    background-color: #202020;
    color: #FFFFFF;
}

QProgressBar {
    border: 1px solid #3D3D3D;
    border-radius: 8px;
    background-color: #2B2B2B;
    text-align: center;
    color: #FFFFFF;
    min-height: 16px;
}

QProgressBar::chunk {
    background-color: #3C96E8;
    border-radius: 7px;
    margin: 1px;
}

QLabel {
    background: transparent;
    color: #FFFFFF;
}

QSplitter::handle {
    background-color: #202020;
}

QScrollBar:vertical {
    background: #202020;
    width: 14px;
    border: none;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background-color: #4A4A4A;
    border-radius: 6px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background-color: #6E6E6E;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background: #202020;
    height: 14px;
    border: none;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background-color: #4A4A4A;
    border-radius: 6px;
    min-width: 28px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #6E6E6E;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* ---------------------------------------------------------------------
   Custom title bar sits directly above the tab widget in a frameless
   window -- drop the pane's top border to avoid a double line/gap.
   --------------------------------------------------------------------- */

QTabWidget#mainTabs::pane {
    border-top: none;
    top: 0px;
}

/* ---------------------------------------------------------------------
   Tooltips
   --------------------------------------------------------------------- */

QToolTip {
    background-color: #2B2B2B;
    color: #FFFFFF;
    border: 1px solid #3D3D3D;
    border-radius: 8px;
    padding: 5px 10px;
}

QSizeGrip {
    background-color: #202020;
    width: 16px;
    height: 16px;
}
