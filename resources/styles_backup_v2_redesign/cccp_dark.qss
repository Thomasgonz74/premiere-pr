/* =====================================================================
   Torrent 2000 -- "CCCP" skin, DARK variant
   Same measured Soviet-poster identity as cccp.qss -- see that file's
   header for the full palette-derivation method (real posters downloaded
   from Wikimedia Commons, pixel-clustered with PIL). Pushed toward a
   deeper, near-pure-black board. Flat fields only, thick square-cut ink
   borders, no gradients: a poster is silkscreened, not airbrushed.

   TOKENS (hex, named) -- deltas from cccp.qss called out explicitly
   ------------------------------------------------------------------
     bg               #0A0A0A   canvas, darkened from #161616
     surface          #141414   panel / card, darkened from #202120
     border           #EAE0CA   parchment ink-line -- UNCHANGED (measured
                                 poster cream). The poster's outline
                                 doesn't fade just because the room got
                                 darker.
     text             #F2E4C4   parchment cream -- UNCHANGED, still the
                                 ALREADY-FIXED title bar caption text color.
     text-muted       #B2AA9A   dulled parchment -- measured cream scaled
                                 to ~76% HSV value (up from the normal
                                 variant's ~68%, so it stays legible against
                                 the deeper #0A0A0A base)
     accent (red)     #EE5634   primary interactive red -- measured poster
                                 red (#D84E2F) lifted +10% HSV value; the
                                 same red needs more lift to read clearly
                                 once the board goes this dark
     accent-hover     #D4AF37   gold -- UNCHANGED, and deliberately so: see
                                 below
     danger           #A31515   destructive-action red -- UNCHANGED

   Why gold and danger-red stay pinned exactly: CCCP's title bar has NO
   dark-mode override (see theme_manager.py's _DARK_TITLE_BAR_OVERRIDES
   comment -- "CCCP has no dark-mode override... the caption stays red in
   dark"). The real caption chrome does not change between normal and
   dark. So the two colors this stylesheet borrows directly from that
   chrome -- the gold hover and the close/minmax button red -- don't
   change either. Only the board itself (background, panels) and the
   general-purpose accent that needs to stay readable against it get
   darker/brighter to compensate.

   Utility shades (not part of the named palette, purely structural):
     inset            #050505   recessed field background
     hover-surface    #201F1F
     alt-row          #121212
     disabled-border  #303030
     disabled-text    #5A5A5A

   The title bar is NOT drawn by this stylesheet -- see
   src/torrent2000/ui/widgets/app_title_bar.py and ui/theme/theme_manager.py.
   ===================================================================== */

* {
    font-family: "Arial", "Segoe UI", sans-serif;
    font-size: 9pt;
}

QMainWindow, QWidget#centralWidget, QDialog {
    background-color: #0A0A0A;
    color: #F2E4C4;
}

QWidget {
    background-color: #0A0A0A;
    color: #F2E4C4;
}

/* ---------------------------------------------------------------- Tabs */

QTabWidget::pane {
    border: 2px solid #EAE0CA;
    background-color: #0A0A0A;
    top: -1px;
}

QTabWidget#mainTabs::pane {
    border-top: none;
    top: 0px;
}

QTabBar::tab {
    background-color: #141414;
    border: 2px solid #EAE0CA;
    border-bottom: none;
    border-radius: 0px;
    padding: 5px 16px;
    margin-right: 1px;
    color: #F2E4C4;
    font-weight: bold;
}

QTabBar::tab:hover:!selected {
    background-color: #201F1F;
    color: #D4AF37;
    border-color: #D4AF37;
}

QTabBar::tab:selected {
    background-color: #0A0A0A;
    border-color: #EAE0CA;
    border-bottom: 3px solid #EE5634;
    margin-top: 0px;
    color: #EE5634;
}

QTabBar::tab:!selected {
    margin-top: 2px;
}

QTabBar::tab:disabled {
    color: #5A5A5A;
    border-color: #303030;
}

QTabBar::tab:focus {
    outline: 2px solid #D4AF37;
    outline-offset: -3px;
}

/* ------------------------------------------------------------ GroupBox */

QGroupBox {
    border: 2px solid #EAE0CA;
    border-top: 4px solid #EE5634;
    border-radius: 0px;
    margin-top: 10px;
    padding-top: 10px;
    background-color: #141414;
    font-weight: bold;
    color: #EE5634;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    top: -2px;
    padding: 0 6px;
    background-color: #141414;
    color: #EE5634;
}

/* ------------------------------------------------------------- Buttons */

QPushButton {
    background-color: #141414;
    border: 2px solid #EAE0CA;
    border-radius: 0px;
    padding: 4px 12px;
    min-height: 18px;
    color: #F2E4C4;
    font-weight: bold;
}

QPushButton:hover:!pressed {
    background-color: #201F1F;
    border: 2px solid #D4AF37;
    color: #D4AF37;
}

QPushButton:pressed {
    background-color: #050505;
    border: 2px solid #EE5634;
    color: #EE5634;
}

QPushButton:focus {
    outline: 2px solid #D4AF37;
    outline-offset: 2px;
}

QPushButton:default {
    border-width: 3px;
    border-color: #EE5634;
    color: #FFFFFF;
}

QPushButton:disabled {
    background-color: #141414;
    border: 2px solid #303030;
    color: #5A5A5A;
}

QPushButton#dangerButton {
    background-color: #A31515;
    border: 2px solid #EAE0CA;
    border-radius: 0px;
    padding: 2px 10px;
    min-height: 16px;
    color: #F2E4C4;
    font-weight: bold;
}

QPushButton#dangerButton:hover:!pressed {
    background-color: #D4AF37;
    border: 2px solid #F2E4C4;
    color: #0A0A0A;
}

QPushButton#dangerButton:pressed {
    background-color: #6E0E0E;
    border: 2px solid #EAE0CA;
    color: #F2E4C4;
}

QPushButton#dangerButton:focus {
    outline: 2px solid #F2E4C4;
    outline-offset: 2px;
}

QPushButton#dangerButton:disabled {
    background-color: #2E1010;
    border: 2px solid #303030;
    color: #5A5A5A;
}

/* ---------------------------------------------------------- Text input */

QLineEdit, QSpinBox, QAbstractSpinBox {
    background-color: #050505;
    border: 2px solid #303030;
    border-radius: 0px;
    padding: 2px 4px;
    color: #F2E4C4;
    selection-background-color: #EE5634;
    selection-color: #F2E4C4;
}

QLineEdit:hover, QSpinBox:hover, QAbstractSpinBox:hover {
    border: 2px solid #EE5634;
}

QLineEdit:focus, QSpinBox:focus, QAbstractSpinBox:focus {
    border: 2px solid #D4AF37;
    outline: 2px solid #D4AF37;
    outline-offset: 1px;
}

QLineEdit:disabled, QSpinBox:disabled, QAbstractSpinBox:disabled {
    background-color: #0A0A0A;
    border: 2px solid #303030;
    color: #5A5A5A;
}

QAbstractSpinBox::up-button, QAbstractSpinBox::down-button {
    subcontrol-origin: border;
    width: 16px;
    background-color: #141414;
    border-left: 2px solid #303030;
}

QAbstractSpinBox::up-button {
    subcontrol-position: top right;
    border-bottom: 1px solid #303030;
}

QAbstractSpinBox::up-button:hover, QAbstractSpinBox::down-button:hover {
    background-color: #201F1F;
}

QAbstractSpinBox::down-button {
    subcontrol-position: bottom right;
}

QAbstractSpinBox::up-arrow {
    width: 0;
    height: 0;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-bottom: 4px solid #F2E4C4;
}

QAbstractSpinBox::down-arrow {
    width: 0;
    height: 0;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-top: 4px solid #F2E4C4;
}

QAbstractSpinBox::up-arrow:disabled, QAbstractSpinBox::down-arrow:disabled {
    border-bottom-color: #5A5A5A;
    border-top-color: #5A5A5A;
}

/* -------------------------------------------------------------- Combo */

QComboBox {
    background-color: #050505;
    border: 2px solid #303030;
    border-radius: 0px;
    padding: 2px 4px;
    color: #F2E4C4;
}

QComboBox:hover {
    border: 2px solid #EE5634;
}

QComboBox:focus {
    border: 2px solid #D4AF37;
    outline: 2px solid #D4AF37;
    outline-offset: 1px;
}

QComboBox:disabled {
    background-color: #0A0A0A;
    border: 2px solid #303030;
    color: #5A5A5A;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: right;
    width: 20px;
    background-color: #141414;
    border-left: 2px solid #303030;
}

QComboBox::drop-down:hover {
    background-color: #201F1F;
}

QComboBox::down-arrow {
    width: 8px;
    height: 8px;
    image: none;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-top: 4px solid #F2E4C4;
}

QComboBox::down-arrow:disabled {
    border-top: 4px solid #5A5A5A;
}

/* Popup list -- the currently-selected/current item must never render
   with text the same color as its own background (see cccp.qss's comment
   on this same selector for the full empirical finding). selection-
   background-color/selection-color set the palette Highlight roles
   directly (verified correct via palette introspection); the ::item rules
   are redundant coverage for native styles this offscreen harness can't
   exercise. Either mechanism, text and fill are never the same color. */
QComboBox QAbstractItemView {
    background-color: #050505;
    color: #F2E4C4;
    border: 2px solid #EE5634;
    outline: none;
    padding: 2px;
    selection-background-color: #EE5634;
    selection-color: #F2E4C4;
}

QComboBox QAbstractItemView::item {
    padding: 4px 8px;
    min-height: 20px;
    background-color: #050505;
    color: #F2E4C4;
    border: none;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #EE5634;
    color: #F2E4C4;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #EE5634;
    color: #F2E4C4;
}

/* ------------------------------------------------------------ Checkbox */

QCheckBox {
    color: #F2E4C4;
    spacing: 6px;
}

QCheckBox:disabled {
    color: #5A5A5A;
}

QCheckBox::indicator {
    width: 13px;
    height: 13px;
    background-color: #050505;
    border: 2px solid #303030;
}

QCheckBox::indicator:hover {
    border: 2px solid #D4AF37;
}

QCheckBox::indicator:focus {
    outline: 2px solid #D4AF37;
    outline-offset: 1px;
}

QCheckBox::indicator:checked {
    background-color: #EE5634;
    border: 2px solid #EE5634;
    image: url(theme:checkmark.png);
}

QCheckBox::indicator:checked:hover {
    background-color: #D4AF37;
    border: 2px solid #D4AF37;
}

QCheckBox::indicator:disabled {
    background-color: #141414;
    border: 2px solid #303030;
}

QCheckBox::indicator:checked:disabled {
    background-color: #5A5A5A;
    border: 2px solid #303030;
}

/* -------------------------------------------------------------- Slider */

QSlider::groove:horizontal {
    height: 4px;
    background-color: #303030;
    border: 2px solid #050505;
}

QSlider::groove:horizontal:disabled {
    background-color: #252525;
}

QSlider::handle:horizontal {
    width: 14px;
    margin: -6px 0;
    background-color: #EE5634;
    border: 2px solid #EAE0CA;
}

QSlider::handle:horizontal:hover {
    background-color: #D4AF37;
    border: 2px solid #F2E4C4;
}

QSlider::handle:horizontal:pressed {
    background-color: #D4AF37;
    border: 2px solid #FFFFFF;
}

QSlider::handle:horizontal:focus {
    outline: 2px solid #D4AF37;
    outline-offset: 1px;
}

QSlider::handle:horizontal:disabled {
    background-color: #5A5A5A;
    border: 2px solid #303030;
}

/* ---------------------------------------------------- Tables and trees */

QTableWidget, QTreeWidget {
    background-color: #050505;
    alternate-background-color: #121212;
    gridline-color: #303030;
    border: 2px solid #303030;
    color: #F2E4C4;
    selection-background-color: #EE5634;
    selection-color: #F2E4C4;
    outline: none;
}

QTableWidget::item, QTreeWidget::item {
    padding: 2px;
}

QTableWidget::item:hover, QTreeWidget::item:hover {
    background-color: #251111;
}

QTableWidget::item:selected, QTreeWidget::item:selected {
    background-color: #EE5634;
    color: #F2E4C4;
}

QHeaderView::section {
    background-color: #141414;
    border: 2px solid #303030;
    padding: 3px 6px;
    font-weight: bold;
    color: #EE5634;
}

QHeaderView::section:hover {
    color: #D4AF37;
    border-color: #D4AF37;
}

/* ------------------------------------------------------------- ListBox */

QListWidget {
    background-color: #050505;
    border: 2px solid #303030;
    color: #F2E4C4;
    outline: none;
}

QListWidget::item {
    padding: 4px 6px;
    border-left: 3px solid transparent;
}

QListWidget::item:hover {
    background-color: #251111;
    border-left: 3px solid #D4AF37;
}

QListWidget::item:selected {
    background-color: #EE5634;
    color: #F2E4C4;
    border-left: 3px solid #D4AF37;
}

QListWidget::item:selected:!active {
    background-color: #6E0E0E;
}

/* ------------------------------------------------------------------ Menu */

QMenu {
    background-color: #141414;
    border: 2px solid #EAE0CA;
    color: #F2E4C4;
    padding: 3px;
}

QMenu::item {
    background-color: transparent;
    padding: 5px 24px 5px 16px;
    border-left: 3px solid transparent;
}

QMenu::item:selected {
    background-color: #EE5634;
    color: #F2E4C4;
    border-left: 3px solid #D4AF37;
}

QMenu::item:disabled {
    color: #5A5A5A;
}

QMenu::separator {
    height: 2px;
    background-color: #D4AF37;
    margin: 4px 8px;
}

QMenu::icon {
    padding-left: 6px;
}

/* --------------------------------------------------------- ProgressBar */

QProgressBar {
    border: 2px solid #303030;
    background-color: #050505;
    text-align: center;
    color: #F2E4C4;
    font-weight: bold;
}

QProgressBar::chunk {
    background-color: #EE5634;
    margin: 1px;
}

/* ---------------------------------------------------------- Misc chrome */

QLabel {
    background: transparent;
    color: #F2E4C4;
}

QLabel:disabled {
    color: #5A5A5A;
}

QSplitter::handle {
    background-color: #0A0A0A;
}

QSplitter::handle:hover {
    background-color: #D4AF37;
}

QScrollBar:vertical {
    background: #141414;
    width: 16px;
    border: 2px solid #303030;
}

QScrollBar::handle:vertical {
    background-color: #303030;
    border: 1px solid #050505;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background-color: #EE5634;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
    background: none;
    border: none;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background: #141414;
    height: 16px;
    border: 2px solid #303030;
}

QScrollBar::handle:horizontal {
    background-color: #303030;
    border: 1px solid #050505;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #EE5634;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
    background: none;
    border: none;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

QSizeGrip {
    background-color: #0A0A0A;
    width: 16px;
    height: 16px;
}

QToolTip {
    background-color: #141414;
    color: #F2E4C4;
    border: 2px solid #EE5634;
    border-radius: 0px;
    padding: 4px 6px;
}

/* ---------------------------------------------------------------------
   Propaganda side panel (src/torrent2000/ui/widgets/propaganda_panel.py)
   -- the extra strip of window width shown only under this theme.
   --------------------------------------------------------------------- */

QWidget#cccpPropagandaPanel {
    background-color: #050505;
    border-left: 3px solid #EE5634;
}

QLabel#propagandaHeader {
    color: #EE5634;
    font-weight: bold;
    font-size: 10pt;
}

QLabel#propagandaMessage {
    color: #F2E4C4;
    font-size: 9pt;
}

QFrame#propagandaDivider {
    background-color: #D4AF37;
    border: none;
}
