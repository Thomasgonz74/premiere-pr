/* Torrent 2000 -- "Windows 10" skin, DARK variant (matches the real
   Windows 10 "Dark" app theme).

   Token palette (dark) -- same Fluent identity as win10.qss, inverted to
   the dark surface stack rather than swapped for a different theme:
     bg              #1F1F1F   window / page background
     surface         #2B2B2B   secondary surface -- tab strip track, table
                                header row, menu/dialog chrome
     border          #4A4A4A   control border, resting state; hairline
                                dividers use the same tone, inputs use a
                                slightly lighter #5A5A5A for legibility
     text            #FFFFFF   primary text
     text-muted      #C5C5C5   secondary text / unselected tab label
     accent          #0078D4   Windows blue -- unchanged from light, this
                                is the one color that must stay identical
                                across appearance modes to read as "Win10"
     accent-hover    #2E8FE0   accent hover / "reveal" edge -- on a dark
                                surface Fluent's reveal effect brightens
                                instead of darkening, so this goes lighter
                                than the base accent (the light variant's
                                hover goes darker) -- same mechanic, mirrored
     danger          #FF5F52   destructive red, brightened for dark-surface
                                contrast (the light theme's #C42B1C reads as
                                near-black at low luminance)

   Supporting tints derived from the palette above:
     #17324A / #0D4570   accent-tinted hover / pressed wash (dark equivalent
                          of the light theme's #E5F1FB / #CCE4F7 reveal)
     #7A7A7A              disabled text

   Fully flat design -- zero gradients, zero 3D bevels, sharp square
   corners, matching win10.qss. The title bar is NOT drawn by this
   stylesheet -- see src/torrent2000/ui/widgets/app_title_bar.py.
*/

* {
    font-family: "Segoe UI", "MS Shell Dlg 2", sans-serif;
    font-size: 9pt;
}

QMainWindow, QWidget#centralWidget {
    background-color: #1F1F1F;
}

QWidget {
    background-color: #1F1F1F;
    color: #FFFFFF;
}

QDialog {
    background-color: #1F1F1F;
    color: #FFFFFF;
}

QTabWidget::pane {
    border: 1px solid #3A3A3A;
    background-color: #1F1F1F;
    top: -1px;
}

QTabBar::tab {
    background-color: #2B2B2B;
    border: 1px solid #3A3A3A;
    border-bottom: none;
    padding: 7px 18px;
    margin-right: 1px;
    color: #C5C5C5;
}

QTabBar::tab:selected {
    background-color: #1F1F1F;
    border-color: #3A3A3A;
    border-bottom: 2px solid #0078D4;
    margin-top: 0px;
    color: #FFFFFF;
}

QTabBar::tab:!selected {
    margin-top: 2px;
}

QTabBar::tab:hover:!selected {
    background-color: #17324A;
    border-bottom: 2px solid #2E5A80;
    color: #FFFFFF;
}

QTabBar::tab:focus {
    outline: 2px solid #0078D4;
    outline-offset: -3px;
}

QGroupBox {
    border: 1px solid #3A3A3A;
    border-radius: 0px;
    margin-top: 10px;
    padding-top: 6px;
    background-color: #1F1F1F;
    font-weight: normal;
    color: #FFFFFF;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #FFFFFF;
}

QPushButton {
    background-color: #2B2B2B;
    border: 1px solid #4A4A4A;
    border-radius: 0px;
    padding: 4px 12px;
    min-height: 18px;
    color: #FFFFFF;
}

QPushButton:hover:!pressed {
    background-color: #17324A;
    border: 1px solid #0078D4;
}

QPushButton:pressed {
    background-color: #0D4570;
    border: 1px solid #2E8FE0;
}

QPushButton:focus {
    outline: 2px solid #0078D4;
    outline-offset: 1px;
}

QPushButton:default {
    background-color: #0078D4;
    border: 1px solid #2E8FE0;
    color: #FFFFFF;
}

QPushButton:default:hover:!pressed {
    background-color: #2E8FE0;
    border: 1px solid #62AAEB;
    color: #FFFFFF;
}

QPushButton:default:pressed {
    background-color: #005A9E;
    border: 1px solid #0078D4;
    color: #FFFFFF;
}

QPushButton:disabled {
    background-color: #232323;
    border: 1px solid #3A3A3A;
    color: #7A7A7A;
}

QPushButton#dangerButton {
    background-color: #4A2622;
    border: 1px solid #FF5F52;
    border-radius: 0px;
    padding: 2px 10px;
    min-height: 16px;
    color: #FFFFFF;
}

QPushButton#dangerButton:hover:!pressed {
    background-color: #5A302A;
    border: 1px solid #0078D4;
}

QPushButton#dangerButton:pressed {
    background-color: #3A1B18;
    border: 1px solid #2A1310;
}

QPushButton#dangerButton:focus {
    outline: 2px solid #0078D4;
    outline-offset: 1px;
}

QLineEdit, QSpinBox, QAbstractSpinBox {
    background-color: #2B2B2B;
    border: 1px solid #5A5A5A;
    border-radius: 0px;
    padding: 2px 4px;
    color: #FFFFFF;
    selection-background-color: #0078D4;
    selection-color: #FFFFFF;
}

QLineEdit:hover, QSpinBox:hover, QAbstractSpinBox:hover {
    border: 1px solid #0078D4;
}

QLineEdit:focus, QSpinBox:focus, QAbstractSpinBox:focus {
    border: 1px solid #0078D4;
    outline: 2px solid #0078D4;
    outline-offset: 1px;
}

QLineEdit:disabled, QSpinBox:disabled, QAbstractSpinBox:disabled {
    background-color: #232323;
    border: 1px solid #3A3A3A;
    color: #7A7A7A;
}

QAbstractSpinBox::up-button, QAbstractSpinBox::down-button {
    subcontrol-origin: border;
    width: 16px;
    background-color: #2B2B2B;
    border-left: 1px solid #5A5A5A;
}

QAbstractSpinBox::up-button {
    subcontrol-position: top right;
    border-bottom: 1px solid #3A3A3A;
}

QAbstractSpinBox::down-button {
    subcontrol-position: bottom right;
}

QAbstractSpinBox::up-button:hover, QAbstractSpinBox::down-button:hover {
    background-color: #17324A;
}

QAbstractSpinBox::up-button:pressed, QAbstractSpinBox::down-button:pressed {
    background-color: #0D4570;
}

QAbstractSpinBox::up-arrow {
    width: 0px;
    height: 0px;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-bottom: 4px solid #FFFFFF;
}

QAbstractSpinBox::down-arrow {
    width: 0px;
    height: 0px;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-top: 4px solid #FFFFFF;
}

QComboBox {
    background-color: #2B2B2B;
    border: 1px solid #5A5A5A;
    border-radius: 0px;
    padding: 2px 4px;
    color: #FFFFFF;
}

QComboBox:hover {
    border: 1px solid #0078D4;
}

QComboBox:focus {
    border: 1px solid #0078D4;
    outline: 2px solid #0078D4;
    outline-offset: 1px;
}

QComboBox:disabled {
    background-color: #232323;
    border: 1px solid #3A3A3A;
    color: #7A7A7A;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: right;
    width: 22px;
    background-color: #2B2B2B;
    border-left: 1px solid #5A5A5A;
}

QComboBox::drop-down:hover {
    background-color: #17324A;
}

QComboBox::down-arrow {
    width: 8px;
    height: 8px;
    image: none;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-top: 4px solid #FFFFFF;
}

QComboBox QAbstractItemView {
    background-color: #2B2B2B;
    color: #FFFFFF;
    border: 1px solid #5A5A5A;
    outline: none;
    padding: 2px;
    selection-background-color: #0078D4;
    selection-color: #FFFFFF;
}

QComboBox QAbstractItemView::item {
    padding: 4px 8px;
    min-height: 20px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #17324A;
    color: #FFFFFF;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #0078D4;
    color: #FFFFFF;
}

QCheckBox::indicator {
    width: 13px;
    height: 13px;
    background-color: #2B2B2B;
    border: 1px solid #5A5A5A;
    border-radius: 0px;
}

QCheckBox::indicator:hover {
    border: 1px solid #0078D4;
}

QCheckBox::indicator:focus {
    outline: 2px solid #0078D4;
    outline-offset: 1px;
}

QCheckBox::indicator:disabled {
    background-color: #232323;
    border: 1px solid #3A3A3A;
}

QCheckBox::indicator:checked {
    background-color: #0078D4;
    border: 1px solid #0078D4;
    image: url(theme:checkmark.png);
}

QCheckBox::indicator:checked:hover {
    background-color: #2E8FE0;
    border: 1px solid #2E8FE0;
}

QCheckBox::indicator:checked:disabled {
    background-color: #3A3A3A;
    border: 1px solid #3A3A3A;
}

QSlider::groove:horizontal {
    height: 3px;
    background-color: #4A4A4A;
}

QSlider::handle:horizontal {
    width: 12px;
    height: 12px;
    margin: -5px 0;
    background-color: #0078D4;
    border: 1px solid #2E8FE0;
    border-radius: 6px;
}

QSlider::handle:horizontal:hover {
    background-color: #2E8FE0;
}

QSlider::handle:horizontal:focus {
    outline: 2px solid #0078D4;
    outline-offset: 2px;
}

QSlider::handle:horizontal:disabled {
    background-color: #232323;
    border: 1px solid #3A3A3A;
}

QTableWidget, QTreeWidget {
    background-color: #2B2B2B;
    alternate-background-color: #252525;
    gridline-color: #3A3A3A;
    border: 1px solid #3A3A3A;
    color: #FFFFFF;
    selection-background-color: #0078D4;
    selection-color: #FFFFFF;
}

QHeaderView::section {
    background-color: #2B2B2B;
    border: 1px solid #3A3A3A;
    padding: 3px 6px;
    font-weight: normal;
    color: #FFFFFF;
}

QListWidget {
    background-color: #2B2B2B;
    border: 1px solid #3A3A3A;
    outline: none;
    color: #FFFFFF;
    padding: 2px;
}

QListWidget::item {
    padding: 4px 8px;
}

QListWidget::item:hover {
    background-color: #17324A;
}

QListWidget::item:selected {
    background-color: #0078D4;
    color: #FFFFFF;
}

QListWidget::item:focus {
    outline: 2px solid #0078D4;
    outline-offset: -2px;
}

/* ---------------------------------------------------------------------
   Context menus -- see win10.qss for rationale. Sharp corners, solid
   accent selection, thin separator lines.
   --------------------------------------------------------------------- */

QMenu {
    background-color: #2B2B2B;
    border: 1px solid #4A4A4A;
    padding: 2px;
    color: #FFFFFF;
}

QMenu::item {
    background-color: transparent;
    padding: 6px 24px 6px 14px;
    margin: 1px 2px;
    color: #FFFFFF;
}

QMenu::item:selected {
    background-color: #0078D4;
    color: #FFFFFF;
}

QMenu::item:disabled {
    color: #7A7A7A;
}

QMenu::separator {
    height: 1px;
    background-color: #3A3A3A;
    margin: 4px 8px;
}

QMenu::indicator {
    width: 13px;
    height: 13px;
    left: 4px;
}

QProgressBar {
    border: 1px solid #3A3A3A;
    background-color: #2B2B2B;
    text-align: center;
    color: #FFFFFF;
}

QProgressBar::chunk {
    background-color: #0078D4;
    margin: 0px;
}

QLabel {
    background: transparent;
    color: #FFFFFF;
}

QSplitter::handle {
    background-color: #1F1F1F;
}

QScrollBar:vertical {
    background: #1F1F1F;
    width: 12px;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #4A4A4A;
    border-radius: 0px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background-color: #6A6A6A;
}

QScrollBar:horizontal {
    background: #1F1F1F;
    height: 12px;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #4A4A4A;
    border-radius: 0px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #6A6A6A;
}

QToolTip {
    background-color: #2B2B2B;
    color: #FFFFFF;
    border: 1px solid #4A4A4A;
    padding: 4px 8px;
}

QTabWidget#mainTabs::pane {
    border-top: none;
    top: 0px;
}

QSizeGrip {
    background-color: #1F1F1F;
    width: 16px;
    height: 16px;
}
