/* Torrent 2000 -- Windows XP "Luna Blue" skin, HIGH-CONTRAST DARK variant.

   Matches the real Windows "High Contrast Black" accessibility theme's
   color contract (pure black background, pure white text/borders, yellow
   focus/selection accent, NO gradients or subtle bevels -- flat fills
   only) while keeping this theme's characteristic rounded-oval button/tab
   shape so it is still recognizably "the Luna one" among the other six
   high-contrast variants. The window frame stays square, same as light
   and dark (see window_corner_radius=0 for "luna_xp" in
   ui/theme/theme_manager.py); the controls keep their own rounding.

   Design tokens (documented here, referenced by value throughout the file
   since Qt QSS has no variables):

     bg            #000000   window / pane background -- pure black
     surface       #000000   raised panel surface (menus/dialogs) -- same
                              pure black as bg; true HC draws no separate
                              panel tone, distinction comes from the white
                              border alone, not a lighter fill
     border        #FFFFFF   pure white structural border, used at rest
     text          #FFFFFF   primary window text -- pure white
     muted         #BFBFBF   secondary / disabled text -- the one tolerated
                              off-white/off-black gray, for "present but
                              inactive" without breaking the black/white/
                              yellow contract
     accent        #FFFF00   universal high-contrast focus/accent yellow --
                              the same convention already used by the
                              custom title bar's dark_hc button hover/focus
                              (see _DARK_TITLE_BAR_OVERRIDES in
                              theme_manager.py), applied here to every
                              focus ring, hover state and selection
     accent-text   #000000   text/glyph color used on top of an accent-
                              yellow fill (selected menu item, checked box,
                              pressed button) -- yellow-on-black elsewhere,
                              flipped to black-on-yellow here for contrast
     danger        #FF3B30   destructive-action red -- kept vivid rather
                              than muted, since HC prioritizes maximum
                              legibility over the light/dark variants'
                              softer "don't compete with the title bar"
                              restraint

   QToolTip switches to the strict black/white HC pair here (unlike the
   light/dark variants' nostalgic pale-yellow tooltip) because HC's
   contract is unconditional: every surface, including a tooltip, must be
   pure black with a pure white border, no exceptions.

   The title bar itself (which turns solid black with a yellow hover/focus
   accent in dark_hc -- see title_bar_style_for() in theme_manager.py) is
   NOT drawn by this stylesheet -- see
   src/torrent2000/ui/widgets/app_title_bar.py
*/

* {
    font-family: "Tahoma", "MS Shell Dlg 2", "Segoe UI", sans-serif;
    font-size: 8pt;
}

QMainWindow, QWidget#centralWidget {
    background-color: #000000;
}

QWidget {
    background-color: #000000;
    color: #FFFFFF;
}

/* ---------------------------------------------------------------------
   Tabs
   --------------------------------------------------------------------- */

QTabWidget::pane {
    border: 2px solid #FFFFFF;
    border-radius: 6px;
    background-color: #000000;
    top: -1px;
}

QTabBar::tab {
    background-color: #000000;
    border: 2px solid #FFFFFF;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 5px 16px;
    margin-right: 2px;
    color: #FFFFFF;
}

QTabBar::tab:selected {
    background-color: #000000;
    border-color: #FFFF00;
    border-bottom: 2px solid #000000;
    margin-top: 0px;
    color: #FFFF00;
    font-weight: bold;
}

QTabBar::tab:!selected {
    margin-top: 3px;
}

QTabBar::tab:hover:!selected {
    background-color: #FFFFFF;
    color: #000000;
}

QTabBar::tab:focus {
    border-width: 3px;
    border-color: #FFFF00;
    padding: 4px 15px;
}

/* ---------------------------------------------------------------------
   Group boxes
   --------------------------------------------------------------------- */

QGroupBox {
    border: 2px solid #FFFFFF;
    border-radius: 6px;
    margin-top: 12px;
    padding-top: 8px;
    background-color: #000000;
    font-weight: bold;
    color: #FFFFFF;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 5px;
    color: #FFFF00;
}

/* ---------------------------------------------------------------------
   Buttons -- flat fills only, no gradients, per the HC contract; the
   rounded-oval shape is the one thing carried over from light/dark so
   this still reads as "Luna" and not a generic HC skin.
   --------------------------------------------------------------------- */

QPushButton {
    background-color: #000000;
    border: 2px solid #FFFFFF;
    border-radius: 9px;
    padding: 5px 16px;
    min-height: 20px;
    color: #FFFFFF;
}

QPushButton:hover:!pressed {
    border: 2px solid #FFFF00;
    color: #FFFF00;
}

QPushButton:focus {
    border: 3px solid #FFFF00;
    padding: 4px 15px;
    color: #FFFF00;
}

QPushButton:pressed {
    background-color: #FFFF00;
    border: 2px solid #FFFF00;
    color: #000000;
    padding: 6px 15px 4px 17px;
}

QPushButton:default {
    border-width: 3px;
    padding: 4px 15px;
}

QPushButton:default:pressed {
    padding: 5px 14px 3px 16px;
}

QPushButton:disabled {
    background-color: #000000;
    border: 2px solid #7F7F7F;
    color: #7F7F7F;
}

QPushButton#dangerButton {
    background-color: #000000;
    border: 2px solid #FF3B30;
    border-radius: 9px;
    padding: 3px 14px;
    min-height: 18px;
    color: #FF3B30;
}

QPushButton#dangerButton:hover:!pressed {
    border: 2px solid #FFFF00;
    color: #FFFF00;
}

QPushButton#dangerButton:focus {
    border: 3px solid #FFFF00;
    padding: 2px 13px;
    color: #FFFF00;
}

QPushButton#dangerButton:pressed {
    background-color: #FF3B30;
    border: 2px solid #FF3B30;
    color: #000000;
    padding: 4px 13px 2px 15px;
}

/* ---------------------------------------------------------------------
   Inputs
   --------------------------------------------------------------------- */

QLineEdit, QSpinBox, QAbstractSpinBox {
    background-color: #000000;
    border: 2px solid #FFFFFF;
    border-radius: 5px;
    padding: 4px 8px;
    color: #FFFFFF;
    selection-background-color: #FFFF00;
    selection-color: #000000;
}

QLineEdit:hover, QSpinBox:hover, QAbstractSpinBox:hover {
    border: 2px solid #FFFF00;
}

QLineEdit:focus, QSpinBox:focus, QAbstractSpinBox:focus {
    border: 3px solid #FFFF00;
    padding: 3px 7px;
}

QLineEdit:disabled, QSpinBox:disabled, QAbstractSpinBox:disabled {
    background-color: #000000;
    border: 2px solid #7F7F7F;
    color: #7F7F7F;
}

QAbstractSpinBox::up-button, QAbstractSpinBox::down-button {
    subcontrol-origin: border;
    width: 18px;
    background-color: #000000;
    border-left: 2px solid #FFFFFF;
}

QAbstractSpinBox::up-button {
    subcontrol-position: top right;
    border-top-right-radius: 5px;
}

QAbstractSpinBox::down-button {
    subcontrol-position: bottom right;
    border-bottom-right-radius: 5px;
}

QAbstractSpinBox::up-button:hover, QAbstractSpinBox::down-button:hover {
    background-color: #FFFF00;
}

QAbstractSpinBox::up-arrow {
    width: 0;
    height: 0;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-bottom: 4px solid #FFFFFF;
}

QAbstractSpinBox::down-arrow {
    width: 0;
    height: 0;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-top: 4px solid #FFFFFF;
}

QComboBox {
    background-color: #000000;
    border: 2px solid #FFFFFF;
    border-radius: 5px;
    padding: 4px 8px;
    min-height: 20px;
    color: #FFFFFF;
}

QComboBox:hover {
    border: 2px solid #FFFF00;
}

QComboBox:focus {
    border: 3px solid #FFFF00;
    padding: 3px 7px;
}

QComboBox:disabled {
    background-color: #000000;
    border: 2px solid #7F7F7F;
    color: #7F7F7F;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: right;
    width: 20px;
    border-left: 2px solid #FFFFFF;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    background-color: #000000;
}

QComboBox::drop-down:hover {
    background-color: #FFFF00;
}

QComboBox::down-arrow {
    width: 0;
    height: 0;
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #FFFFFF;
}

QComboBox::down-arrow:disabled {
    border-top-color: #7F7F7F;
}

QComboBox QAbstractItemView {
    background-color: #000000;
    color: #FFFFFF;
    border: 2px solid #FFFF00;
    border-radius: 4px;
    outline: none;
    padding: 2px;
    selection-background-color: #FFFF00;
    selection-color: #000000;
}

/* ---------------------------------------------------------------------
   Checkboxes
   --------------------------------------------------------------------- */

QCheckBox {
    spacing: 6px;
    color: #FFFFFF;
}

QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border-radius: 3px;
    background-color: #000000;
    border: 2px solid #FFFFFF;
}

QCheckBox::indicator:hover {
    border: 2px solid #FFFF00;
}

QCheckBox::indicator:focus {
    border: 3px solid #FFFF00;
}

QCheckBox::indicator:checked {
    background-color: #FFFF00;
    border: 2px solid #FFFF00;
    image: url(theme:checkmark.png);
}

QCheckBox::indicator:disabled {
    background-color: #000000;
    border: 2px solid #7F7F7F;
}

QCheckBox:disabled {
    color: #7F7F7F;
}

/* ---------------------------------------------------------------------
   Sliders
   --------------------------------------------------------------------- */

QSlider::groove:horizontal {
    height: 4px;
    border-radius: 2px;
    background-color: #FFFFFF;
    border: none;
}

QSlider::handle:horizontal {
    width: 16px;
    height: 16px;
    margin: -7px 0;
    border-radius: 8px;
    background-color: #FFFF00;
    border: 2px solid #FFFF00;
}

QSlider::handle:horizontal:hover {
    background-color: #FFFFFF;
    border: 2px solid #FFFF00;
}

QSlider::handle:horizontal:focus {
    background-color: #FFFF00;
    border: 3px solid #FFFFFF;
    margin: -8px -1px;
}

QSlider::handle:horizontal:disabled {
    background-color: #7F7F7F;
    border: 2px solid #7F7F7F;
}

QSlider::sub-page:horizontal {
    background-color: #FFFF00;
    border-radius: 2px;
}

/* ---------------------------------------------------------------------
   Tables / trees
   --------------------------------------------------------------------- */

QTableWidget, QTreeWidget {
    background-color: #000000;
    alternate-background-color: #1A1A1A;
    gridline-color: #7F7F7F;
    border: 2px solid #FFFFFF;
    outline: none;
    color: #FFFFFF;
    selection-background-color: #FFFF00;
    selection-color: #000000;
}

QTableWidget::item:hover, QTreeWidget::item:hover {
    background-color: #FFFFFF;
    color: #000000;
}

QHeaderView::section {
    background-color: #000000;
    border: 2px solid #FFFFFF;
    padding: 4px 6px;
    font-weight: bold;
    color: #FFFFFF;
}

QHeaderView::section:hover {
    background-color: #FFFF00;
    color: #000000;
}

/* ---------------------------------------------------------------------
   List widget -- NEW
   --------------------------------------------------------------------- */

QListWidget {
    background-color: #000000;
    border: 2px solid #FFFFFF;
    border-radius: 4px;
    outline: none;
    padding: 2px;
    color: #FFFFFF;
    selection-background-color: #FFFF00;
    selection-color: #000000;
}

QListWidget::item {
    padding: 3px 6px;
    border-radius: 3px;
    color: #FFFFFF;
}

QListWidget::item:hover {
    background-color: #FFFFFF;
    color: #000000;
}

QListWidget::item:selected {
    background-color: #FFFF00;
    color: #000000;
}

/* ---------------------------------------------------------------------
   Menus -- NEW
   --------------------------------------------------------------------- */

QMenu {
    background-color: #000000;
    border: 2px solid #FFFFFF;
    border-radius: 6px;
    padding: 3px;
}

QMenu::item {
    background-color: transparent;
    padding: 5px 26px 5px 14px;
    margin: 1px 3px;
    border-radius: 4px;
    color: #FFFFFF;
}

QMenu::item:selected {
    background-color: #FFFF00;
    color: #000000;
}

QMenu::item:disabled {
    color: #7F7F7F;
}

QMenu::separator {
    height: 2px;
    background-color: #FFFFFF;
    margin: 4px 8px;
}

/* ---------------------------------------------------------------------
   Dialogs -- NEW
   --------------------------------------------------------------------- */

QDialog {
    background-color: #000000;
    color: #FFFFFF;
}

QProgressBar {
    border: 2px solid #FFFFFF;
    border-radius: 4px;
    background-color: #000000;
    text-align: center;
    color: #FFFFFF;
    min-height: 16px;
}

QProgressBar::chunk {
    background-color: #FFFF00;
    border-radius: 2px;
    margin: 1px;
}

QLabel {
    background: transparent;
    color: #FFFFFF;
}

QLabel:disabled {
    color: #7F7F7F;
}

QToolTip {
    background-color: #000000;
    border: 2px solid #FFFFFF;
    padding: 3px 6px;
    color: #FFFFFF;
}

QSplitter::handle {
    background-color: #000000;
}

QSplitter::handle:hover {
    background-color: #FFFF00;
}

QScrollBar:vertical {
    background: #000000;
    width: 17px;
    border-left: 2px solid #FFFFFF;
}

QScrollBar::handle:vertical {
    background-color: #FFFFFF;
    border-radius: 4px;
    min-height: 24px;
    margin: 2px 3px;
}

QScrollBar::handle:vertical:hover {
    background-color: #FFFF00;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
    border: none;
    background: none;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background: #000000;
    height: 17px;
    border-top: 2px solid #FFFFFF;
}

QScrollBar::handle:horizontal {
    background-color: #FFFFFF;
    border-radius: 4px;
    min-width: 24px;
    margin: 3px 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #FFFF00;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
    border: none;
    background: none;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

/* ---------------------------------------------------------------------
   Custom title bar -- see luna.qss for rationale, identical here.
   --------------------------------------------------------------------- */

QTabWidget#mainTabs::pane {
    border-top: none;
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
    top: 0px;
}

QSizeGrip {
    background-color: #000000;
    width: 16px;
    height: 16px;
}
