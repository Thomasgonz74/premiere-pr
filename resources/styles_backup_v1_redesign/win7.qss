/* Torrent 2000 -- "Windows 7 (Aero)" skin. FULL REDESIGN PASS.

   Design system: authentic Aero "glass" language -- glossy multi-stop
   button gradients (bright specular highlight riding the top ~45%, a
   crisp seam, then a slightly deeper body underneath, as if light is
   gliding across a curved sheet of glass), soft blue focus/hover glow,
   6px rounding everywhere (matches the frameless window's own 6px
   corner radius -- see TitleBarStyle["win7_aero"].window_corner_radius
   in ui/theme/theme_manager.py). QSS has no real Gaussian blur, so the
   "frosted" feel is faked with tight multi-stop gradients and pale,
   low-contrast borders standing in for translucency.

   Token palette (name -> hex -> role):
     --win7-bg           #F0F0F0   window / dialog page background
     --win7-surface      #FFFFFF   cards, inputs, menus, list/table rows
     --win7-border        #ACACAC  standard control outline
     --win7-border-soft   #D6D6D6  quiet separators, disabled outline
     --win7-text          #000000  primary text
     --win7-text-muted    #6E6E6E  secondary text, disabled text #A0A0A0
     --win7-accent        #3D95F2  Aero blue -- hover glow, selection,
                                    focus ring (anchored on the title
                                    bar's own glass gradient, which runs
                                    #DBEAFB -> #7EB0E8)
     --win7-accent-deep   #1C5FA8  pressed glass / focus-ring core
     --win7-danger        #B23A2E  destructive actions (soft glass red)

   The title bar (glassy blue-white gradient) is NOT drawn by this
   stylesheet -- see src/torrent2000/ui/widgets/app_title_bar.py.
*/

* {
    font-family: "Segoe UI", "MS Shell Dlg 2", sans-serif;
    font-size: 9pt;
}

QMainWindow, QWidget#centralWidget {
    background-color: #F0F0F0;
}

QWidget {
    background-color: #F0F0F0;
    color: #000000;
}

QDialog {
    background-color: #F0F0F0;
    color: #000000;
}

/* ---------------------------------------------------------------------
   Tabs -- rounded top corners with a soft glossy gradient, matching
   Aero's glass look. Selected tab reads as "lifted", fused to the pane.
   --------------------------------------------------------------------- */

QTabWidget::pane {
    border: 1px solid #ACACAC;
    background-color: #F0F0F0;
    top: -1px;
}

QTabBar::tab {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #FDFEFF, stop:0.45 #EDF5FD, stop:0.5 #DCEBFB, stop:1 #CBE0F8);
    border: 1px solid #A0A0A0;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 5px 16px;
    margin-right: 2px;
    color: #000000;
}

QTabBar::tab:selected {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #FFFFFF, stop:0.6 #FBFBFB, stop:1 #F0F0F0);
    border-color: #ACACAC;
    border-bottom: 1px solid #F0F0F0;
    margin-top: 0px;
}

QTabBar::tab:!selected {
    margin-top: 2px;
}

QTabBar::tab:hover:!selected {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #FFFFFF, stop:0.45 #E7F3FE, stop:0.5 #CDE7FD, stop:1 #ADD6FB);
    border-color: #3D95F2;
}

QTabBar::tab:focus {
    outline: 2px solid #3D95F2;
    outline-offset: -3px;
}

/* ---------------------------------------------------------------------
   Group boxes -- thin gray border, plain (not bold) title, matching
   Win7's quieter dialog typography.
   --------------------------------------------------------------------- */

QGroupBox {
    border: 1px solid #B4B4B4;
    border-radius: 6px;
    margin-top: 10px;
    padding-top: 6px;
    background-color: #F0F0F0;
    font-weight: normal;
    color: #000000;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #000000;
}

/* ---------------------------------------------------------------------
   Buttons -- glossy Aero glass: bright highlight riding the top of the
   button, a visible seam at the midline, deeper body below. Hover shifts
   the whole glass to Aero blue; pressed inverts the highlight so light
   looks like it is escaping at the bottom edge (a "pushed-in" glass cue).
   --------------------------------------------------------------------- */

QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #FFFFFF, stop:0.45 #FBFBFB, stop:0.5 #EFEFEF, stop:1 #E1E1E1);
    border: 1px solid #ADADAD;
    border-radius: 5px;
    padding: 4px 12px;
    min-height: 18px;
    color: #000000;
}

QPushButton:hover:!pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #F3FAFF, stop:0.45 #DFF0FE, stop:0.5 #C3E2FD, stop:1 #A9D3FB);
    border: 1px solid #3D95F2;
}

QPushButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #A9D3FB, stop:0.45 #8FC3F7, stop:0.55 #9FCBF5, stop:1 #C7E2FC);
    border: 1px solid #1C5FA8;
    padding: 5px 11px 3px 13px;
}

QPushButton:default {
    border-width: 2px;
    border-color: #3D95F2;
}

QPushButton:disabled {
    background: #F0F0F0;
    border: 1px solid #D6D6D6;
    color: #A0A0A0;
}

QPushButton:focus {
    outline: 2px solid #3D95F2;
    outline-offset: 2px;
    outline-radius: 7px;
}

/* Secondary destructive actions -- same glossy glass shape, red tint
   instead of blue, so it reads as "the same family of button" while
   staying unmistakably distinct from ordinary actions. */
QPushButton#dangerButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #FDEEEC, stop:0.45 #F8D2CD, stop:0.5 #F0B3AB, stop:1 #E59A90);
    border: 1px solid #B23A2E;
    border-radius: 5px;
    padding: 2px 10px;
    min-height: 16px;
    color: #000000;
}

QPushButton#dangerButton:hover:!pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #FFF4F2, stop:0.45 #FBDAD5, stop:0.5 #F5BAB1, stop:1 #EA9A8F);
    border: 1px solid #D9483A;
}

QPushButton#dangerButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #DC9B90, stop:0.5 #C97F72, stop:1 #E0A69A);
    border: 1px solid #7A241B;
    padding: 3px 9px 1px 11px;
}

QPushButton#dangerButton:disabled {
    background: #F0F0F0;
    border: 1px solid #D6D6D6;
    color: #A0A0A0;
}

QPushButton#dangerButton:focus {
    outline: 2px solid #3D95F2;
    outline-offset: 2px;
    outline-radius: 7px;
}

/* ---------------------------------------------------------------------
   Inputs -- flat white glass, thin gray border, blue focus/hover glow.
   --------------------------------------------------------------------- */

QLineEdit, QSpinBox, QAbstractSpinBox {
    background-color: #FFFFFF;
    border: 1px solid #B4B4B4;
    border-radius: 4px;
    padding: 2px 4px;
    selection-background-color: #3D95F2;
    selection-color: #FFFFFF;
}

QLineEdit:hover, QSpinBox:hover, QAbstractSpinBox:hover {
    border: 1px solid #3D95F2;
}

QLineEdit:focus, QSpinBox:focus, QAbstractSpinBox:focus {
    outline: 2px solid #3D95F2;
    outline-offset: 1px;
    outline-radius: 5px;
}

QLineEdit:disabled, QSpinBox:disabled, QAbstractSpinBox:disabled {
    background-color: #F0F0F0;
    border: 1px solid #D6D6D6;
    color: #A0A0A0;
}

QAbstractSpinBox::up-button, QAbstractSpinBox::down-button {
    subcontrol-origin: border;
    width: 16px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #FFFFFF, stop:0.5 #F1F1F1, stop:1 #E1E1E1);
    border-left: 1px solid #B4B4B4;
}

QAbstractSpinBox::up-button {
    subcontrol-position: top right;
    border-top-right-radius: 4px;
}

QAbstractSpinBox::down-button {
    subcontrol-position: bottom right;
    border-bottom-right-radius: 4px;
}

QAbstractSpinBox::up-button:hover, QAbstractSpinBox::down-button:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #DFF0FE, stop:1 #A9D3FB);
}

QAbstractSpinBox::up-arrow {
    width: 0; height: 0;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-bottom: 4px solid #404040;
}

QAbstractSpinBox::down-arrow {
    width: 0; height: 0;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-top: 4px solid #404040;
}

QComboBox {
    background-color: #FFFFFF;
    border: 1px solid #B4B4B4;
    border-radius: 4px;
    padding: 2px 4px;
}

QComboBox:hover {
    border: 1px solid #3D95F2;
}

QComboBox:focus {
    outline: 2px solid #3D95F2;
    outline-offset: 1px;
    outline-radius: 5px;
}

QComboBox:disabled {
    background-color: #F0F0F0;
    border: 1px solid #D6D6D6;
    color: #A0A0A0;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: right;
    width: 20px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #FFFFFF, stop:0.5 #F1F1F1, stop:1 #E1E1E1);
    border-left: 1px solid #B4B4B4;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}

QComboBox::down-arrow {
    width: 8px;
    height: 8px;
    image: none;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-top: 4px solid #404040;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #ACACAC;
    outline: none;
    selection-background-color: #3D95F2;
    selection-color: #FFFFFF;
    padding: 2px;
}

QComboBox QAbstractItemView::item {
    padding: 4px 6px;
    border-radius: 3px;
}

/* ---------------------------------------------------------------------
   Checkboxes -- flat white box, blue check, rounded corners.
   --------------------------------------------------------------------- */

QCheckBox::indicator {
    width: 13px;
    height: 13px;
    background-color: #FFFFFF;
    border: 1px solid #B4B4B4;
    border-radius: 3px;
}

QCheckBox::indicator:hover {
    border: 1px solid #3D95F2;
    background-color: #F1F8FF;
}

QCheckBox::indicator:checked {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #FFFFFF, stop:1 #DCECFE);
    border: 1px solid #3D95F2;
    image: url(theme:checkmark.png);
}

QCheckBox::indicator:focus {
    outline: 2px solid #3D95F2;
    outline-offset: 1px;
    outline-radius: 5px;
}

QCheckBox::indicator:disabled {
    background-color: #F0F0F0;
    border: 1px solid #D6D6D6;
}

/* ---------------------------------------------------------------------
   Sliders -- thin groove, round blue-accented glass handle.
   --------------------------------------------------------------------- */

QSlider::groove:horizontal {
    height: 4px;
    background-color: #C7C7C7;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    width: 14px;
    height: 14px;
    margin: -6px 0;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #FFFFFF, stop:0.5 #DCECFE, stop:1 #A9D3FB);
    border: 1px solid #3D95F2;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #F3FAFF, stop:0.5 #C3E2FD, stop:1 #8FC3F7);
    border: 1px solid #1C5FA8;
}

QSlider::handle:horizontal:focus {
    outline: 2px solid #3D95F2;
    outline-offset: 2px;
    outline-radius: 9px;
}

QSlider::handle:horizontal:disabled {
    background: #F0F0F0;
    border: 1px solid #D6D6D6;
}

/* ---------------------------------------------------------------------
   Tables / trees -- white rows, faint blue zebra striping, glass header.
   --------------------------------------------------------------------- */

QTableWidget, QTreeWidget {
    background-color: #FFFFFF;
    alternate-background-color: #F5F9FE;
    gridline-color: #E1E1E1;
    border: 1px solid #B4B4B4;
    border-radius: 4px;
    selection-background-color: #3D95F2;
    selection-color: #FFFFFF;
}

QTableWidget::item, QTreeWidget::item {
    padding: 2px 4px;
}

QTableWidget::item:hover, QTreeWidget::item:hover {
    background-color: #E3F0FD;
}

QTableWidget::item:selected, QTreeWidget::item:selected {
    background-color: #3D95F2;
    color: #FFFFFF;
}

QHeaderView::section {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #FDFDFD, stop:0.5 #F1F1F1, stop:1 #E1E1E1);
    border: 1px solid #C7C7C7;
    padding: 3px;
    font-weight: normal;
    color: #000000;
}

QHeaderView::section:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #EDF6FE, stop:1 #CDE7FD);
}

/* ---------------------------------------------------------------------
   List widget -- white glass card, blue selection, quiet hover tint.
   --------------------------------------------------------------------- */

QListWidget {
    background-color: #FFFFFF;
    border: 1px solid #B4B4B4;
    border-radius: 4px;
    padding: 2px;
    outline: none;
}

QListWidget::item {
    padding: 4px 6px;
    border-radius: 3px;
    color: #000000;
}

QListWidget::item:hover:!selected {
    background-color: #E3F0FD;
}

QListWidget::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #6FBBFB, stop:1 #3D95F2);
    color: #FFFFFF;
}

QListWidget:focus {
    outline: 2px solid #3D95F2;
    outline-offset: -1px;
}

/* ---------------------------------------------------------------------
   Context menus -- glass card, rounded, blue glass selection bar. Used
   throughout the Downloads/Share tables' right-click menus.
   --------------------------------------------------------------------- */

QMenu {
    background-color: #FFFFFF;
    border: 1px solid #ACACAC;
    border-radius: 6px;
    padding: 4px;
    color: #000000;
}

QMenu::item {
    background: transparent;
    padding: 6px 28px 6px 14px;
    margin: 1px;
    border-radius: 4px;
    color: #000000;
}

QMenu::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #EDF6FE, stop:0.5 #C3E2FD, stop:1 #A9D3FB);
    border: 1px solid #3D95F2;
    color: #000000;
}

QMenu::item:disabled {
    color: #A0A0A0;
}

QMenu::separator {
    height: 1px;
    background-color: #D6D6D6;
    margin: 4px 8px;
}

QMenu::indicator {
    width: 13px;
    height: 13px;
    left: 4px;
}

QProgressBar {
    border: 1px solid #B4B4B4;
    border-radius: 4px;
    background-color: #FFFFFF;
    text-align: center;
    color: #000000;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #8DD0FC, stop:0.5 #4FA8F5, stop:1 #2A85E0);
    border-radius: 3px;
    margin: 1px;
}

QToolTip {
    background-color: #FFFFFF;
    color: #000000;
    border: 1px solid #3D95F2;
    border-radius: 4px;
    padding: 4px 8px;
}

QLabel {
    background: transparent;
}

QSplitter::handle {
    background-color: #F0F0F0;
}

QScrollBar:vertical {
    background: #F0F0F0;
    width: 16px;
    border: 1px solid #D6D6D6;
}

QScrollBar::handle:vertical {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #E1E1E1, stop:0.5 #F5F5F5, stop:1 #C7C7C7);
    border: 1px solid #ADADAD;
    border-radius: 4px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #C3E2FD, stop:0.5 #E7F3FE, stop:1 #A9D3FB);
    border: 1px solid #3D95F2;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
    background: none;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background: #F0F0F0;
    height: 16px;
    border: 1px solid #D6D6D6;
}

QScrollBar::handle:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #E1E1E1, stop:0.5 #F5F5F5, stop:1 #C7C7C7);
    border: 1px solid #ADADAD;
    border-radius: 4px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #C3E2FD, stop:0.5 #E7F3FE, stop:1 #A9D3FB);
    border: 1px solid #3D95F2;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
    background: none;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

/* ---------------------------------------------------------------------
   Custom title bar sits directly above the tab widget in a frameless
   window -- drop the pane's top border to avoid a double line/gap.
   --------------------------------------------------------------------- */

QTabWidget#mainTabs::pane {
    border-top: none;
    top: 0px;
}

QSizeGrip {
    background-color: #F0F0F0;
    width: 16px;
    height: 16px;
}
