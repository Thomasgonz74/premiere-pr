/* Torrent 2000 -- "Windows 7 (Aero)" skin, HIGH-CONTRAST DARK variant.
   FULL REDESIGN PASS.

   Matches the real Windows "High Contrast Black" accessibility theme's
   color contract (pure black background, pure white text/borders, yellow
   focus/selection accent, no gradients or glassy bevels -- Aero's glass
   language is deliberately dropped here, because true high-contrast mode
   prioritizes flat, unambiguous edges over decorative depth) while
   keeping this theme's characteristic 6px rounded shape and Segoe UI font
   so it still reads as "Aero", just in accessibility mode.

   Token palette (name -> hex -> role):
     --win7-bg      #000000   window / dialog / every surface (flat, no
                               separate "card" tone -- HC mode uses
                               border weight, not fill, to separate areas)
     --win7-border   #FFFFFF  every control outline, 2px
     --win7-text     #FFFFFF  primary text
     --win7-muted    #7F7F7F  disabled text/borders
     --win7-accent   #FFFF00  universal focus/hover/selection accent
                               (matches the title bar's dark_hc convention
                               in ui/theme/theme_manager.py)
     --win7-danger   #FF3B30  destructive actions (still yellow on focus/
                               hover -- red only marks the resting state)

   The title bar is NOT drawn by this stylesheet -- see
   src/torrent2000/ui/widgets/app_title_bar.py.
*/

* {
    font-family: "Segoe UI", "MS Shell Dlg 2", sans-serif;
    font-size: 9pt;
}

QMainWindow, QWidget#centralWidget {
    background-color: #000000;
}

QWidget {
    background-color: #000000;
    color: #FFFFFF;
}

QDialog {
    background-color: #000000;
    color: #FFFFFF;
}

QTabWidget::pane {
    border: 2px solid #FFFFFF;
    background-color: #000000;
    top: -1px;
}

QTabBar::tab {
    background-color: #000000;
    border: 2px solid #FFFFFF;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 5px 16px;
    margin-right: 2px;
    color: #FFFFFF;
}

QTabBar::tab:selected {
    background-color: #000000;
    border-color: #FFFF00;
    border-bottom: 2px solid #000000;
    margin-top: 0px;
}

QTabBar::tab:!selected {
    margin-top: 2px;
}

QTabBar::tab:hover:!selected {
    background-color: #1A1A1A;
    border-color: #FFFF00;
    color: #FFFF00;
}

QTabBar::tab:focus {
    outline: 3px solid #FFFF00;
    outline-offset: -4px;
}

QGroupBox {
    border: 2px solid #FFFFFF;
    border-radius: 6px;
    margin-top: 10px;
    padding-top: 6px;
    background-color: #000000;
    font-weight: normal;
    color: #FFFFFF;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #FFFFFF;
}

QPushButton {
    background-color: #000000;
    border: 2px solid #FFFFFF;
    border-radius: 5px;
    padding: 4px 12px;
    min-height: 18px;
    color: #FFFFFF;
}

QPushButton:hover:!pressed {
    border: 2px solid #FFFF00;
    color: #FFFF00;
}

QPushButton:pressed {
    background-color: #FFFF00;
    border: 2px solid #FFFF00;
    color: #000000;
    padding: 5px 11px 3px 13px;
}

QPushButton:default {
    border-width: 3px;
    border-color: #FFFFFF;
}

QPushButton:disabled {
    background-color: #000000;
    border: 2px solid #7F7F7F;
    color: #7F7F7F;
}

QPushButton:focus {
    outline: 3px solid #FFFF00;
    outline-offset: 2px;
    outline-radius: 7px;
}

QPushButton#dangerButton {
    background-color: #000000;
    border: 2px solid #FF3B30;
    border-radius: 5px;
    padding: 2px 10px;
    min-height: 16px;
    color: #FF3B30;
}

QPushButton#dangerButton:hover:!pressed {
    border: 2px solid #FFFF00;
    color: #FFFF00;
}

QPushButton#dangerButton:pressed {
    background-color: #FF3B30;
    border: 2px solid #FF3B30;
    color: #000000;
    padding: 3px 9px 1px 11px;
}

QPushButton#dangerButton:disabled {
    background-color: #000000;
    border: 2px solid #7F7F7F;
    color: #7F7F7F;
}

QPushButton#dangerButton:focus {
    outline: 3px solid #FFFF00;
    outline-offset: 2px;
    outline-radius: 7px;
}

QLineEdit, QSpinBox, QAbstractSpinBox {
    background-color: #000000;
    border: 2px solid #FFFFFF;
    border-radius: 4px;
    padding: 2px 4px;
    color: #FFFFFF;
    selection-background-color: #FFFF00;
    selection-color: #000000;
}

QLineEdit:hover, QSpinBox:hover, QAbstractSpinBox:hover {
    border: 2px solid #FFFF00;
}

QLineEdit:focus, QSpinBox:focus, QAbstractSpinBox:focus {
    outline: 3px solid #FFFF00;
    outline-offset: 1px;
    outline-radius: 5px;
}

QLineEdit:disabled, QSpinBox:disabled, QAbstractSpinBox:disabled {
    background-color: #000000;
    border: 2px solid #7F7F7F;
    color: #7F7F7F;
}

QAbstractSpinBox::up-button, QAbstractSpinBox::down-button {
    subcontrol-origin: border;
    width: 18px;
    background-color: #000000;
    border-left: 2px solid #FFFFFF;
}

QAbstractSpinBox::up-button {
    subcontrol-position: top right;
    border-top-right-radius: 4px;
}

QAbstractSpinBox::down-button {
    subcontrol-position: bottom right;
    border-bottom-right-radius: 4px;
}

QAbstractSpinBox::up-button:hover, QAbstractSpinBox::down-button:hover {
    background-color: #1A1A1A;
    border-left: 2px solid #FFFF00;
}

QAbstractSpinBox::up-arrow {
    width: 0; height: 0;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-bottom: 4px solid #FFFFFF;
}

QAbstractSpinBox::down-arrow {
    width: 0; height: 0;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-top: 4px solid #FFFFFF;
}

QComboBox {
    background-color: #000000;
    border: 2px solid #FFFFFF;
    border-radius: 4px;
    padding: 2px 4px;
    color: #FFFFFF;
}

QComboBox:hover {
    border: 2px solid #FFFF00;
}

QComboBox:focus {
    outline: 3px solid #FFFF00;
    outline-offset: 1px;
    outline-radius: 5px;
}

QComboBox:disabled {
    background-color: #000000;
    border: 2px solid #7F7F7F;
    color: #7F7F7F;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: right;
    width: 20px;
    background-color: #000000;
    border-left: 2px solid #FFFFFF;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}

QComboBox::down-arrow {
    width: 8px;
    height: 8px;
    image: none;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-top: 4px solid #FFFFFF;
}

QComboBox QAbstractItemView {
    background-color: #000000;
    color: #FFFFFF;
    border: 2px solid #FFFFFF;
    outline: none;
    selection-background-color: #FFFF00;
    selection-color: #000000;
    padding: 2px;
}

QComboBox QAbstractItemView::item {
    padding: 4px 6px;
    border-radius: 3px;
}

QCheckBox::indicator {
    width: 14px;
    height: 14px;
    background-color: #000000;
    border: 2px solid #FFFFFF;
    border-radius: 3px;
}

QCheckBox::indicator:hover {
    border: 2px solid #FFFF00;
}

QCheckBox::indicator:checked {
    background-color: #FFFF00;
    border: 2px solid #FFFF00;
    image: url(theme:checkmark.png);
}

QCheckBox::indicator:focus {
    outline: 3px solid #FFFF00;
    outline-offset: 1px;
    outline-radius: 5px;
}

QCheckBox::indicator:disabled {
    background-color: #000000;
    border: 2px solid #7F7F7F;
}

QSlider::groove:horizontal {
    height: 4px;
    background-color: #FFFFFF;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    width: 15px;
    height: 15px;
    margin: -7px 0;
    background-color: #FFFF00;
    border: 2px solid #FFFF00;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background-color: #000000;
    border: 2px solid #FFFF00;
}

QSlider::handle:horizontal:focus {
    outline: 3px solid #FFFF00;
    outline-offset: 2px;
    outline-radius: 9px;
}

QSlider::handle:horizontal:disabled {
    background-color: #000000;
    border: 2px solid #7F7F7F;
}

QTableWidget, QTreeWidget {
    background-color: #000000;
    alternate-background-color: #1A1A1A;
    gridline-color: #7F7F7F;
    border: 2px solid #FFFFFF;
    border-radius: 4px;
    color: #FFFFFF;
    selection-background-color: #FFFF00;
    selection-color: #000000;
}

QTableWidget::item, QTreeWidget::item {
    padding: 2px 4px;
}

QTableWidget::item:hover, QTreeWidget::item:hover {
    background-color: #333300;
    color: #FFFF00;
}

QTableWidget::item:selected, QTreeWidget::item:selected {
    background-color: #FFFF00;
    color: #000000;
}

QHeaderView::section {
    background-color: #000000;
    border: 2px solid #FFFFFF;
    padding: 3px;
    font-weight: normal;
    color: #FFFFFF;
}

QHeaderView::section:hover {
    border: 2px solid #FFFF00;
    color: #FFFF00;
}

QListWidget {
    background-color: #000000;
    border: 2px solid #FFFFFF;
    border-radius: 4px;
    padding: 2px;
    color: #FFFFFF;
    outline: none;
}

QListWidget::item {
    padding: 4px 6px;
    border-radius: 3px;
    color: #FFFFFF;
}

QListWidget::item:hover:!selected {
    background-color: #333300;
    color: #FFFF00;
}

QListWidget::item:selected {
    background-color: #FFFF00;
    color: #000000;
}

QListWidget:focus {
    outline: 3px solid #FFFF00;
    outline-offset: -2px;
}

QMenu {
    background-color: #000000;
    border: 2px solid #FFFFFF;
    border-radius: 6px;
    padding: 4px;
    color: #FFFFFF;
}

QMenu::item {
    background: transparent;
    padding: 6px 28px 6px 14px;
    margin: 1px;
    border-radius: 4px;
    color: #FFFFFF;
}

QMenu::item:selected {
    background-color: #FFFF00;
    border: 1px solid #FFFF00;
    color: #000000;
}

QMenu::item:disabled {
    color: #7F7F7F;
}

QMenu::separator {
    height: 2px;
    background-color: #FFFFFF;
    margin: 4px 8px;
}

QMenu::indicator {
    width: 14px;
    height: 14px;
    left: 4px;
}

QProgressBar {
    border: 2px solid #FFFFFF;
    border-radius: 4px;
    background-color: #000000;
    text-align: center;
    color: #FFFFFF;
}

QProgressBar::chunk {
    background-color: #FFFF00;
    border-radius: 2px;
    margin: 1px;
}

QToolTip {
    background-color: #000000;
    color: #FFFFFF;
    border: 2px solid #FFFFFF;
    border-radius: 4px;
    padding: 4px 8px;
}

QLabel {
    background: transparent;
    color: #FFFFFF;
}

QSplitter::handle {
    background-color: #000000;
}

QScrollBar:vertical {
    background: #000000;
    width: 16px;
    border: 2px solid #FFFFFF;
}

QScrollBar::handle:vertical {
    background-color: #FFFFFF;
    border-radius: 3px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background-color: #FFFF00;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
    background: none;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background: #000000;
    height: 16px;
    border: 2px solid #FFFFFF;
}

QScrollBar::handle:horizontal {
    background-color: #FFFFFF;
    border-radius: 3px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #FFFF00;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
    background: none;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

QTabWidget#mainTabs::pane {
    border-top: none;
    top: 0px;
}

QSizeGrip {
    background-color: #000000;
    width: 16px;
    height: 16px;
}
