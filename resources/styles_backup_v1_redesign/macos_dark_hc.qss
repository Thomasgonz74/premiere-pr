/* ==========================================================================
   Torrent 2000 -- "macOS" skin -- HIGH-CONTRAST DARK appearance (full redesign)
   ==========================================================================

   Matches the real "High Contrast Black" accessibility contract used across
   every theme in this project (pure black surfaces, pure white text/
   borders, #FFFF00 as the one universal focus/hover/selection accent) while
   keeping this theme's identity: pill/heavily-rounded shapes and the
   "SF Pro Display" font stack. Borders are thickened to 2px throughout (vs.
   1px in light/dark) -- high-contrast mode reads state through geometry as
   much as color, so hairlines are not enough here.

   Token palette (name -> hex -> role):
     --bg            #000000   window background
     --surface       #000000   panel/control surface -- true HC keeps a
                                single flat black field, differentiated by
                                border weight/color rather than tone
     --surface-alt   #141414   faint recessed surface (alt table rows only
                                -- kept dark enough to stay effectively
                                black while still reading as a second row)
     --border        #FFFFFF   pure white hairline/rule, 2px everywhere
     --text          #FFFFFF   primary label ink
     --text-muted    #D0D0D0   secondary/caption ink -- still high-contrast,
                                just enough dimmer to read as "quieter"
     --accent        #FFFF00   universal HC focus/hover/selection yellow
                                (matches the title bar's dark_hc convention
                                in theme_manager.py)
     --accent-ink    #000000   text/glyph color used *on* a yellow fill
     --danger        #FF453A   destructive-only red, reserved for danger
                                button idle/pressed states so it stays
                                distinguishable from the universal yellow
                                focus/hover accent

   Shape and font stack are identical to macos.qss/macos_dark.qss -- see
   macos.qss's header for the full rationale.
   ========================================================================== */

* {
    font-family: "SF Pro Display", "Helvetica Neue", "Segoe UI", "Arial", sans-serif;
    font-size: 9pt;
}

QMainWindow, QWidget#centralWidget {
    background-color: #000000;
}

QWidget {
    background-color: #000000;
    color: #FFFFFF;
}

/* ---------------------------------------------------------------------
   Tabs
   --------------------------------------------------------------------- */

QTabWidget::pane {
    border: 2px solid #FFFFFF;
    border-radius: 10px;
    background-color: #000000;
    top: -1px;
}

QTabBar::tab {
    background-color: #000000;
    border: 2px solid #FFFFFF;
    border-radius: 8px;
    padding: 6px 18px;
    margin: 4px 2px 6px 2px;
    color: #D0D0D0;
}

QTabBar::tab:selected {
    background-color: #000000;
    border: 2px solid #FFFF00;
    color: #FFFF00;
    font-weight: 600;
}

QTabBar::tab:!selected {
    color: #D0D0D0;
}

QTabBar::tab:hover:!selected {
    border: 2px solid #FFFF00;
    color: #FFFF00;
}

QTabBar::tab:focus {
    outline: 2px solid #FFFF00;
    outline-offset: -4px;
    outline-radius: 6px;
}

/* ---------------------------------------------------------------------
   Group boxes
   --------------------------------------------------------------------- */

QGroupBox {
    border: 2px solid #FFFFFF;
    border-radius: 10px;
    margin-top: 14px;
    padding-top: 10px;
    background-color: #000000;
    font-weight: 600;
    color: #FFFFFF;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 14px;
    top: 2px;
    padding: 0 5px;
    color: #FFFFFF;
}

/* ---------------------------------------------------------------------
   Buttons
   --------------------------------------------------------------------- */

QPushButton {
    background-color: #000000;
    border: 2px solid #FFFFFF;
    border-radius: 14px;
    padding: 5px 18px;
    min-height: 20px;
    color: #FFFFFF;
}

QPushButton:hover:!pressed {
    border: 2px solid #FFFF00;
    color: #FFFF00;
}

QPushButton:pressed {
    background-color: #FFFF00;
    border: 2px solid #FFFF00;
    color: #000000;
}

QPushButton:default {
    border-width: 3px;
    border-color: #FFFFFF;
    font-weight: 600;
}

QPushButton:default:hover:!pressed {
    border-color: #FFFF00;
    color: #FFFF00;
}

QPushButton:default:pressed {
    background-color: #FFFF00;
    border-color: #FFFF00;
    color: #000000;
}

QPushButton:disabled {
    background-color: #000000;
    border: 2px solid #7F7F7F;
    color: #7F7F7F;
}

QPushButton:focus {
    outline: 2px solid #FFFF00;
    outline-offset: 2px;
    outline-radius: 16px;
}

QPushButton#dangerButton {
    background-color: #000000;
    border: 2px solid #FF453A;
    border-radius: 14px;
    padding: 5px 18px;
    min-height: 20px;
    color: #FF453A;
}

QPushButton#dangerButton:hover:!pressed {
    border: 2px solid #FFFF00;
    color: #FFFF00;
}

QPushButton#dangerButton:pressed {
    background-color: #FF453A;
    border: 2px solid #FF453A;
    color: #000000;
}

QPushButton#dangerButton:disabled {
    background-color: #000000;
    border: 2px solid #7F7F7F;
    color: #7F7F7F;
}

QPushButton#dangerButton:focus {
    outline: 2px solid #FFFF00;
    outline-offset: 2px;
    outline-radius: 16px;
}

/* ---------------------------------------------------------------------
   Text inputs
   --------------------------------------------------------------------- */

QLineEdit, QSpinBox, QAbstractSpinBox {
    background-color: #000000;
    border: 2px solid #FFFFFF;
    border-radius: 8px;
    padding: 4px 8px;
    color: #FFFFFF;
    selection-background-color: #FFFF00;
    selection-color: #000000;
}

QLineEdit:hover, QSpinBox:hover, QAbstractSpinBox:hover {
    border: 2px solid #FFFF00;
}

QLineEdit:focus, QSpinBox:focus, QAbstractSpinBox:focus {
    border: 2px solid #FFFF00;
    outline: 2px solid #FFFF00;
    outline-offset: 1px;
    outline-radius: 9px;
}

QLineEdit:disabled, QSpinBox:disabled, QAbstractSpinBox:disabled {
    background-color: #000000;
    border: 2px solid #7F7F7F;
    color: #7F7F7F;
}

QAbstractSpinBox::up-button, QAbstractSpinBox::down-button {
    width: 16px;
    border: none;
    background: transparent;
}

QAbstractSpinBox::up-arrow {
    width: 7px;
    height: 7px;
    image: none;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-bottom: 4px solid #FFFFFF;
}

QAbstractSpinBox::down-arrow {
    width: 7px;
    height: 7px;
    image: none;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-top: 4px solid #FFFFFF;
}

/* ---------------------------------------------------------------------
   Combo box
   --------------------------------------------------------------------- */

QComboBox {
    background-color: #000000;
    border: 2px solid #FFFFFF;
    border-radius: 8px;
    padding: 4px 8px;
    color: #FFFFFF;
}

QComboBox:hover {
    border: 2px solid #FFFF00;
}

QComboBox:focus {
    border: 2px solid #FFFF00;
    outline: 2px solid #FFFF00;
    outline-offset: 1px;
    outline-radius: 9px;
}

QComboBox:disabled {
    background-color: #000000;
    border: 2px solid #7F7F7F;
    color: #7F7F7F;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: right;
    width: 22px;
    background-color: transparent;
    border: none;
}

QComboBox::down-arrow {
    width: 8px;
    height: 8px;
    image: none;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-top: 4px solid #FFFFFF;
}

QComboBox::down-arrow:disabled {
    border-top: 4px solid #7F7F7F;
}

QComboBox QAbstractItemView {
    background-color: #000000;
    color: #FFFFFF;
    border: 2px solid #FFFFFF;
    border-radius: 10px;
    padding: 4px;
    outline: none;
    selection-background-color: #FFFF00;
    selection-color: #000000;
}

QComboBox QAbstractItemView::item {
    padding: 5px 8px;
    border-radius: 6px;
    min-height: 18px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #000000;
    border: 1px solid #FFFF00;
    color: #FFFF00;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #FFFF00;
    color: #000000;
}

/* ---------------------------------------------------------------------
   Checkbox
   --------------------------------------------------------------------- */

QCheckBox {
    spacing: 8px;
    color: #FFFFFF;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    background-color: #000000;
    border: 2px solid #FFFFFF;
    border-radius: 5px;
}

QCheckBox::indicator:hover {
    border: 2px solid #FFFF00;
}

QCheckBox::indicator:focus {
    outline: 2px solid #FFFF00;
    outline-offset: 1px;
    outline-radius: 7px;
}

QCheckBox::indicator:checked {
    background-color: #FFFF00;
    border: 2px solid #FFFF00;
    image: url(theme:checkmark.png);
}

QCheckBox::indicator:checked:hover {
    background-color: #FFFF66;
    border: 2px solid #FFFF66;
}

QCheckBox::indicator:disabled {
    background-color: #000000;
    border: 2px solid #7F7F7F;
}

QCheckBox::indicator:checked:disabled {
    background-color: #7F7F7F;
    border: 2px solid #7F7F7F;
}

QCheckBox:disabled {
    color: #7F7F7F;
}

/* ---------------------------------------------------------------------
   Slider
   --------------------------------------------------------------------- */

QSlider::groove:horizontal {
    height: 4px;
    background-color: #FFFFFF;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    height: 4px;
    background-color: #FFFF00;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    width: 18px;
    height: 18px;
    margin: -7px 0;
    background-color: #FFFF00;
    border: 2px solid #FFFF00;
    border-radius: 9px;
}

QSlider::handle:horizontal:hover {
    background-color: #FFFF66;
    border: 2px solid #FFFF66;
}

QSlider::handle:horizontal:focus {
    outline: 2px solid #FFFF00;
    outline-offset: 2px;
    outline-radius: 10px;
}

QSlider::handle:horizontal:disabled {
    background-color: #7F7F7F;
    border: 2px solid #7F7F7F;
}

QSlider::groove:horizontal:disabled, QSlider::sub-page:horizontal:disabled {
    background-color: #4A4A4A;
}

/* ---------------------------------------------------------------------
   Tables / trees / lists
   --------------------------------------------------------------------- */

QTableWidget, QTreeWidget, QListWidget {
    background-color: #000000;
    alternate-background-color: #141414;
    gridline-color: #7F7F7F;
    border: 2px solid #FFFFFF;
    border-radius: 10px;
    outline: none;
    color: #FFFFFF;
    selection-background-color: #FFFF00;
    selection-color: #000000;
}

QTableWidget:focus, QTreeWidget:focus, QListWidget:focus {
    border: 2px solid #FFFF00;
}

QTreeWidget::item, QListWidget::item {
    padding: 4px 6px;
    border-radius: 5px;
    color: #FFFFFF;
}

QTreeWidget::item:hover, QListWidget::item:hover {
    border: 1px solid #FFFF00;
    color: #FFFF00;
}

QTreeWidget::item:selected, QListWidget::item:selected {
    background-color: #FFFF00;
    color: #000000;
}

QHeaderView::section {
    background-color: #000000;
    border: none;
    border-right: 2px solid #FFFFFF;
    border-bottom: 2px solid #FFFFFF;
    padding: 5px 8px;
    font-weight: 600;
    color: #FFFFFF;
}

QHeaderView::section:hover {
    color: #FFFF00;
}

/* ---------------------------------------------------------------------
   Menus (context menus + menu bar dropdowns)
   --------------------------------------------------------------------- */

QMenu {
    background-color: #000000;
    border: 2px solid #FFFFFF;
    border-radius: 10px;
    padding: 6px;
}

QMenu::item {
    background-color: transparent;
    padding: 6px 28px 6px 14px;
    margin: 1px 4px;
    border-radius: 6px;
    color: #FFFFFF;
}

QMenu::item:selected {
    background-color: #FFFF00;
    color: #000000;
}

QMenu::item:disabled {
    color: #7F7F7F;
}

QMenu::separator {
    height: 2px;
    background-color: #FFFFFF;
    margin: 6px 10px;
}

QMenu::indicator {
    width: 14px;
    height: 14px;
    left: 4px;
}

/* ---------------------------------------------------------------------
   Dialogs
   --------------------------------------------------------------------- */

QDialog {
    background-color: #000000;
    color: #FFFFFF;
}

/* ---------------------------------------------------------------------
   Progress bar
   --------------------------------------------------------------------- */

QProgressBar {
    border: 2px solid #FFFFFF;
    border-radius: 7px;
    background-color: #000000;
    text-align: center;
    color: #FFFFFF;
    min-height: 14px;
}

QProgressBar::chunk {
    background-color: #FFFF00;
    border-radius: 5px;
    margin: 1px;
}

/* ---------------------------------------------------------------------
   Misc / chrome
   --------------------------------------------------------------------- */

QLabel {
    background: transparent;
    color: #FFFFFF;
}

QSplitter::handle {
    background-color: #000000;
}

QSplitter::handle:hover {
    background-color: #FFFF00;
}

QScrollBar:vertical {
    background: #000000;
    width: 14px;
    border: 2px solid #FFFFFF;
}

QScrollBar::handle:vertical {
    background-color: #FFFFFF;
    border-radius: 5px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background-color: #FFFF00;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
    border: none;
    background: none;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background: #000000;
    height: 14px;
    border: 2px solid #FFFFFF;
}

QScrollBar::handle:horizontal {
    background-color: #FFFFFF;
    border-radius: 5px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #FFFF00;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
    border: none;
    background: none;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

QToolTip {
    background-color: #000000;
    color: #FFFFFF;
    border: 2px solid #FFFFFF;
    border-radius: 7px;
    padding: 5px 9px;
}

/* ---------------------------------------------------------------------
   Custom title bar sits directly above the tab widget in a frameless
   window -- drop the pane's top border to avoid a double line/gap.
   --------------------------------------------------------------------- */

QTabWidget#mainTabs::pane {
    border-top: none;
    top: 0px;
}

QSizeGrip {
    background-color: transparent;
    width: 16px;
    height: 16px;
}
