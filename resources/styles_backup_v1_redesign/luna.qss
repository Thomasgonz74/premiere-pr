/* Torrent 2000 -- Windows XP "Luna Blue" skin (LIGHT / default appearance).

   Full ground-up redesign: authentic Luna Blue, not the tan "Windows
   Classic" look. Reference: the real luna.msstyles "NormalColor" scheme --
   glossy silver-pearl control surfaces, king's-blue hot-track accent, and
   the rounded-oval push buttons with a bright highlight sweep across their
   top half that made Luna instantly recognizable. The window frame itself
   stays square (XP never rounded the window, only its themed controls --
   see window_corner_radius=0 for "luna_xp" in ui/theme/theme_manager.py);
   every control below deliberately rounds its own corners instead.

   Design tokens (documented here, referenced by value throughout the file
   since Qt QSS has no variables):

     bg            #ECEBF2   window / pane background -- pearl silver-gray
                              with a cool cast, Luna's signature surface
                              tone (distinct from Classic's tan #ECE9D8)
     surface       #F8F8FC   raised panel surface -- menus, dialogs, the
                              brighter near-white pearl one step up from bg
     border        #8FA4C7   steel-blue structural border, used at rest
     text          #000000   primary window text (real Win32 window text)
     muted         #6B7280   secondary / disabled text, cool gray
     accent        #3169C6   Luna hot-track blue -- anchored directly to
                              the title bar's caption gradient start (see
                              TITLE_BAR_STYLES["luna_xp"] in theme_manager.py)
                              so every focus ring/selection/hover glow reads
                              as "the same blue" as the caption above it
     accent-hover  #5B93E8   brighter glossy highlight blue for hover states
     danger        #C0392B   destructive-action red, muted vs. the title
                              bar's close-button red (#D42A2A) so it reads
                              "destructive" without competing with that

   Derived (not primary tokens, but used throughout): #0A246A is the title
   bar gradient's *end* color, reused here as the deep pressed/gradient-
   bottom tone so buttons feel cut from the same cloth as the caption.
   #FFFFFF supplies the glossy top-highlight sheen on every raised control.

   The title bar itself (blue gradient caption + red close button) is NOT
   drawn by this stylesheet -- see src/torrent2000/ui/widgets/app_title_bar.py
*/

* {
    font-family: "Tahoma", "MS Shell Dlg 2", "Segoe UI", sans-serif;
    font-size: 8pt;
}

QMainWindow, QWidget#centralWidget {
    background-color: #ECEBF2;
}

QWidget {
    background-color: #ECEBF2;
    color: #000000;
}

/* ---------------------------------------------------------------------
   Tabs -- glossy silver-blue gradient on unselected tabs (subtle vertical
   sheen), flat pearl on the selected tab so it merges seamlessly with the
   pane below. Hover brightens the gradient toward white; keyboard focus
   gets its own bright blue ring, distinct from plain hover.
   --------------------------------------------------------------------- */

QTabWidget::pane {
    border: 1px solid #8FA4C7;
    border-radius: 6px;
    background-color: #ECEBF2;
    top: -1px;
}

QTabBar::tab {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #FFFFFF, stop:0.5 #E7EEF9, stop:1 #CBDAEF);
    border: 1px solid #8FA4C7;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 5px 16px;
    margin-right: 2px;
    color: #33363D;
}

QTabBar::tab:selected {
    background-color: #ECEBF2;
    border-color: #8FA4C7;
    border-bottom: 1px solid #ECEBF2;
    margin-top: 0px;
    color: #000000;
    font-weight: bold;
}

QTabBar::tab:!selected {
    margin-top: 3px;
}

QTabBar::tab:hover:!selected {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #FFFFFF, stop:0.5 #F2F8FF, stop:1 #DCEAFB);
    color: #000000;
}

QTabBar::tab:focus {
    border: 2px solid #3169C6;
    padding: 4px 15px;
}

/* ---------------------------------------------------------------------
   Group boxes -- crisp pearl panel, rounded like the rest of Luna's chrome.
   Title text picks up the accent blue, echoing the blue section headers
   Explorer's themed task panes used under Luna.
   --------------------------------------------------------------------- */

QGroupBox {
    border: 1px solid #8FA4C7;
    border-radius: 6px;
    margin-top: 12px;
    padding-top: 8px;
    background-color: #ECEBF2;
    font-weight: bold;
    color: #000000;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 5px;
    color: #2A57A8;
}

/* ---------------------------------------------------------------------
   Buttons -- the Luna signature: a rounded-oval push button with a bright
   glossy highlight across its top half fading to a soft blue-silver base,
   a steel-blue border, and the characteristic king's-blue "hot-track" glow
   on hover/focus. Pressed inverts the gradient (dark-to-light) so it reads
   as physically pushed in, and nudges the padding by 1px per side so the
   button's outer box never jumps size between states.
   --------------------------------------------------------------------- */

QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #FFFFFF, stop:0.45 #EAF2FD, stop:0.5 #D7E7FA, stop:1 #B9D6F2);
    border: 1px solid #6E96C9;
    border-radius: 9px;
    padding: 5px 16px;
    min-height: 20px;
    color: #000000;
}

QPushButton:hover:!pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #FFFFFF, stop:0.45 #F3F9FF, stop:0.5 #E3F0FD, stop:1 #C7E2F8);
    border: 1px solid #3D7FE0;
}

QPushButton:focus {
    border: 2px solid #3169C6;
    padding: 4px 15px;
}

QPushButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #A9C8EE, stop:0.5 #C3DBF6, stop:1 #E8F2FC);
    border: 1px solid #2A5AA8;
    padding: 6px 15px 4px 17px;
}

QPushButton:default {
    border: 2px solid #3169C6;
    padding: 4px 15px;
}

QPushButton:default:pressed {
    padding: 5px 14px 3px 16px;
}

QPushButton:disabled {
    background: #ECEBF2;
    border: 1px solid #C3C7D1;
    color: #A7ACB8;
}

/* Secondary destructive actions (remove a torrent / remove a tracker row)
   -- same glossy oval shape, tinted a muted red at roughly half the
   strength of the title bar's close button (#D42A2A) so it reads as
   "destructive" without competing with that button's full-alarm red. Hover
   still shows Luna's universal blue hot-track ring, matching real XP where
   every control's hover halo is the same king's blue regardless of its
   own base color. */
QPushButton#dangerButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #FCEEEC, stop:0.45 #F6CCC5, stop:0.5 #F0B3A9, stop:1 #E0897A);
    border: 1px solid #B23A2C;
    border-radius: 9px;
    padding: 3px 14px;
    min-height: 18px;
    color: #4A1008;
}

QPushButton#dangerButton:hover:!pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #FFFFFF, stop:0.45 #FADAD4, stop:0.5 #F5C0B7, stop:1 #E8998C);
    border: 1px solid #3D7FE0;
}

QPushButton#dangerButton:focus {
    border: 2px solid #3169C6;
    padding: 2px 13px;
}

QPushButton#dangerButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #C9695A, stop:0.5 #DE9184, stop:1 #F0BBB0);
    border: 1px solid #7A1F14;
    padding: 4px 13px 2px 15px;
}

/* ---------------------------------------------------------------------
   Inputs -- Luna's themed edit controls dropped the classic sunken bevel
   for a flat, single-weight steel-blue outline on a crisp white field;
   rounded corners match the button family. Focus and hover both compensate
   padding so the box never resizes when the border thickens.
   --------------------------------------------------------------------- */

QLineEdit, QSpinBox, QAbstractSpinBox {
    background-color: #FFFFFF;
    border: 1px solid #8FA4C7;
    border-radius: 5px;
    padding: 4px 8px;
    color: #000000;
    selection-background-color: #3169C6;
    selection-color: #FFFFFF;
}

QLineEdit:hover, QSpinBox:hover, QAbstractSpinBox:hover {
    border: 1px solid #3169C6;
}

QLineEdit:focus, QSpinBox:focus, QAbstractSpinBox:focus {
    border: 2px solid #3169C6;
    padding: 3px 7px;
}

QLineEdit:disabled, QSpinBox:disabled, QAbstractSpinBox:disabled {
    background-color: #ECEBF2;
    border: 1px solid #C3C7D1;
    color: #A7ACB8;
}

QAbstractSpinBox::up-button, QAbstractSpinBox::down-button {
    subcontrol-origin: border;
    width: 16px;
    background-color: #ECEBF2;
    border-left: 1px solid #8FA4C7;
}

QAbstractSpinBox::up-button {
    subcontrol-position: top right;
    border-top-right-radius: 5px;
}

QAbstractSpinBox::down-button {
    subcontrol-position: bottom right;
    border-bottom-right-radius: 5px;
}

QAbstractSpinBox::up-button:hover, QAbstractSpinBox::down-button:hover {
    background-color: #DCEAFB;
}

QAbstractSpinBox::up-arrow {
    width: 0;
    height: 0;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-bottom: 4px solid #3169C6;
}

QAbstractSpinBox::down-arrow {
    width: 0;
    height: 0;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-top: 4px solid #3169C6;
}

QComboBox {
    background-color: #FFFFFF;
    border: 1px solid #8FA4C7;
    border-radius: 5px;
    padding: 4px 8px;
    min-height: 20px;
    color: #000000;
}

QComboBox:hover {
    border: 1px solid #3169C6;
}

QComboBox:focus {
    border: 2px solid #3169C6;
    padding: 3px 7px;
}

QComboBox:disabled {
    background-color: #ECEBF2;
    border: 1px solid #C3C7D1;
    color: #A7ACB8;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: right;
    width: 20px;
    border-left: 1px solid #8FA4C7;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #FFFFFF, stop:0.5 #DCEAFB, stop:1 #B9D6F2);
}

QComboBox::drop-down:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #FFFFFF, stop:0.5 #E9F3FF, stop:1 #C7E2F8);
}

QComboBox::down-arrow {
    width: 0;
    height: 0;
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #3169C6;
}

QComboBox::down-arrow:disabled {
    border-top-color: #A7ACB8;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #3169C6;
    border-radius: 4px;
    outline: none;
    padding: 2px;
    selection-background-color: #3169C6;
    selection-color: #FFFFFF;
}

/* ---------------------------------------------------------------------
   Checkboxes -- small rounded-square well, filled pearl-blue when checked.
   --------------------------------------------------------------------- */

QCheckBox {
    spacing: 6px;
    color: #000000;
}

QCheckBox::indicator {
    width: 13px;
    height: 13px;
    border-radius: 3px;
    background-color: #FFFFFF;
    border: 1px solid #8FA4C7;
}

QCheckBox::indicator:hover {
    border: 1px solid #3169C6;
}

QCheckBox::indicator:focus {
    border: 2px solid #3169C6;
}

QCheckBox::indicator:checked {
    background-color: #E7F0FD;
    border: 1px solid #3169C6;
    image: url(theme:checkmark.png);
}

QCheckBox::indicator:disabled {
    background-color: #ECEBF2;
    border: 1px solid #C3C7D1;
}

QCheckBox:disabled {
    color: #A7ACB8;
}

/* ---------------------------------------------------------------------
   Sliders -- glossy oval thumb over a shallow sunken groove.
   --------------------------------------------------------------------- */

QSlider::groove:horizontal {
    height: 5px;
    border-radius: 2px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #B7C3D9, stop:1 #E4E9F2);
    border: 1px solid #8FA4C7;
}

QSlider::handle:horizontal {
    width: 15px;
    height: 15px;
    margin: -6px 0;
    border-radius: 7px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #FFFFFF, stop:0.5 #DCEAFB, stop:1 #9EC0EC);
    border: 1px solid #3169C6;
}

QSlider::handle:horizontal:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #FFFFFF, stop:0.5 #EAF3FF, stop:1 #B5D3F5);
}

QSlider::handle:horizontal:focus {
    border: 2px solid #3169C6;
    margin: -7px -1px;
}

QSlider::handle:horizontal:disabled {
    background: #ECEBF2;
    border: 1px solid #C3C7D1;
}

QSlider::sub-page:horizontal {
    background: #7EAEEF;
    border-radius: 2px;
}

/* ---------------------------------------------------------------------
   Tables / trees -- crisp white grid with a pearl-blue alternate row and
   the same king's-blue selection as everywhere else.
   --------------------------------------------------------------------- */

QTableWidget, QTreeWidget {
    background-color: #FFFFFF;
    alternate-background-color: #F1F4FA;
    gridline-color: #D9E0EC;
    border: 1px solid #8FA4C7;
    outline: none;
    selection-background-color: #3169C6;
    selection-color: #FFFFFF;
}

QTableWidget::item:hover, QTreeWidget::item:hover {
    background-color: #DCEAFB;
}

QHeaderView::section {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #FFFFFF, stop:0.5 #E7EEF9, stop:1 #CBDAEF);
    border: none;
    border-right: 1px solid #B7C4DA;
    border-bottom: 1px solid #8FA4C7;
    padding: 4px 6px;
    font-weight: bold;
    color: #000000;
}

QHeaderView::section:hover {
    background: #DCEAFB;
}

/* ---------------------------------------------------------------------
   List widget -- NEW: was absent from the previous skin. Same pearl card
   shell and hover/selection language as tables so lists never look like
   they wandered in from a different theme.
   --------------------------------------------------------------------- */

QListWidget {
    background-color: #FFFFFF;
    border: 1px solid #8FA4C7;
    border-radius: 4px;
    outline: none;
    padding: 2px;
    selection-background-color: #3169C6;
    selection-color: #FFFFFF;
}

QListWidget::item {
    padding: 3px 6px;
    border-radius: 3px;
    color: #000000;
}

QListWidget::item:hover {
    background-color: #DCEAFB;
}

QListWidget::item:selected {
    background-color: #3169C6;
    color: #FFFFFF;
}

/* ---------------------------------------------------------------------
   Menus -- NEW: right-click context menus (Downloads/Share tables) and
   menu-bar dropdowns previously fell back to raw OS rendering, breaking
   the theme the moment a menu opened. Rounded pearl card, king's-blue
   selection bar, thin steel-blue frame.
   --------------------------------------------------------------------- */

QMenu {
    background-color: #F8F8FC;
    border: 1px solid #6E96C9;
    border-radius: 6px;
    padding: 3px;
}

QMenu::item {
    background-color: transparent;
    padding: 5px 26px 5px 14px;
    margin: 1px 3px;
    border-radius: 4px;
    color: #000000;
}

QMenu::item:selected {
    background-color: #316AC5;
    color: #FFFFFF;
}

QMenu::item:disabled {
    color: #A7ACB8;
}

QMenu::separator {
    height: 1px;
    background-color: #C3CEE0;
    margin: 4px 8px;
}

/* ---------------------------------------------------------------------
   Dialogs -- NEW: torrent creation, file-priority editing, profile
   dialogs etc. previously fell back to the OS's default gray. Matches the
   main window's pearl surface so a dialog never looks like a foreign app.
   --------------------------------------------------------------------- */

QDialog {
    background-color: #ECEBF2;
    color: #000000;
}

QProgressBar {
    border: 1px solid #8FA4C7;
    border-radius: 4px;
    background-color: #FFFFFF;
    text-align: center;
    color: #000000;
    min-height: 16px;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #7EB4F7, stop:0.5 #3D7FE0, stop:1 #2A5AA8);
    border-radius: 3px;
    margin: 1px;
}

QLabel {
    background: transparent;
}

QLabel:disabled {
    color: #A7ACB8;
}

QToolTip {
    background-color: #FFFFE1;
    border: 1px solid #000000;
    padding: 3px 6px;
    color: #000000;
}

QSplitter::handle {
    background-color: #ECEBF2;
}

QSplitter::handle:hover {
    background-color: #DCEAFB;
}

QScrollBar:vertical {
    background: #ECEBF2;
    width: 17px;
    border-left: 1px solid #C3CEE0;
}

QScrollBar::handle:vertical {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #FFFFFF, stop:0.5 #DCEAFB, stop:1 #B9D6F2);
    border: 1px solid #8FA4C7;
    border-radius: 4px;
    min-height: 24px;
    margin: 2px 3px;
}

QScrollBar::handle:vertical:hover {
    border: 1px solid #3169C6;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #FFFFFF, stop:0.5 #E9F3FF, stop:1 #C7E2F8);
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
    border: none;
    background: none;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background: #ECEBF2;
    height: 17px;
    border-top: 1px solid #C3CEE0;
}

QScrollBar::handle:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #FFFFFF, stop:0.5 #DCEAFB, stop:1 #B9D6F2);
    border: 1px solid #8FA4C7;
    border-radius: 4px;
    min-width: 24px;
    margin: 3px 2px;
}

QScrollBar::handle:horizontal:hover {
    border: 1px solid #3169C6;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #FFFFFF, stop:0.5 #E9F3FF, stop:1 #C7E2F8);
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
    border: none;
    background: none;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

/* ---------------------------------------------------------------------
   Custom title bar (src/torrent2000/ui/widgets/app_title_bar.py) sits
   directly above the tab widget in a frameless window -- the window frame
   that used to separate them is gone, so drop the pane's top border/radius
   to avoid a double line/gap directly under the caption.
   --------------------------------------------------------------------- */

QTabWidget#mainTabs::pane {
    border-top: none;
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
    top: 0px;
}

QSizeGrip {
    background-color: #ECEBF2;
    width: 16px;
    height: 16px;
}
