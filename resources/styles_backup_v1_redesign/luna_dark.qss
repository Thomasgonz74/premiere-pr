/* Torrent 2000 -- Windows XP "Luna Blue" skin, DARK variant.

   Real XP predates any system dark mode, so this is a reimagining: the
   exact same rounded-oval glossy control language as luna.qss (same
   button shapes, same gradient sheen, same king's-blue hot-track accent),
   recolored onto a dark graphite-pearl base. The window frame stays square
   (unchanged from light -- see window_corner_radius=0 for "luna_xp" in
   ui/theme/theme_manager.py); only the controls round their own corners.

   Design tokens (documented here, referenced by value throughout the file
   since Qt QSS has no variables):

     bg            #2C2E38   window / pane background -- dark graphite-
                              pearl with the same cool cast as the light
                              variant's bg, just inverted in lightness
     surface       #383B47   raised panel surface -- menus, dialogs, one
                              step lighter than bg (same relationship as
                              the light variant's surface-over-bg)
     border        #5B6178   steel-blue structural border, lightened from
                              the light variant's #8FA4C7 so it still reads
                              against a dark background
     text          #F0F1F5   primary window text -- near-white
     muted         #9498A8   secondary / disabled text, cool gray
     accent        #4C8CE0   Luna hot-track blue, brightened from the light
                              variant's #3169C6 for AA legibility on dark
                              surfaces while staying unmistakably "the same
                              blue family" as the (unchanged) title bar
     accent-hover  #7FB0F2   brighter glossy highlight blue for hover states
     danger        #E0574A   destructive-action red, brightened from the
                              light variant's #C0392B for dark-mode contrast

   The pale-yellow QToolTip (#FFFFE1) is kept identical to the light
   variant on purpose -- real Windows tooltips were always that same
   pale yellow regardless of any app-level color scheme, so preserving it
   here is the more authentic choice, not an oversight.

   The title bar itself (blue gradient caption + red close button) is NOT
   drawn by this stylesheet -- see src/torrent2000/ui/widgets/app_title_bar.py
*/

* {
    font-family: "Tahoma", "MS Shell Dlg 2", "Segoe UI", sans-serif;
    font-size: 8pt;
}

QMainWindow, QWidget#centralWidget {
    background-color: #2C2E38;
}

QWidget {
    background-color: #2C2E38;
    color: #F0F1F5;
}

/* ---------------------------------------------------------------------
   Tabs
   --------------------------------------------------------------------- */

QTabWidget::pane {
    border: 1px solid #5B6178;
    border-radius: 6px;
    background-color: #2C2E38;
    top: -1px;
}

QTabBar::tab {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #565A6C, stop:0.5 #454858, stop:1 #333642);
    border: 1px solid #5B6178;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 5px 16px;
    margin-right: 2px;
    color: #D4D7E0;
}

QTabBar::tab:selected {
    background-color: #2C2E38;
    border-color: #5B6178;
    border-bottom: 1px solid #2C2E38;
    margin-top: 0px;
    color: #F0F1F5;
    font-weight: bold;
}

QTabBar::tab:!selected {
    margin-top: 3px;
}

QTabBar::tab:hover:!selected {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #6B7086, stop:0.5 #545974, stop:1 #3E4358);
    color: #F0F1F5;
}

QTabBar::tab:focus {
    border: 2px solid #4C8CE0;
    padding: 4px 15px;
}

/* ---------------------------------------------------------------------
   Group boxes
   --------------------------------------------------------------------- */

QGroupBox {
    border: 1px solid #5B6178;
    border-radius: 6px;
    margin-top: 12px;
    padding-top: 8px;
    background-color: #2C2E38;
    font-weight: bold;
    color: #F0F1F5;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 5px;
    color: #7FB0F2;
}

/* ---------------------------------------------------------------------
   Buttons
   --------------------------------------------------------------------- */

QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #6B6F82, stop:0.45 #4B4F60, stop:0.5 #3E4150, stop:1 #2C2E38);
    border: 1px solid #5B6178;
    border-radius: 9px;
    padding: 5px 16px;
    min-height: 20px;
    color: #F0F1F5;
}

QPushButton:hover:!pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #7C8196, stop:0.45 #59607A, stop:0.5 #454C66, stop:1 #333A50);
    border: 1px solid #7FB0F2;
}

QPushButton:focus {
    border: 2px solid #4C8CE0;
    padding: 4px 15px;
}

QPushButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #1E2029, stop:0.5 #2C2F3D, stop:1 #454A5F);
    border: 1px solid #7FB0F2;
    padding: 6px 15px 4px 17px;
}

QPushButton:default {
    border: 2px solid #4C8CE0;
    padding: 4px 15px;
}

QPushButton:default:pressed {
    padding: 5px 14px 3px 16px;
}

QPushButton:disabled {
    background: #2C2E38;
    border: 1px solid #454858;
    color: #6A6E7D;
}

QPushButton#dangerButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #8A5049, stop:0.45 #6B3630, stop:0.5 #5A2C26, stop:1 #401E19);
    border: 1px solid #8A4A42;
    border-radius: 9px;
    padding: 3px 14px;
    min-height: 18px;
    color: #FBE0DC;
}

QPushButton#dangerButton:hover:!pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #A5675E, stop:0.45 #824A42, stop:0.5 #6D3830, stop:1 #4E2620);
    border: 1px solid #7FB0F2;
}

QPushButton#dangerButton:focus {
    border: 2px solid #4C8CE0;
    padding: 2px 13px;
}

QPushButton#dangerButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #33150F, stop:0.5 #4A231F, stop:1 #6B3630);
    border: 1px solid #7FB0F2;
    padding: 4px 13px 2px 15px;
}

/* ---------------------------------------------------------------------
   Inputs
   --------------------------------------------------------------------- */

QLineEdit, QSpinBox, QAbstractSpinBox {
    background-color: #1E2028;
    border: 1px solid #5B6178;
    border-radius: 5px;
    padding: 4px 8px;
    color: #F0F1F5;
    selection-background-color: #4C8CE0;
    selection-color: #FFFFFF;
}

QLineEdit:hover, QSpinBox:hover, QAbstractSpinBox:hover {
    border: 1px solid #4C8CE0;
}

QLineEdit:focus, QSpinBox:focus, QAbstractSpinBox:focus {
    border: 2px solid #4C8CE0;
    padding: 3px 7px;
}

QLineEdit:disabled, QSpinBox:disabled, QAbstractSpinBox:disabled {
    background-color: #2C2E38;
    border: 1px solid #454858;
    color: #6A6E7D;
}

QAbstractSpinBox::up-button, QAbstractSpinBox::down-button {
    subcontrol-origin: border;
    width: 16px;
    background-color: #383B47;
    border-left: 1px solid #5B6178;
}

QAbstractSpinBox::up-button {
    subcontrol-position: top right;
    border-top-right-radius: 5px;
}

QAbstractSpinBox::down-button {
    subcontrol-position: bottom right;
    border-bottom-right-radius: 5px;
}

QAbstractSpinBox::up-button:hover, QAbstractSpinBox::down-button:hover {
    background-color: #454A5F;
}

QAbstractSpinBox::up-arrow {
    width: 0;
    height: 0;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-bottom: 4px solid #7FB0F2;
}

QAbstractSpinBox::down-arrow {
    width: 0;
    height: 0;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-top: 4px solid #7FB0F2;
}

QComboBox {
    background-color: #1E2028;
    border: 1px solid #5B6178;
    border-radius: 5px;
    padding: 4px 8px;
    min-height: 20px;
    color: #F0F1F5;
}

QComboBox:hover {
    border: 1px solid #4C8CE0;
}

QComboBox:focus {
    border: 2px solid #4C8CE0;
    padding: 3px 7px;
}

QComboBox:disabled {
    background-color: #2C2E38;
    border: 1px solid #454858;
    color: #6A6E7D;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: right;
    width: 20px;
    border-left: 1px solid #5B6178;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #6B6F82, stop:0.5 #454858, stop:1 #2C2E38);
}

QComboBox::drop-down:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #7C8196, stop:0.5 #545974, stop:1 #383D52);
}

QComboBox::down-arrow {
    width: 0;
    height: 0;
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #7FB0F2;
}

QComboBox::down-arrow:disabled {
    border-top-color: #6A6E7D;
}

QComboBox QAbstractItemView {
    background-color: #1E2028;
    color: #F0F1F5;
    border: 1px solid #4C8CE0;
    border-radius: 4px;
    outline: none;
    padding: 2px;
    selection-background-color: #4C8CE0;
    selection-color: #FFFFFF;
}

/* ---------------------------------------------------------------------
   Checkboxes
   --------------------------------------------------------------------- */

QCheckBox {
    spacing: 6px;
    color: #F0F1F5;
}

QCheckBox::indicator {
    width: 13px;
    height: 13px;
    border-radius: 3px;
    background-color: #1E2028;
    border: 1px solid #5B6178;
}

QCheckBox::indicator:hover {
    border: 1px solid #4C8CE0;
}

QCheckBox::indicator:focus {
    border: 2px solid #4C8CE0;
}

QCheckBox::indicator:checked {
    background-color: #33475E;
    border: 1px solid #4C8CE0;
    image: url(theme:checkmark.png);
}

QCheckBox::indicator:disabled {
    background-color: #2C2E38;
    border: 1px solid #454858;
}

QCheckBox:disabled {
    color: #6A6E7D;
}

/* ---------------------------------------------------------------------
   Sliders
   --------------------------------------------------------------------- */

QSlider::groove:horizontal {
    height: 5px;
    border-radius: 2px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #22242C, stop:1 #454858);
    border: 1px solid #5B6178;
}

QSlider::handle:horizontal {
    width: 15px;
    height: 15px;
    margin: -6px 0;
    border-radius: 7px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #7FB0F2, stop:0.5 #4C8CE0, stop:1 #2E5FA3);
    border: 1px solid #7FB0F2;
}

QSlider::handle:horizontal:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #A3C8F7, stop:0.5 #6FA3EC, stop:1 #4172B8);
}

QSlider::handle:horizontal:focus {
    border: 2px solid #FFFFFF;
    margin: -7px -1px;
}

QSlider::handle:horizontal:disabled {
    background: #454858;
    border: 1px solid #454858;
}

QSlider::sub-page:horizontal {
    background: #3D6FC2;
    border-radius: 2px;
}

/* ---------------------------------------------------------------------
   Tables / trees
   --------------------------------------------------------------------- */

QTableWidget, QTreeWidget {
    background-color: #1E2028;
    alternate-background-color: #262933;
    gridline-color: #383B47;
    border: 1px solid #5B6178;
    outline: none;
    color: #F0F1F5;
    selection-background-color: #4C8CE0;
    selection-color: #FFFFFF;
}

QTableWidget::item:hover, QTreeWidget::item:hover {
    background-color: #333A50;
}

QHeaderView::section {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #565A6C, stop:0.5 #454858, stop:1 #2C2E38);
    border: none;
    border-right: 1px solid #454858;
    border-bottom: 1px solid #5B6178;
    padding: 4px 6px;
    font-weight: bold;
    color: #F0F1F5;
}

QHeaderView::section:hover {
    background: #3E4356;
}

/* ---------------------------------------------------------------------
   List widget -- NEW
   --------------------------------------------------------------------- */

QListWidget {
    background-color: #1E2028;
    border: 1px solid #5B6178;
    border-radius: 4px;
    outline: none;
    padding: 2px;
    color: #F0F1F5;
    selection-background-color: #4C8CE0;
    selection-color: #FFFFFF;
}

QListWidget::item {
    padding: 3px 6px;
    border-radius: 3px;
    color: #F0F1F5;
}

QListWidget::item:hover {
    background-color: #333A50;
}

QListWidget::item:selected {
    background-color: #4C8CE0;
    color: #FFFFFF;
}

/* ---------------------------------------------------------------------
   Menus -- NEW
   --------------------------------------------------------------------- */

QMenu {
    background-color: #383B47;
    border: 1px solid #5B6178;
    border-radius: 6px;
    padding: 3px;
}

QMenu::item {
    background-color: transparent;
    padding: 5px 26px 5px 14px;
    margin: 1px 3px;
    border-radius: 4px;
    color: #F0F1F5;
}

QMenu::item:selected {
    background-color: #4C8CE0;
    color: #FFFFFF;
}

QMenu::item:disabled {
    color: #6A6E7D;
}

QMenu::separator {
    height: 1px;
    background-color: #4A4E5E;
    margin: 4px 8px;
}

/* ---------------------------------------------------------------------
   Dialogs -- NEW
   --------------------------------------------------------------------- */

QDialog {
    background-color: #2C2E38;
    color: #F0F1F5;
}

QProgressBar {
    border: 1px solid #5B6178;
    border-radius: 4px;
    background-color: #1E2028;
    text-align: center;
    color: #F0F1F5;
    min-height: 16px;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #7FB0F2, stop:0.5 #4C8CE0, stop:1 #2E5FA3);
    border-radius: 3px;
    margin: 1px;
}

QLabel {
    background: transparent;
    color: #F0F1F5;
}

QLabel:disabled {
    color: #6A6E7D;
}

QToolTip {
    background-color: #FFFFE1;
    border: 1px solid #000000;
    padding: 3px 6px;
    color: #000000;
}

QSplitter::handle {
    background-color: #2C2E38;
}

QSplitter::handle:hover {
    background-color: #333A50;
}

QScrollBar:vertical {
    background: #2C2E38;
    width: 17px;
    border-left: 1px solid #454858;
}

QScrollBar::handle:vertical {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #6B6F82, stop:0.5 #4B4F60, stop:1 #383B47);
    border: 1px solid #5B6178;
    border-radius: 4px;
    min-height: 24px;
    margin: 2px 3px;
}

QScrollBar::handle:vertical:hover {
    border: 1px solid #4C8CE0;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #7C8196, stop:0.5 #59607A, stop:1 #454C66);
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
    border: none;
    background: none;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background: #2C2E38;
    height: 17px;
    border-top: 1px solid #454858;
}

QScrollBar::handle:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #6B6F82, stop:0.5 #4B4F60, stop:1 #383B47);
    border: 1px solid #5B6178;
    border-radius: 4px;
    min-width: 24px;
    margin: 3px 2px;
}

QScrollBar::handle:horizontal:hover {
    border: 1px solid #4C8CE0;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #7C8196, stop:0.5 #59607A, stop:1 #454C66);
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
    border: none;
    background: none;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

/* ---------------------------------------------------------------------
   Custom title bar -- see luna.qss for rationale, identical here.
   --------------------------------------------------------------------- */

QTabWidget#mainTabs::pane {
    border-top: none;
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
    top: 0px;
}

QSizeGrip {
    background-color: #2C2E38;
    width: 16px;
    height: 16px;
}
