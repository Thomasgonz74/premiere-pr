/* =========================================================================
   Torrent 2000 -- "Windows 11" skin (Mica), DARK variant -- matches the
   real Windows 11 "Dark" app theme.

   Same rounded-everywhere, generously-spaced family as win11.qss, just
   re-layered onto Windows 11's dark Mica surfaces. The title bar is NOT
   drawn by this stylesheet -- see src/torrent2000/ui/widgets/app_title_bar.py
   (window backdrop already matches this file's --mica-bg at #202020).

   Token palette (name -> hex -> role):
     --mica-bg       #202020   app backdrop / window (dark Mica base layer)
     --mica-card     #2B2B2B   elevated "layer 2": group boxes, tab content,
                                menus, dialogs, tooltips
     --surface       #1F1F1F   recessed "well" surface: inputs, checkbox box
     --content       #262626   table / list content surface
     --border        #3A3A3A   hairline border on large neutral surfaces
     --border-strong #4A4A4A   functional border on small interactive controls
     --text          #FFFFFF   primary text
     --text-muted    #ABABAB   secondary text (unselected tabs, hints)
     --accent        #3FA0FF   accent blue lightened from #0067C0 for
                                contrast against the dark background
     --accent-soft   #16324A   subtle accent "wash" fill used for hover
     --danger        #FF6B5E   destructive coral-red, lightened for
                                legibility against the dark background

   Shape language matches the light variant 1:1 -- 8px on primary controls,
   10px on card surfaces (menus/dialogs/lists), 5px on the checkbox box.
   ========================================================================= */

* {
    font-family: "Segoe UI Variable", "Segoe UI", "MS Shell Dlg 2", sans-serif;
    font-size: 9pt;
}

QMainWindow, QWidget#centralWidget {
    background-color: #202020;
}

QWidget {
    background-color: #202020;
    color: #FFFFFF;
}

/* ---------------------------------------------------------------------
   Tabs
   --------------------------------------------------------------------- */

QTabWidget::pane {
    border: 1px solid #3A3A3A;
    border-radius: 8px;
    background-color: #2B2B2B;
    top: -1px;
    padding: 6px;
}

QTabBar::tab {
    background-color: #262626;
    border: 1px solid #3A3A3A;
    border-bottom: none;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    padding: 8px 20px;
    margin-right: 3px;
    color: #ABABAB;
}

QTabBar::tab:selected {
    background-color: #2B2B2B;
    border-color: #3A3A3A;
    border-bottom: 3px solid #3FA0FF;
    color: #FFFFFF;
    margin-top: 0px;
    padding-bottom: 5px;
}

QTabBar::tab:!selected {
    margin-top: 3px;
}

QTabBar::tab:hover:!selected {
    background-color: #16324A;
    color: #FFFFFF;
}

QTabBar::tab:focus {
    border-width: 2px;
    border-color: #3FA0FF;
}

/* ---------------------------------------------------------------------
   Group boxes
   --------------------------------------------------------------------- */

QGroupBox {
    border: 1px solid #3A3A3A;
    border-radius: 10px;
    margin-top: 12px;
    padding-top: 10px;
    background-color: #2B2B2B;
    font-weight: 600;
    color: #FFFFFF;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    color: #FFFFFF;
}

/* ---------------------------------------------------------------------
   Buttons
   --------------------------------------------------------------------- */

QPushButton {
    background-color: #2B2B2B;
    border: 1px solid #4A4A4A;
    border-radius: 8px;
    padding: 7px 20px;
    min-height: 20px;
    color: #FFFFFF;
}

QPushButton:hover:!pressed {
    background-color: #16324A;
    border: 1px solid #4F86B8;
}

QPushButton:pressed {
    background-color: #0D4570;
    border: 1px solid #3FA0FF;
}

QPushButton:default {
    background-color: #3FA0FF;
    border: 1px solid #3FA0FF;
    color: #0A0A0A;
}

QPushButton:default:hover:!pressed {
    background-color: #63B2FF;
    border: 1px solid #63B2FF;
}

QPushButton:default:pressed {
    background-color: #1975C9;
    border: 1px solid #1975C9;
}

QPushButton:focus {
    border-width: 2px;
    border-color: #3FA0FF;
}

QPushButton:disabled {
    background-color: #202020;
    border: 1px solid #3A3A3A;
    color: #6B6B6B;
}

/* Destructive actions -- lightened coral-red for dark-bg legibility, red
   at rest, deepens on hover/press; the keyboard focus ring stays the
   theme's normal accent blue so focus is never confused with hover. */
QPushButton#dangerButton {
    background-color: #3A2220;
    border: 1px solid #8A4A42;
    border-radius: 8px;
    padding: 5px 16px;
    min-height: 18px;
    color: #FF9186;
}

QPushButton#dangerButton:hover:!pressed {
    background-color: #4E2C28;
    border: 1px solid #FF6B5E;
    color: #FFB0A8;
}

QPushButton#dangerButton:pressed {
    background-color: #FF6B5E;
    border: 1px solid #FF9186;
    color: #2A0A06;
}

QPushButton#dangerButton:focus {
    border-width: 2px;
    border-color: #3FA0FF;
}

QPushButton#dangerButton:disabled {
    background-color: #202020;
    border: 1px solid #3A3A3A;
    color: #6B6B6B;
}

/* ---------------------------------------------------------------------
   Inputs -- recessed "well" surface, darker than the card layers around
   them (matches real Fluent dark-mode text fields).
   --------------------------------------------------------------------- */

QLineEdit, QSpinBox, QAbstractSpinBox {
    background-color: #1F1F1F;
    border: 1px solid #4A4A4A;
    border-radius: 8px;
    padding: 5px 10px;
    color: #FFFFFF;
    selection-background-color: #3FA0FF;
    selection-color: #0A0A0A;
}

QLineEdit:hover, QSpinBox:hover, QAbstractSpinBox:hover {
    border: 1px solid #6E9AC2;
}

QLineEdit:focus, QSpinBox:focus, QAbstractSpinBox:focus {
    border-width: 2px;
    border-color: #3FA0FF;
    padding: 4px 9px;
}

QLineEdit:disabled, QSpinBox:disabled, QAbstractSpinBox:disabled {
    background-color: #202020;
    border: 1px solid #3A3A3A;
    color: #6B6B6B;
}

QComboBox {
    background-color: #1F1F1F;
    border: 1px solid #4A4A4A;
    border-radius: 8px;
    padding: 5px 10px;
    min-height: 20px;
    color: #FFFFFF;
}

QComboBox:hover {
    border: 1px solid #6E9AC2;
}

QComboBox:focus {
    border-width: 2px;
    border-color: #3FA0FF;
    padding: 4px 9px;
}

QComboBox:disabled {
    background-color: #202020;
    border: 1px solid #3A3A3A;
    color: #6B6B6B;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: right;
    width: 26px;
    background-color: transparent;
    border: none;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
}

QComboBox::down-arrow {
    width: 8px;
    height: 8px;
    image: none;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-top: 4px solid #FFFFFF;
}

QComboBox::down-arrow:disabled {
    border-top: 4px solid #6B6B6B;
}

QComboBox QAbstractItemView {
    background-color: #262626;
    color: #FFFFFF;
    border: 1px solid #4A4A4A;
    border-radius: 10px;
    padding: 4px;
    outline: none;
    selection-background-color: #3FA0FF;
    selection-color: #0A0A0A;
}

/* ---------------------------------------------------------------------
   Checkboxes
   --------------------------------------------------------------------- */

QCheckBox {
    spacing: 8px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    background-color: #1F1F1F;
    border: 1px solid #4A4A4A;
    border-radius: 5px;
}

QCheckBox::indicator:hover {
    border: 1px solid #3FA0FF;
}

QCheckBox::indicator:checked {
    background-color: #3FA0FF;
    border: 1px solid #3FA0FF;
    image: url(theme:checkmark.png);
}

QCheckBox::indicator:checked:hover {
    background-color: #63B2FF;
    border: 1px solid #63B2FF;
}

QCheckBox::indicator:focus {
    border-width: 2px;
    border-color: #3FA0FF;
}

QCheckBox::indicator:disabled {
    background-color: #202020;
    border: 1px solid #3A3A3A;
}

QCheckBox::indicator:checked:disabled {
    background-color: #4A4A4A;
    border: 1px solid #4A4A4A;
}

QCheckBox:disabled {
    color: #6B6B6B;
}

/* ---------------------------------------------------------------------
   Sliders
   --------------------------------------------------------------------- */

QSlider::groove:horizontal {
    height: 4px;
    background-color: #4A4A4A;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    width: 16px;
    height: 16px;
    margin: -6px 0;
    background-color: #3FA0FF;
    border: 1px solid #1975C9;
    border-radius: 8px;
}

QSlider::handle:horizontal:hover {
    background-color: #63B2FF;
}

QSlider::handle:horizontal:focus {
    border-width: 2px;
    border-color: #3FA0FF;
}

QSlider::handle:horizontal:disabled {
    background-color: #3A3A3A;
    border: 1px solid #4A4A4A;
}

/* ---------------------------------------------------------------------
   Tables / trees / lists
   --------------------------------------------------------------------- */

QTableWidget, QTreeWidget {
    background-color: #262626;
    alternate-background-color: #212429;
    gridline-color: #3A3A3A;
    border: 1px solid #3A3A3A;
    border-radius: 10px;
    color: #FFFFFF;
    selection-background-color: #3FA0FF;
    selection-color: #0A0A0A;
}

QTableWidget::item, QTreeWidget::item {
    padding: 3px;
}

QTableWidget::item:hover, QTreeWidget::item:hover {
    background-color: #16324A;
}

QTableWidget::item:selected, QTreeWidget::item:selected {
    background-color: #3FA0FF;
    color: #0A0A0A;
}

QHeaderView::section {
    background-color: #2B2B2B;
    border: none;
    border-right: 1px solid #3A3A3A;
    border-bottom: 1px solid #3A3A3A;
    padding: 6px 8px;
    font-weight: 600;
    color: #FFFFFF;
}

QListWidget {
    background-color: #262626;
    border: 1px solid #3A3A3A;
    border-radius: 10px;
    padding: 4px;
    outline: none;
    color: #FFFFFF;
    selection-background-color: #3FA0FF;
    selection-color: #0A0A0A;
}

QListWidget::item {
    padding: 6px 10px;
    border-radius: 6px;
    color: #FFFFFF;
    margin: 1px 2px;
}

QListWidget::item:hover {
    background-color: #16324A;
}

QListWidget::item:selected {
    background-color: #3FA0FF;
    color: #0A0A0A;
}

/* ---------------------------------------------------------------------
   Context menus -- previously absent from this theme entirely, falling
   back to native Windows chrome and breaking the dark-Mica illusion.
   --------------------------------------------------------------------- */

QMenu {
    background-color: #2B2B2B;
    border: 1px solid #4A4A4A;
    border-radius: 10px;
    padding: 6px;
}

QMenu::item {
    background-color: transparent;
    padding: 7px 16px;
    border-radius: 6px;
    margin: 1px 4px;
    color: #FFFFFF;
}

QMenu::item:selected {
    background-color: #3FA0FF;
    color: #0A0A0A;
}

QMenu::item:disabled {
    color: #6B6B6B;
    background-color: transparent;
}

QMenu::separator {
    height: 1px;
    background-color: #3A3A3A;
    margin: 6px 10px;
}

/* ---------------------------------------------------------------------
   Dialogs
   --------------------------------------------------------------------- */

QDialog {
    background-color: #202020;
    color: #FFFFFF;
}

QProgressBar {
    border: 1px solid #3A3A3A;
    border-radius: 8px;
    background-color: #2B2B2B;
    text-align: center;
    color: #FFFFFF;
    min-height: 16px;
}

QProgressBar::chunk {
    background-color: #3FA0FF;
    border-radius: 7px;
    margin: 1px;
}

QLabel {
    background: transparent;
    color: #FFFFFF;
}

QSplitter::handle {
    background-color: #202020;
}

QScrollBar:vertical {
    background: #202020;
    width: 14px;
    border: none;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background-color: #4A4A4A;
    border-radius: 6px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background-color: #6E6E6E;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background: #202020;
    height: 14px;
    border: none;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background-color: #4A4A4A;
    border-radius: 6px;
    min-width: 28px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #6E6E6E;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* ---------------------------------------------------------------------
   Custom title bar sits directly above the tab widget in a frameless
   window -- drop the pane's top border to avoid a double line/gap.
   --------------------------------------------------------------------- */

QTabWidget#mainTabs::pane {
    border-top: none;
    top: 0px;
}

/* ---------------------------------------------------------------------
   Tooltips
   --------------------------------------------------------------------- */

QToolTip {
    background-color: #2B2B2B;
    color: #FFFFFF;
    border: 1px solid #4A4A4A;
    border-radius: 8px;
    padding: 5px 10px;
}

QSizeGrip {
    background-color: #202020;
    width: 16px;
    height: 16px;
}
