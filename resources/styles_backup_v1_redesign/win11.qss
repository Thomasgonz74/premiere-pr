/* =========================================================================
   Torrent 2000 -- "Windows 11" skin (Mica), LIGHT variant.

   Reference: Windows 11's Fluent 2 / "Mica" desktop look -- soft warm-neutral
   layered surfaces (no stark white panels), fully rounded geometry on every
   control, a calmer/softer accent blue than Windows 10's, and noticeably
   more breathing room than Win10's tighter Fluent 1 density. The custom
   title bar is NOT drawn by this stylesheet -- see
   src/torrent2000/ui/widgets/app_title_bar.py (window backdrop already
   matches this file's --mica-bg at #F3F3F3).

   Token palette (name -> hex -> role):
     --mica-bg       #F3F3F3   app backdrop / window (Mica base layer)
     --mica-card     #FBFBFB   elevated "layer 2": group boxes, tab content,
                                menus, dialogs, tooltips
     --surface       #FFFFFF   "layer 3", brightest: inputs, tables, lists
     --border        #E3E3E3   hairline border on large neutral surfaces
     --border-strong #C9C9C9   functional border on small interactive controls
     --text          #1A1A1A   primary text
     --text-muted    #6B6B6B   secondary text (unselected tabs, hints)
     --accent        #0067C0   Windows 11 accent blue (one notch softer/more
                                desaturated than Win10's #0078D7)
     --accent-soft   #E8F1FB   subtle accent "wash" fill used for hover
     --danger        #C42B1C   Fluent's real destructive red (Win11 Settings
                                "Reset"/"Remove" tone)

   Shape language: window_corner_radius is 8px for this theme (see
   theme_manager.py TITLE_BAR_STYLES["win11_mica"]) -- every control below
   mirrors that with 8px on primary controls, up to 10px on larger "card"
   surfaces (menus/dialogs/lists), and a small 5px on the tiny checkbox
   box. Nothing in this theme is square.
   ========================================================================= */

* {
    font-family: "Segoe UI Variable", "Segoe UI", "MS Shell Dlg 2", sans-serif;
    font-size: 9pt;
}

QMainWindow, QWidget#centralWidget {
    background-color: #F3F3F3;
}

QWidget {
    background-color: #F3F3F3;
    color: #1A1A1A;
}

/* ---------------------------------------------------------------------
   Tabs -- generously rounded top corners, calm flat fill, thick accent
   underline on the selected tab.
   --------------------------------------------------------------------- */

QTabWidget::pane {
    border: 1px solid #E3E3E3;
    border-radius: 8px;
    background-color: #FBFBFB;
    top: -1px;
    padding: 6px;
}

QTabBar::tab {
    background-color: #E9E9E9;
    border: 1px solid #E3E3E3;
    border-bottom: none;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    padding: 8px 20px;
    margin-right: 3px;
    color: #6B6B6B;
}

QTabBar::tab:selected {
    background-color: #FBFBFB;
    border-color: #E3E3E3;
    border-bottom: 3px solid #0067C0;
    color: #1A1A1A;
    margin-top: 0px;
    padding-bottom: 5px;
}

QTabBar::tab:!selected {
    margin-top: 3px;
}

QTabBar::tab:hover:!selected {
    background-color: #E8F1FB;
    color: #1A1A1A;
}

QTabBar::tab:focus {
    border-width: 2px;
    border-color: #0067C0;
}

/* ---------------------------------------------------------------------
   Group boxes -- rounded card surface, plain title.
   --------------------------------------------------------------------- */

QGroupBox {
    border: 1px solid #E3E3E3;
    border-radius: 10px;
    margin-top: 12px;
    padding-top: 10px;
    background-color: #FBFBFB;
    font-weight: 600;
    color: #1A1A1A;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    color: #1A1A1A;
}

/* ---------------------------------------------------------------------
   Buttons -- flat fill, fully rounded (Fluent 2), generous padding, soft
   accent-tint wash on hover, deeper wash + border on press. Focus and
   hover are always visually distinct from each other.
   --------------------------------------------------------------------- */

QPushButton {
    background-color: #FBFBFB;
    border: 1px solid #C9C9C9;
    border-radius: 8px;
    padding: 7px 20px;
    min-height: 20px;
    color: #1A1A1A;
}

QPushButton:hover:!pressed {
    background-color: #E8F1FB;
    border: 1px solid #A9CDEE;
}

QPushButton:pressed {
    background-color: #D3E6F8;
    border: 1px solid #0067C0;
}

QPushButton:default {
    background-color: #0067C0;
    border: 1px solid #0067C0;
    color: #FFFFFF;
}

QPushButton:default:hover:!pressed {
    background-color: #1975C9;
    border: 1px solid #1975C9;
}

QPushButton:default:pressed {
    background-color: #004C8C;
    border: 1px solid #004C8C;
}

QPushButton:focus {
    border-width: 2px;
    border-color: #0067C0;
}

QPushButton:disabled {
    background-color: #F3F3F3;
    border: 1px solid #E3E3E3;
    color: #A0A0A0;
}

/* Destructive actions -- red at rest (always legible as "dangerous"),
   deepens on hover/press; the keyboard focus ring stays the theme's
   normal accent blue so focus is never confused with a hover state. */
QPushButton#dangerButton {
    background-color: #FDECEA;
    border: 1px solid #E3A29A;
    border-radius: 8px;
    padding: 5px 16px;
    min-height: 18px;
    color: #A42317;
}

QPushButton#dangerButton:hover:!pressed {
    background-color: #F8D3CE;
    border: 1px solid #C42B1C;
    color: #A42317;
}

QPushButton#dangerButton:pressed {
    background-color: #C42B1C;
    border: 1px solid #A42317;
    color: #FFFFFF;
}

QPushButton#dangerButton:focus {
    border-width: 2px;
    border-color: #0067C0;
}

QPushButton#dangerButton:disabled {
    background-color: #F3F3F3;
    border: 1px solid #E3E3E3;
    color: #A0A0A0;
}

/* ---------------------------------------------------------------------
   Inputs -- rounded white "layer 3" boxes, thin gray border, thicker
   accent-blue border on focus.
   --------------------------------------------------------------------- */

QLineEdit, QSpinBox, QAbstractSpinBox {
    background-color: #FFFFFF;
    border: 1px solid #C9C9C9;
    border-radius: 8px;
    padding: 5px 10px;
    selection-background-color: #0067C0;
    selection-color: #FFFFFF;
}

QLineEdit:hover, QSpinBox:hover, QAbstractSpinBox:hover {
    border: 1px solid #8AA9C7;
}

QLineEdit:focus, QSpinBox:focus, QAbstractSpinBox:focus {
    border-width: 2px;
    border-color: #0067C0;
    padding: 4px 9px;
}

QLineEdit:disabled, QSpinBox:disabled, QAbstractSpinBox:disabled {
    background-color: #F3F3F3;
    border: 1px solid #E3E3E3;
    color: #A0A0A0;
}

QComboBox {
    background-color: #FFFFFF;
    border: 1px solid #C9C9C9;
    border-radius: 8px;
    padding: 5px 10px;
    min-height: 20px;
}

QComboBox:hover {
    border: 1px solid #8AA9C7;
}

QComboBox:focus {
    border-width: 2px;
    border-color: #0067C0;
    padding: 4px 9px;
}

QComboBox:disabled {
    background-color: #F3F3F3;
    border: 1px solid #E3E3E3;
    color: #A0A0A0;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: right;
    width: 26px;
    background-color: transparent;
    border: none;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
}

QComboBox::down-arrow {
    width: 8px;
    height: 8px;
    image: none;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-top: 4px solid #1A1A1A;
}

QComboBox::down-arrow:disabled {
    border-top: 4px solid #A0A0A0;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #C9C9C9;
    border-radius: 10px;
    padding: 4px;
    outline: none;
    selection-background-color: #0067C0;
    selection-color: #FFFFFF;
}

/* ---------------------------------------------------------------------
   Checkboxes -- small rounded box, accent-blue check fill.
   --------------------------------------------------------------------- */

QCheckBox {
    spacing: 8px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    background-color: #FFFFFF;
    border: 1px solid #C9C9C9;
    border-radius: 5px;
}

QCheckBox::indicator:hover {
    border: 1px solid #0067C0;
}

QCheckBox::indicator:checked {
    background-color: #0067C0;
    border: 1px solid #0067C0;
    image: url(theme:checkmark.png);
}

QCheckBox::indicator:checked:hover {
    background-color: #1975C9;
    border: 1px solid #1975C9;
}

QCheckBox::indicator:focus {
    border-width: 2px;
    border-color: #0067C0;
}

QCheckBox::indicator:disabled {
    background-color: #F3F3F3;
    border: 1px solid #E3E3E3;
}

QCheckBox::indicator:checked:disabled {
    background-color: #C9C9C9;
    border: 1px solid #C9C9C9;
}

QCheckBox:disabled {
    color: #A0A0A0;
}

/* ---------------------------------------------------------------------
   Sliders -- thin flat groove, round accent handle.
   --------------------------------------------------------------------- */

QSlider::groove:horizontal {
    height: 4px;
    background-color: #D6D6D6;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    width: 16px;
    height: 16px;
    margin: -6px 0;
    background-color: #0067C0;
    border: 1px solid #004C8C;
    border-radius: 8px;
}

QSlider::handle:horizontal:hover {
    background-color: #1975C9;
}

QSlider::handle:horizontal:focus {
    border-width: 2px;
    border-color: #0067C0;
}

QSlider::handle:horizontal:disabled {
    background-color: #E0E0E0;
    border: 1px solid #C9C9C9;
}

/* ---------------------------------------------------------------------
   Tables / trees / lists -- bright "layer 3" surface, rounded card
   border, accent selection.
   --------------------------------------------------------------------- */

QTableWidget, QTreeWidget {
    background-color: #FFFFFF;
    alternate-background-color: #F5F8FC;
    gridline-color: #EAEAEA;
    border: 1px solid #E3E3E3;
    border-radius: 10px;
    selection-background-color: #0067C0;
    selection-color: #FFFFFF;
}

QTableWidget::item, QTreeWidget::item {
    padding: 3px;
}

QTableWidget::item:hover, QTreeWidget::item:hover {
    background-color: #E8F1FB;
}

QTableWidget::item:selected, QTreeWidget::item:selected {
    background-color: #0067C0;
    color: #FFFFFF;
}

QHeaderView::section {
    background-color: #E9E9E9;
    border: none;
    border-right: 1px solid #E3E3E3;
    border-bottom: 1px solid #E3E3E3;
    padding: 6px 8px;
    font-weight: 600;
    color: #1A1A1A;
}

QListWidget {
    background-color: #FFFFFF;
    border: 1px solid #E3E3E3;
    border-radius: 10px;
    padding: 4px;
    outline: none;
    selection-background-color: #0067C0;
    selection-color: #FFFFFF;
}

QListWidget::item {
    padding: 6px 10px;
    border-radius: 6px;
    color: #1A1A1A;
    margin: 1px 2px;
}

QListWidget::item:hover {
    background-color: #E8F1FB;
}

QListWidget::item:selected {
    background-color: #0067C0;
    color: #FFFFFF;
}

/* ---------------------------------------------------------------------
   Context menus -- rounded flyout card, inset rounded item highlight
   (matches Windows 11's floating context-menu look). Previously absent
   from this theme entirely, falling back to native Windows chrome.
   --------------------------------------------------------------------- */

QMenu {
    background-color: #FBFBFB;
    border: 1px solid #D6D6D6;
    border-radius: 10px;
    padding: 6px;
}

QMenu::item {
    background-color: transparent;
    padding: 7px 16px;
    border-radius: 6px;
    margin: 1px 4px;
    color: #1A1A1A;
}

QMenu::item:selected {
    background-color: #0067C0;
    color: #FFFFFF;
}

QMenu::item:disabled {
    color: #A0A0A0;
    background-color: transparent;
}

QMenu::separator {
    height: 1px;
    background-color: #E3E3E3;
    margin: 6px 10px;
}

/* ---------------------------------------------------------------------
   Dialogs -- same neutral backdrop and text color as the rest of the
   theme so torrent-creation / edit / profile dialogs stay in character
   instead of falling back to native Windows chrome.
   --------------------------------------------------------------------- */

QDialog {
    background-color: #F3F3F3;
    color: #1A1A1A;
}

QProgressBar {
    border: 1px solid #E3E3E3;
    border-radius: 8px;
    background-color: #E9E9E9;
    text-align: center;
    color: #1A1A1A;
    min-height: 16px;
}

QProgressBar::chunk {
    background-color: #0067C0;
    border-radius: 7px;
    margin: 1px;
}

QLabel {
    background: transparent;
}

QSplitter::handle {
    background-color: #F3F3F3;
}

QScrollBar:vertical {
    background: #F3F3F3;
    width: 14px;
    border: none;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background-color: #C1C1C1;
    border-radius: 6px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background-color: #8A8A8A;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background: #F3F3F3;
    height: 14px;
    border: none;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background-color: #C1C1C1;
    border-radius: 6px;
    min-width: 28px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #8A8A8A;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* ---------------------------------------------------------------------
   Custom title bar sits directly above the tab widget in a frameless
   window -- drop the pane's top border to avoid a double line/gap.
   --------------------------------------------------------------------- */

QTabWidget#mainTabs::pane {
    border-top: none;
    top: 0px;
}

/* ---------------------------------------------------------------------
   Tooltips -- rounded card surface, matches menu/dialog treatment.
   --------------------------------------------------------------------- */

QToolTip {
    background-color: #FBFBFB;
    color: #1A1A1A;
    border: 1px solid #C9C9C9;
    border-radius: 8px;
    padding: 5px 10px;
}

QSizeGrip {
    background-color: #F3F3F3;
    width: 16px;
    height: 16px;
}
