/* Torrent 2000 -- "Windows 10" skin.

   Reference colors:
     window background     #FFFFFF
     accent blue            #0078D7  (Win10's signature accent)
     border gray            #8A8A8A
     text                   #000000
     disabled text          #A0A0A0

   Fully flat design -- no gradients, no 3D bevels, sharp corners
   everywhere (the sharp-vs-rounded corner contrast is what visually tells
   this theme apart from the Windows 11 one). The title bar is NOT drawn
   by this stylesheet -- see src/torrent2000/ui/widgets/app_title_bar.py.
*/
/* + focus/hover/disabled/tab-hover/scrollbar/tooltip polish pass */

* {
    font-family: "Segoe UI", "MS Shell Dlg 2", sans-serif;
    font-size: 9pt;
}

QMainWindow, QWidget#centralWidget {
    background-color: #FFFFFF;
}

QWidget {
    background-color: #FFFFFF;
    color: #000000;
}

/* ---------------------------------------------------------------------
   Tabs -- flat, minimal; the selected tab is marked with a thin accent
   underline rather than a raised 3D look, matching Fluent Design.
   --------------------------------------------------------------------- */

QTabWidget::pane {
    border: 1px solid #D6D6D6;
    background-color: #FFFFFF;
    top: -1px;
}

QTabBar::tab {
    background-color: #F3F3F3;
    border: 1px solid #D6D6D6;
    border-bottom: none;
    padding: 6px 16px;
    margin-right: 1px;
    color: #000000;
}

QTabBar::tab:selected {
    background-color: #FFFFFF;
    border-color: #D6D6D6;
    border-bottom: 2px solid #0078D7;
    margin-top: 0px;
}

QTabBar::tab:!selected {
    margin-top: 2px;
    color: #4A4A4A;
}

QTabBar::tab:hover:!selected {
    background-color: #E8E8E8;
    color: #000000;
}

QTabBar::tab:focus {
    outline: 2px solid #0078D7;
    outline-offset: -3px;
}

/* ---------------------------------------------------------------------
   Group boxes -- thin flat border, plain title, no rounding.
   --------------------------------------------------------------------- */

QGroupBox {
    border: 1px solid #D6D6D6;
    border-radius: 0px;
    margin-top: 10px;
    padding-top: 6px;
    background-color: #FFFFFF;
    font-weight: normal;
    color: #000000;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #000000;
}

/* ---------------------------------------------------------------------
   Buttons -- flat rectangle, thin border, accent-blue highlight on
   hover/press. No gradients, no bevel, sharp corners.
   --------------------------------------------------------------------- */

QPushButton {
    background-color: #E1E1E1;
    border: 1px solid #ADADAD;
    border-radius: 0px;
    padding: 4px 12px;
    min-height: 18px;
    color: #000000;
}

QPushButton:hover:!pressed {
    background-color: #E5F1FB;
    border: 1px solid #0078D7;
}

QPushButton:pressed {
    background-color: #CCE4F7;
    border: 1px solid #005A9E;
}

QPushButton:focus {
    outline: 2px solid #0078D7;
    outline-offset: 1px;
}

QPushButton:default {
    border-width: 2px;
    border-color: #0078D7;
}

QPushButton:disabled {
    background-color: #F3F3F3;
    border: 1px solid #D6D6D6;
    color: #A0A0A0;
}

/* Secondary destructive actions -- flat button, muted red tint, roughly
   half the strength of the title bar's close-hover red. */
QPushButton#dangerButton {
    background-color: #F5C6C0;
    border: 1px solid #C97F78;
    border-radius: 0px;
    padding: 2px 10px;
    min-height: 16px;
    color: #000000;
}

QPushButton#dangerButton:hover:!pressed {
    background-color: #F9DAD6;
    border: 1px solid #0078D7;
}

QPushButton#dangerButton:pressed {
    background-color: #E5A29B;
    border: 1px solid #8A3A34;
}

QPushButton#dangerButton:focus {
    outline: 2px solid #0078D7;
    outline-offset: 1px;
}

/* ---------------------------------------------------------------------
   Inputs -- flat white boxes, thin gray border, accent-blue on focus.
   --------------------------------------------------------------------- */

QLineEdit, QSpinBox, QAbstractSpinBox {
    background-color: #FFFFFF;
    border: 1px solid #8A8A8A;
    border-radius: 0px;
    padding: 2px 4px;
    selection-background-color: #0078D7;
    selection-color: #FFFFFF;
}

QLineEdit:hover, QSpinBox:hover, QAbstractSpinBox:hover {
    border: 1px solid #0078D7;
}

QLineEdit:focus, QSpinBox:focus, QAbstractSpinBox:focus {
    border: 1px solid #0078D7;
    outline: 2px solid #0078D7;
    outline-offset: 1px;
}

QComboBox {
    background-color: #FFFFFF;
    border: 1px solid #8A8A8A;
    border-radius: 0px;
    padding: 2px 4px;
}

QComboBox:hover {
    border: 1px solid #0078D7;
}

QComboBox:focus {
    border: 1px solid #0078D7;
    outline: 2px solid #0078D7;
    outline-offset: 1px;
}

QComboBox:disabled {
    background-color: #F3F3F3;
    border: 1px solid #D6D6D6;
    color: #A0A0A0;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: right;
    width: 20px;
    background-color: #E1E1E1;
    border-left: 1px solid #8A8A8A;
}

QComboBox::down-arrow {
    width: 8px;
    height: 8px;
    image: none;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-top: 4px solid #000000;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #8A8A8A;
    selection-background-color: #0078D7;
    selection-color: #FFFFFF;
}

/* ---------------------------------------------------------------------
   Checkboxes -- flat white box, accent-blue check, sharp corners.
   --------------------------------------------------------------------- */

QCheckBox::indicator {
    width: 13px;
    height: 13px;
    background-color: #FFFFFF;
    border: 1px solid #8A8A8A;
    border-radius: 0px;
}

QCheckBox::indicator:hover {
    border: 1px solid #0078D7;
}

QCheckBox::indicator:focus {
    outline: 2px solid #0078D7;
    outline-offset: 1px;
}

QCheckBox::indicator:disabled {
    background-color: #F3F3F3;
    border: 1px solid #D6D6D6;
}

QCheckBox::indicator:checked {
    background-color: #0078D7;
    border: 1px solid #0078D7;
    image: url(theme:checkmark.png);
}

/* ---------------------------------------------------------------------
   Sliders -- thin flat groove, small square-ish accent handle.
   --------------------------------------------------------------------- */

QSlider::groove:horizontal {
    height: 3px;
    background-color: #C7C7C7;
}

QSlider::handle:horizontal {
    width: 12px;
    height: 12px;
    margin: -5px 0;
    background-color: #0078D7;
    border: 1px solid #005A9E;
    border-radius: 6px;
}

QSlider::handle:horizontal:focus {
    outline: 2px solid #0078D7;
    outline-offset: 2px;
}

QSlider::handle:horizontal:disabled {
    background-color: #D6D6D6;
    border: 1px solid #ADADAD;
}

QTableWidget, QTreeWidget {
    background-color: #FFFFFF;
    alternate-background-color: #F7F7F7;
    gridline-color: #E1E1E1;
    border: 1px solid #D6D6D6;
    selection-background-color: #0078D7;
    selection-color: #FFFFFF;
}

QHeaderView::section {
    background-color: #F3F3F3;
    border: 1px solid #D6D6D6;
    padding: 3px;
    font-weight: normal;
    color: #000000;
}

QProgressBar {
    border: 1px solid #D6D6D6;
    background-color: #E1E1E1;
    text-align: center;
    color: #000000;
}

QProgressBar::chunk {
    background-color: #0078D7;
    margin: 0px;
}

QLabel {
    background: transparent;
}

QSplitter::handle {
    background-color: #FFFFFF;
}

/* Thin, minimal, flat scrollbars -- Win10 modernized these away from the
   chunky 3D look older Windows versions used. */
QScrollBar:vertical {
    background: #FFFFFF;
    width: 12px;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #C1C1C1;
    border-radius: 0px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background-color: #A6A6A6;
}

QScrollBar:horizontal {
    background: #FFFFFF;
    height: 12px;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #C1C1C1;
    border-radius: 0px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #A6A6A6;
}

/* ---------------------------------------------------------------------
   Tooltip -- flat, matches the tab/panel neutral gray with a thin border.
   --------------------------------------------------------------------- */

QToolTip {
    background-color: #F3F3F3;
    color: #000000;
    border: 1px solid #8A8A8A;
    padding: 4px 8px;
}

/* ---------------------------------------------------------------------
   Custom title bar sits directly above the tab widget in a frameless
   window -- drop the pane's top border to avoid a double line/gap.
   --------------------------------------------------------------------- */

QTabWidget#mainTabs::pane {
    border-top: none;
    top: 0px;
}

QSizeGrip {
    background-color: #FFFFFF;
    width: 16px;
    height: 16px;
}
