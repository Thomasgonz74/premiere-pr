/* Torrent 2000 -- "Windows 95" retro skin.

   Reference Win32 system colors (classic gray Win95/98 chrome):
     window / button face    #C0C0C0
     button highlight        #FFFFFF   (top/left bevel on raised controls)
     button shadow           #808080   (bottom/right bevel on raised controls)
     button dark shadow      #000000   (outer-most bottom/right line)
     window text             #000000
     disabled text           #808080
     selection (navy)        #000080

   Sharp square corners everywhere and thick 2px chunky bevels -- the two
   things that most visually separate 95 from the softer-cornered, thinner-
   bevel Luna XP skin. The title bar (solid navy caption, no gradient) is
   NOT drawn by this stylesheet -- see src/torrent2000/ui/widgets/app_title_bar.py
*/

/* + focus/hover/disabled/tab-hover/scrollbar/tooltip polish pass */

* {
    font-family: "MS Sans Serif", "Tahoma", sans-serif;
    font-size: 9pt;
}

QMainWindow, QWidget#centralWidget {
    background-color: #C0C0C0;
}

QWidget {
    background-color: #C0C0C0;
    color: #000000;
}

QTabWidget::pane {
    border: 2px solid #808080;
    border-top-color: #FFFFFF;
    border-left-color: #FFFFFF;
    background-color: #C0C0C0;
    top: -1px;
}

QTabBar::tab {
    background-color: #C0C0C0;
    border-width: 2px;
    border-style: outset;
    border-top-color: #FFFFFF;
    border-left-color: #FFFFFF;
    border-right-color: #808080;
    border-bottom: none;
    border-radius: 0px;
    padding: 4px 14px;
    margin-right: 0px;
    color: #000000;
}

QTabBar::tab:selected {
    background-color: #C0C0C0;
    border-bottom: 2px solid #C0C0C0;
    margin-top: 0px;
}

QTabBar::tab:!selected {
    margin-top: 2px;
}

QTabBar::tab:hover:!selected {
    border-top-color: #000080;
}

QTabBar::tab:focus {
    outline: 2px solid #000080;
    outline-offset: 1px;
}

QGroupBox {
    border: 2px solid #808080;
    border-top-color: #808080;
    border-left-color: #808080;
    border-right-color: #FFFFFF;
    border-bottom-color: #FFFFFF;
    border-radius: 0px;
    margin-top: 10px;
    padding-top: 6px;
    background-color: #C0C0C0;
    font-weight: bold;
    color: #000000;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #000000;
}

QPushButton {
    background-color: #C0C0C0;
    border-width: 2px;
    border-style: outset;
    border-radius: 0px;
    border-top-color: #FFFFFF;
    border-left-color: #FFFFFF;
    border-right-color: #000000;
    border-bottom-color: #000000;
    padding: 4px 12px;
    min-height: 18px;
    color: #000000;
}

QPushButton:hover:!pressed {
    border-top-color: #FFFFFF;
    border-left-color: #FFFFFF;
    border-right-color: #000080;
    border-bottom-color: #000080;
}

QPushButton:focus {
    outline: 2px solid #000080;
    outline-offset: 2px;
}

QPushButton:pressed {
    background-color: #C0C0C0;
    border-style: inset;
    border-top-color: #000000;
    border-left-color: #000000;
    border-right-color: #FFFFFF;
    border-bottom-color: #FFFFFF;
    padding: 5px 11px 3px 13px;
}

QPushButton:default {
    border-width: 3px;
}

QPushButton:disabled {
    background-color: #C0C0C0;
    border-width: 2px;
    border-style: outset;
    border-top-color: #FFFFFF;
    border-left-color: #FFFFFF;
    border-right-color: #808080;
    border-bottom-color: #808080;
    color: #808080;
}

QPushButton#dangerButton {
    background-color: #C0A0A0;
    border-width: 2px;
    border-style: outset;
    border-radius: 0px;
    border-top-color: #E8C8C8;
    border-left-color: #E8C8C8;
    border-right-color: #400000;
    border-bottom-color: #400000;
    padding: 2px 10px;
    min-height: 16px;
    color: #000000;
}

QPushButton#dangerButton:hover:!pressed {
    border-top-color: #E8C8C8;
    border-left-color: #E8C8C8;
    border-right-color: #000080;
    border-bottom-color: #000080;
}

QPushButton#dangerButton:focus {
    outline: 2px solid #000080;
    outline-offset: 2px;
}

QPushButton#dangerButton:pressed {
    background-color: #A87878;
    border-style: inset;
    border-top-color: #400000;
    border-left-color: #400000;
    border-right-color: #E8C8C8;
    border-bottom-color: #E8C8C8;
    padding: 3px 9px 1px 11px;
}

QLineEdit, QSpinBox, QAbstractSpinBox {
    background-color: #FFFFFF;
    border-width: 2px;
    border-style: inset;
    border-top-color: #808080;
    border-left-color: #808080;
    border-right-color: #FFFFFF;
    border-bottom-color: #FFFFFF;
    padding: 2px 4px;
    selection-background-color: #000080;
    selection-color: #FFFFFF;
}

QLineEdit:hover, QSpinBox:hover, QAbstractSpinBox:hover {
    border-top-color: #000080;
    border-left-color: #000080;
}

QLineEdit:focus, QSpinBox:focus, QAbstractSpinBox:focus {
    outline: 2px solid #000080;
    outline-offset: 1px;
}

QComboBox {
    background-color: #FFFFFF;
    border-width: 2px;
    border-style: inset;
    border-top-color: #808080;
    border-left-color: #808080;
    border-right-color: #FFFFFF;
    border-bottom-color: #FFFFFF;
    padding: 2px 4px;
}

QComboBox:hover {
    border-top-color: #000080;
    border-left-color: #000080;
}

QComboBox:focus {
    outline: 2px solid #000080;
    outline-offset: 1px;
}

QComboBox:disabled {
    background-color: #C0C0C0;
    color: #808080;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: right;
    width: 18px;
    background-color: #C0C0C0;
    border-width: 2px;
    border-style: outset;
    border-top-color: #FFFFFF;
    border-left-color: #FFFFFF;
    border-right-color: #000000;
    border-bottom-color: #000000;
}

QComboBox::down-arrow {
    width: 8px;
    height: 8px;
    image: none;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-top: 4px solid #000000;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 2px solid #000000;
    selection-background-color: #000080;
    selection-color: #FFFFFF;
}

QCheckBox::indicator {
    width: 12px;
    height: 12px;
    background-color: #FFFFFF;
    border-width: 2px;
    border-style: inset;
    border-top-color: #808080;
    border-left-color: #808080;
    border-right-color: #FFFFFF;
    border-bottom-color: #FFFFFF;
}

QCheckBox::indicator:checked {
    background-color: #FFFFFF;
    image: url(theme:checkmark.png);
}

QCheckBox::indicator:hover {
    border-top-color: #000080;
    border-left-color: #000080;
}

QCheckBox::indicator:focus {
    outline: 2px solid #000080;
    outline-offset: 1px;
}

QCheckBox::indicator:disabled {
    background-color: #C0C0C0;
}

QSlider::groove:horizontal {
    height: 4px;
    background-color: #808080;
    border: 2px solid #000000;
}

QSlider::handle:horizontal {
    width: 12px;
    margin: -6px 0;
    background-color: #C0C0C0;
    border-width: 2px;
    border-style: outset;
    border-top-color: #FFFFFF;
    border-left-color: #FFFFFF;
    border-right-color: #000000;
    border-bottom-color: #000000;
}

QSlider::handle:horizontal:focus {
    outline: 2px solid #000080;
    outline-offset: 2px;
}

QSlider::handle:horizontal:disabled {
    border-right-color: #808080;
    border-bottom-color: #808080;
}

QTableWidget, QTreeWidget {
    background-color: #FFFFFF;
    alternate-background-color: #E8E8E8;
    gridline-color: #808080;
    border: 2px solid #808080;
    border-top-color: #808080;
    border-left-color: #808080;
    selection-background-color: #000080;
    selection-color: #FFFFFF;
}

QHeaderView::section {
    background-color: #C0C0C0;
    border-width: 1px;
    border-style: outset;
    border-top-color: #FFFFFF;
    border-left-color: #FFFFFF;
    border-right-color: #000000;
    border-bottom-color: #000000;
    padding: 3px;
    font-weight: bold;
    color: #000000;
}

QProgressBar {
    border: 2px solid #808080;
    border-top-color: #808080;
    border-left-color: #808080;
    border-right-color: #FFFFFF;
    border-bottom-color: #FFFFFF;
    background-color: #FFFFFF;
    text-align: center;
    color: #000000;
}

QProgressBar::chunk {
    background-color: #000080;
    margin: 1px;
}

QLabel {
    background: transparent;
}

QSplitter::handle {
    background-color: #C0C0C0;
}

QScrollBar:vertical {
    background: #C0C0C0;
    width: 16px;
    border: 1px solid #000000;
}

QScrollBar::handle:vertical {
    background-color: #C0C0C0;
    border-width: 2px;
    border-style: outset;
    border-top-color: #FFFFFF;
    border-left-color: #FFFFFF;
    border-right-color: #000000;
    border-bottom-color: #000000;
    min-height: 24px;
}

QScrollBar:horizontal {
    background: #C0C0C0;
    height: 16px;
    border: 1px solid #000000;
}

QScrollBar::handle:horizontal {
    background-color: #C0C0C0;
    border-width: 2px;
    border-style: outset;
    border-top-color: #FFFFFF;
    border-left-color: #FFFFFF;
    border-right-color: #000000;
    border-bottom-color: #000000;
    min-width: 24px;
}

QTabWidget#mainTabs::pane {
    border-top: none;
    top: 0px;
}

QSizeGrip {
    background-color: #C0C0C0;
    width: 16px;
    height: 16px;
}

QToolTip {
    background-color: #FFFFE1;
    border: 1px solid #000000;
    color: #000000;
    padding: 3px 6px;
}
