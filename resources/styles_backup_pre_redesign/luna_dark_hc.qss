/* Torrent 2000 -- "Windows Classic" XP skin, HIGH-CONTRAST DARK variant.

   Matches the real Windows "High Contrast Black" accessibility theme's
   color contract (pure black background, pure white text/borders, yellow
   focus/selection accent, no gradients or subtle bevels) while keeping
   this theme's characteristic small-radius button/tab shape and font so
   it's still recognizably "the XP one" among the high-contrast variants.

   The title bar is NOT drawn by this stylesheet -- see
   src/torrent2000/ui/widgets/app_title_bar.py
*/

/* + focus/disabled/tab-hover/scrollbar/tooltip polish pass (this file already had hover on inputs/buttons/checkbox) */

* {
    font-family: "Tahoma", "MS Shell Dlg 2", sans-serif;
    font-size: 9pt;
}

QMainWindow, QWidget#centralWidget {
    background-color: #000000;
}

QWidget {
    background-color: #000000;
    color: #FFFFFF;
}

QTabWidget::pane {
    border: 2px solid #FFFFFF;
    background-color: #000000;
    top: -1px;
}

QTabBar::tab {
    background-color: #000000;
    border: 2px solid #FFFFFF;
    border-bottom: none;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    padding: 4px 14px;
    margin-right: 1px;
    color: #FFFFFF;
}

QTabBar::tab:selected {
    background-color: #000000;
    border-color: #FFFF00;
    border-bottom: 2px solid #000000;
    margin-top: 0px;
}

QTabBar::tab:!selected {
    margin-top: 2px;
}

QTabBar::tab:hover:!selected {
    background-color: #FFFFFF;
    color: #000000;
}

QTabBar::tab:focus {
    border-width: 3px;
    border-color: #FFFF00;
}

QGroupBox {
    border: 2px solid #FFFFFF;
    border-radius: 0px;
    margin-top: 10px;
    padding-top: 6px;
    background-color: #000000;
    font-weight: bold;
    color: #FFFFFF;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #FFFFFF;
}

QPushButton {
    background-color: #000000;
    border: 2px solid #FFFFFF;
    border-radius: 3px;
    padding: 4px 12px;
    min-height: 18px;
    color: #FFFFFF;
}

QPushButton:hover:!pressed {
    border: 2px solid #FFFF00;
    color: #FFFF00;
}

QPushButton:focus {
    border: 3px solid #FFFF00;
    color: #FFFF00;
}

QPushButton:pressed {
    background-color: #FFFF00;
    border: 2px solid #FFFF00;
    color: #000000;
    padding: 5px 11px 3px 13px;
}

QPushButton:default {
    border-width: 3px;
}

QPushButton:disabled {
    background-color: #000000;
    border: 2px solid #7F7F7F;
    color: #7F7F7F;
}

QPushButton#dangerButton {
    background-color: #000000;
    border: 2px solid #FF3B30;
    border-radius: 3px;
    padding: 2px 10px;
    min-height: 16px;
    color: #FF3B30;
}

QPushButton#dangerButton:hover:!pressed {
    border: 2px solid #FFFF00;
    color: #FFFF00;
}

QPushButton#dangerButton:focus {
    border: 3px solid #FFFF00;
    color: #FFFF00;
}

QPushButton#dangerButton:pressed {
    background-color: #FF3B30;
    border: 2px solid #FF3B30;
    color: #000000;
    padding: 3px 9px 1px 11px;
}

QLineEdit, QSpinBox, QAbstractSpinBox {
    background-color: #000000;
    border: 2px solid #FFFFFF;
    padding: 2px 4px;
    color: #FFFFFF;
    selection-background-color: #FFFF00;
    selection-color: #000000;
}

QLineEdit:hover, QSpinBox:hover, QAbstractSpinBox:hover {
    border: 2px solid #FFFF00;
}

QLineEdit:focus, QSpinBox:focus, QAbstractSpinBox:focus {
    border: 3px solid #FFFF00;
}

QComboBox {
    background-color: #000000;
    border: 2px solid #FFFFFF;
    padding: 2px 4px;
    color: #FFFFFF;
}

QComboBox:hover {
    border: 2px solid #FFFF00;
}

QComboBox:focus {
    border: 3px solid #FFFF00;
}

QComboBox:disabled {
    background-color: #000000;
    border: 2px solid #7F7F7F;
    color: #7F7F7F;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: right;
    width: 18px;
    background-color: #000000;
    border-left: 2px solid #FFFFFF;
}

QComboBox::down-arrow {
    width: 8px;
    height: 8px;
    image: none;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-top: 4px solid #FFFFFF;
}

QComboBox QAbstractItemView {
    background-color: #000000;
    color: #FFFFFF;
    border: 2px solid #FFFFFF;
    selection-background-color: #FFFF00;
    selection-color: #000000;
}

QCheckBox::indicator {
    width: 13px;
    height: 13px;
    background-color: #000000;
    border: 2px solid #FFFFFF;
}

QCheckBox::indicator:hover {
    border: 2px solid #FFFF00;
}

QCheckBox::indicator:focus {
    border: 3px solid #FFFF00;
}

QCheckBox::indicator:checked {
    background-color: #FFFF00;
    border: 2px solid #FFFF00;
    image: url(theme:checkmark.png);
}

QCheckBox::indicator:disabled {
    background-color: #000000;
    border: 2px solid #7F7F7F;
}

QSlider::groove:horizontal {
    height: 4px;
    background-color: #FFFFFF;
    border: none;
}

QSlider::handle:horizontal {
    width: 14px;
    margin: -7px 0;
    background-color: #FFFF00;
    border: 2px solid #FFFF00;
}

QSlider::handle:horizontal:focus {
    background-color: #FFFFFF;
    border: 3px solid #FFFF00;
}

QSlider::handle:horizontal:disabled {
    background-color: #7F7F7F;
    border: 2px solid #7F7F7F;
}

QTableWidget, QTreeWidget {
    background-color: #000000;
    alternate-background-color: #1A1A1A;
    gridline-color: #7F7F7F;
    border: 2px solid #FFFFFF;
    color: #FFFFFF;
    selection-background-color: #FFFF00;
    selection-color: #000000;
}

QHeaderView::section {
    background-color: #000000;
    border: 2px solid #FFFFFF;
    padding: 3px;
    font-weight: bold;
    color: #FFFFFF;
}

QProgressBar {
    border: 2px solid #FFFFFF;
    background-color: #000000;
    text-align: center;
    color: #FFFFFF;
}

QProgressBar::chunk {
    background-color: #FFFF00;
    margin: 1px;
}

QLabel {
    background: transparent;
    color: #FFFFFF;
}

QToolTip {
    background-color: #000000;
    border: 2px solid #FFFFFF;
    padding: 3px 6px;
    color: #FFFFFF;
}

QSplitter::handle {
    background-color: #000000;
}

QScrollBar:vertical {
    background: #000000;
    width: 16px;
    border: 2px solid #FFFFFF;
}

QScrollBar::handle:vertical {
    background-color: #FFFFFF;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background-color: #FFFF00;
}

QScrollBar:horizontal {
    background: #000000;
    height: 16px;
    border: 2px solid #FFFFFF;
}

QScrollBar::handle:horizontal {
    background-color: #FFFFFF;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #FFFF00;
}

QTabWidget#mainTabs::pane {
    border-top: none;
    top: 0px;
}

QSizeGrip {
    background-color: #000000;
    width: 16px;
    height: 16px;
}
