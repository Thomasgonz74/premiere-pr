/* Torrent 2000 -- "macOS" skin, DARK variant, matching the real macOS
   Dark Mode appearance.

   Reference colors:
     window background      #1E1E1E
     panel/control gray      #2C2C2E
     accent blue             #0A84FF  (macOS Dark Mode's brighter system blue)
     border gray             #3A3A3C
     text                    #F5F5F7
     disabled text           #6E6E73

   Same flat, heavily rounded shapes as macos.qss. The title bar's traffic
   lights are NOT drawn by this stylesheet (and don't change color for dark
   mode -- see app_title_bar.py) -- see
   src/torrent2000/ui/widgets/app_title_bar.py.

   + focus/hover/disabled/tab-hover/scrollbar/tooltip polish pass
*/

* {
    font-family: "Segoe UI", "Helvetica Neue", "Arial", sans-serif;
    font-size: 9pt;
}

QMainWindow, QWidget#centralWidget {
    background-color: #1E1E1E;
}

QWidget {
    background-color: #1E1E1E;
    color: #F5F5F7;
}

QTabWidget::pane {
    border: 1px solid #3A3A3C;
    border-radius: 8px;
    background-color: #1E1E1E;
    top: -1px;
}

QTabBar::tab {
    background-color: #2C2C2E;
    border: 1px solid #3A3A3C;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    padding: 6px 16px;
    margin-right: 2px;
    color: #F5F5F7;
}

QTabBar::tab:selected {
    background-color: #323234;
    border-color: #3A3A3C;
    border-bottom: 2px solid #0A84FF;
    margin-top: 0px;
}

QTabBar::tab:!selected {
    margin-top: 2px;
    color: #98989D;
}

QTabBar::tab:hover:!selected {
    background-color: #1D3A52;
    color: #F5F5F7;
}

QTabBar::tab:focus {
    outline: 2px solid #0A84FF;
    outline-offset: -3px;
    outline-radius: 6px;
}

QGroupBox {
    border: 1px solid #3A3A3C;
    border-radius: 10px;
    margin-top: 10px;
    padding-top: 6px;
    background-color: #2C2C2E;
    font-weight: 600;
    color: #F5F5F7;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 4px;
    color: #F5F5F7;
}

QPushButton {
    background-color: #3A3A3C;
    border: 1px solid #4A4A4C;
    border-radius: 7px;
    padding: 4px 14px;
    min-height: 18px;
    color: #F5F5F7;
}

QPushButton:hover:!pressed {
    background-color: #16324D;
    border: 1px solid #0A84FF;
}

QPushButton:pressed {
    background-color: #0A84FF;
    border: 1px solid #0870D6;
    color: #FFFFFF;
}

QPushButton:default {
    background-color: #0A84FF;
    border: 1px solid #0870D6;
    color: #FFFFFF;
}

QPushButton:disabled {
    background-color: #2C2C2E;
    border: 1px solid #3A3A3C;
    color: #6E6E73;
}

QPushButton:focus {
    outline: 2px solid #0A84FF;
    outline-offset: 2px;
    outline-radius: 9px;
}

QPushButton#dangerButton {
    background-color: #3A3A3C;
    border: 1px solid #FF453A;
    border-radius: 7px;
    padding: 2px 12px;
    min-height: 16px;
    color: #FF453A;
}

QPushButton#dangerButton:hover:!pressed {
    background-color: #4D211E;
    border: 1px solid #FF453A;
}

QPushButton#dangerButton:pressed {
    background-color: #FF453A;
    border: 1px solid #E0281E;
    color: #FFFFFF;
}

QPushButton#dangerButton:focus {
    outline: 2px solid #FF453A;
    outline-offset: 2px;
    outline-radius: 9px;
}

QLineEdit, QSpinBox, QAbstractSpinBox {
    background-color: #2C2C2E;
    border: 1px solid #4A4A4C;
    border-radius: 6px;
    padding: 3px 6px;
    color: #F5F5F7;
    selection-background-color: #0A84FF;
    selection-color: #FFFFFF;
}

QLineEdit:hover, QSpinBox:hover, QAbstractSpinBox:hover {
    border: 1px solid #0A84FF;
}

QLineEdit:focus, QSpinBox:focus, QAbstractSpinBox:focus {
    border: 1px solid #0A84FF;
    outline: 2px solid #0A84FF;
    outline-offset: 1px;
    outline-radius: 8px;
}

QComboBox {
    background-color: #2C2C2E;
    border: 1px solid #4A4A4C;
    border-radius: 6px;
    padding: 3px 6px;
    color: #F5F5F7;
}

QComboBox:hover {
    border: 1px solid #0A84FF;
}

QComboBox:focus {
    border: 1px solid #0A84FF;
    outline: 2px solid #0A84FF;
    outline-offset: 1px;
    outline-radius: 8px;
}

QComboBox:disabled {
    background-color: #2C2C2E;
    border: 1px solid #3A3A3C;
    color: #6E6E73;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: right;
    width: 20px;
    background-color: transparent;
    border: none;
}

QComboBox::down-arrow {
    width: 8px;
    height: 8px;
    image: none;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-top: 4px solid #F5F5F7;
}

QComboBox::down-arrow:disabled {
    border-top: 4px solid #6E6E73;
}

QComboBox QAbstractItemView {
    background-color: #2C2C2E;
    color: #F5F5F7;
    border: 1px solid #4A4A4C;
    border-radius: 8px;
    selection-background-color: #0A84FF;
    selection-color: #FFFFFF;
}

QCheckBox::indicator {
    width: 15px;
    height: 15px;
    background-color: #2C2C2E;
    border: 1px solid #4A4A4C;
    border-radius: 4px;
}

QCheckBox::indicator:hover {
    border: 1px solid #0A84FF;
}

QCheckBox::indicator:focus {
    border: 1px solid #0A84FF;
    outline: 2px solid #0A84FF;
    outline-offset: 1px;
    outline-radius: 6px;
}

QCheckBox::indicator:checked {
    background-color: #0A84FF;
    border: 1px solid #0A84FF;
    image: url(theme:checkmark.png);
}

QCheckBox::indicator:disabled {
    background-color: #2C2C2E;
    border: 1px solid #3A3A3C;
}

QCheckBox::indicator:checked:disabled {
    background-color: #4A4A4C;
    border: 1px solid #4A4A4C;
}

QSlider::groove:horizontal {
    height: 4px;
    background-color: #4A4A4C;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    width: 16px;
    height: 16px;
    margin: -6px 0;
    background-color: #E5E5EA;
    border: 1px solid #6E6E73;
    border-radius: 8px;
}

QSlider::handle:horizontal:focus {
    border: 1px solid #0A84FF;
    outline: 2px solid #0A84FF;
    outline-offset: 2px;
    outline-radius: 9px;
}

QSlider::handle:horizontal:disabled {
    background-color: #3A3A3C;
    border: 1px solid #4A4A4C;
}

QTableWidget, QTreeWidget {
    background-color: #2C2C2E;
    alternate-background-color: #262628;
    gridline-color: #3A3A3C;
    border: 1px solid #3A3A3C;
    border-radius: 8px;
    color: #F5F5F7;
    selection-background-color: #0A84FF;
    selection-color: #FFFFFF;
}

QHeaderView::section {
    background-color: #323234;
    border: 1px solid #3A3A3C;
    padding: 3px;
    font-weight: 600;
    color: #98989D;
}

QProgressBar {
    border: 1px solid #3A3A3C;
    border-radius: 6px;
    background-color: #3A3A3C;
    text-align: center;
    color: #F5F5F7;
}

QProgressBar::chunk {
    background-color: #0A84FF;
    border-radius: 5px;
    margin: 1px;
}

QLabel {
    background: transparent;
    color: #F5F5F7;
}

QSplitter::handle {
    background-color: #1E1E1E;
}

QScrollBar:vertical {
    background: #1E1E1E;
    width: 11px;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #5A5A5C;
    border-radius: 5px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background-color: #7A7A7C;
}

QScrollBar:horizontal {
    background: #1E1E1E;
    height: 11px;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #5A5A5C;
    border-radius: 5px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #7A7A7C;
}

QToolTip {
    background-color: #2C2C2E;
    color: #F5F5F7;
    border: 1px solid #4A4A4C;
    border-radius: 6px;
    padding: 4px 8px;
}

QTabWidget#mainTabs::pane {
    border-top: none;
    top: 0px;
}

QSizeGrip {
    background-color: #1E1E1E;
    width: 16px;
    height: 16px;
}
