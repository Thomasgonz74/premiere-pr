/* Torrent 2000 -- "CCCP" skin: Soviet-constructivist propaganda-poster
   look (think Rodchenko/El Lissitzky), sharp square corners, thick white
   borders. Red is used as an ACCENT against a black/charcoal base -- not
   as the base itself -- matching how real constructivist posters actually
   balance the palette (mostly black and white, red used sparingly for
   maximum punch).

   Reference colors:
     window background        #161616  (near-black)
     panel background          #1F1F1F
     recessed input background  #0D0D0D
     red accent                 #CC1B1B  (selection, progress, headers, hover)
     border white                #E8E8E8
     text                         #EDEDED
     disabled text                 #6E6E6E

   The title bar (solid red caption, hammer-and-sickle close button) is
   NOT drawn by this stylesheet -- see
   src/torrent2000/ui/widgets/app_title_bar.py. Two theme-specific
   mechanics live outside QSS entirely: downloading is blocked while this
   theme is active (engine/session_manager.py) and sharing counts for 3x
   toward the level (stats/leveling.py).
*/
/* + focus/hover/disabled/tab-hover/scrollbar/tooltip polish pass */

* {
    font-family: "Arial", "Segoe UI", sans-serif;
    font-size: 9pt;
}

QMainWindow, QWidget#centralWidget {
    background-color: #161616;
}

QWidget {
    background-color: #161616;
    color: #EDEDED;
}

QTabWidget::pane {
    border: 2px solid #E8E8E8;
    background-color: #161616;
    top: -1px;
}

QTabBar::tab {
    background-color: #1F1F1F;
    border: 2px solid #E8E8E8;
    border-bottom: none;
    border-radius: 0px;
    padding: 5px 16px;
    margin-right: 1px;
    color: #EDEDED;
    font-weight: bold;
}

QTabBar::tab:hover:!selected {
    background-color: #2A2A2A;
    color: #FFFFFF;
}

QTabBar::tab:selected {
    background-color: #161616;
    border-color: #E8E8E8;
    border-bottom: 3px solid #CC1B1B;
    margin-top: 0px;
    color: #CC1B1B;
}

QTabBar::tab:!selected {
    margin-top: 2px;
}

QTabBar::tab:focus {
    outline: 2px solid #CC1B1B;
    outline-offset: -3px;
}

QGroupBox {
    border: 2px solid #E8E8E8;
    border-radius: 0px;
    margin-top: 10px;
    padding-top: 6px;
    background-color: #1F1F1F;
    font-weight: bold;
    color: #CC1B1B;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #CC1B1B;
}

QPushButton {
    background-color: #1F1F1F;
    border: 2px solid #E8E8E8;
    border-radius: 0px;
    padding: 4px 12px;
    min-height: 18px;
    color: #EDEDED;
    font-weight: bold;
}

QPushButton:hover:!pressed {
    background-color: #2A2A2A;
    border: 2px solid #CC1B1B;
    color: #CC1B1B;
}

QPushButton:pressed {
    background-color: #0D0D0D;
    border: 2px solid #CC1B1B;
}

QPushButton:focus {
    outline: 2px solid #CC1B1B;
    outline-offset: 2px;
}

QPushButton:default {
    border-width: 3px;
    border-color: #CC1B1B;
}

QPushButton:disabled {
    background-color: #1F1F1F;
    border: 2px solid #3A3A3A;
    color: #6E6E6E;
}

/* The one button that's allowed to BE red instead of just bordered by it --
   removing a torrent is exactly the kind of decisive action this theme's
   sparing red accent is reserved for. */
QPushButton#dangerButton {
    background-color: #CC1B1B;
    border: 2px solid #E8E8E8;
    border-radius: 0px;
    padding: 2px 10px;
    min-height: 16px;
    color: #EDEDED;
    font-weight: bold;
}

QPushButton#dangerButton:hover:!pressed {
    background-color: #E23434;
    border: 2px solid #FFFFFF;
}

QPushButton#dangerButton:pressed {
    background-color: #8F1212;
    border: 2px solid #E8E8E8;
}

QPushButton#dangerButton:focus {
    outline: 2px solid #FFFFFF;
    outline-offset: 2px;
}

QLineEdit, QSpinBox, QAbstractSpinBox {
    background-color: #0D0D0D;
    border: 2px solid #3A3A3A;
    border-radius: 0px;
    padding: 2px 4px;
    color: #EDEDED;
    selection-background-color: #CC1B1B;
    selection-color: #FFFFFF;
}

QLineEdit:hover, QSpinBox:hover, QAbstractSpinBox:hover {
    border: 2px solid #CC1B1B;
}

QLineEdit:focus, QSpinBox:focus, QAbstractSpinBox:focus {
    outline: 2px solid #CC1B1B;
    outline-offset: 1px;
}

QComboBox {
    background-color: #0D0D0D;
    border: 2px solid #3A3A3A;
    border-radius: 0px;
    padding: 2px 4px;
    color: #EDEDED;
}

QComboBox:hover {
    border: 2px solid #CC1B1B;
}

QComboBox:focus {
    outline: 2px solid #CC1B1B;
    outline-offset: 1px;
}

QComboBox:disabled {
    background-color: #0D0D0D;
    border: 2px solid #3A3A3A;
    color: #6E6E6E;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: right;
    width: 20px;
    background-color: #1F1F1F;
    border-left: 2px solid #3A3A3A;
}

QComboBox::down-arrow {
    width: 8px;
    height: 8px;
    image: none;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-top: 4px solid #EDEDED;
}

QComboBox::down-arrow:disabled {
    border-top: 4px solid #6E6E6E;
}

QComboBox QAbstractItemView {
    background-color: #0D0D0D;
    color: #EDEDED;
    border: 2px solid #CC1B1B;
    selection-background-color: #CC1B1B;
    selection-color: #FFFFFF;
}

QCheckBox::indicator {
    width: 13px;
    height: 13px;
    background-color: #0D0D0D;
    border: 2px solid #3A3A3A;
}

QCheckBox::indicator:hover {
    border: 2px solid #CC1B1B;
}

QCheckBox::indicator:focus {
    outline: 2px solid #CC1B1B;
    outline-offset: 1px;
}

QCheckBox::indicator:checked {
    background-color: #CC1B1B;
    image: url(theme:checkmark.png);
}

QCheckBox::indicator:disabled {
    background-color: #1F1F1F;
    border: 2px solid #3A3A3A;
}

QCheckBox::indicator:checked:disabled {
    background-color: #6E6E6E;
    border: 2px solid #3A3A3A;
}

QSlider::groove:horizontal {
    height: 4px;
    background-color: #3A3A3A;
    border: 2px solid #0D0D0D;
}

QSlider::handle:horizontal {
    width: 14px;
    margin: -6px 0;
    background-color: #CC1B1B;
    border: 2px solid #E8E8E8;
}

QSlider::handle:horizontal:focus {
    outline: 2px solid #CC1B1B;
    outline-offset: 1px;
}

QSlider::handle:horizontal:disabled {
    background-color: #6E6E6E;
    border: 2px solid #3A3A3A;
}

QTableWidget, QTreeWidget {
    background-color: #0D0D0D;
    alternate-background-color: #1A1A1A;
    gridline-color: #3A3A3A;
    border: 2px solid #3A3A3A;
    color: #EDEDED;
    selection-background-color: #CC1B1B;
    selection-color: #FFFFFF;
}

QHeaderView::section {
    background-color: #1F1F1F;
    border: 2px solid #3A3A3A;
    padding: 3px;
    font-weight: bold;
    color: #CC1B1B;
}

/* The "People's Progress" -- red filling on a dark groove. */
QProgressBar {
    border: 2px solid #3A3A3A;
    background-color: #0D0D0D;
    text-align: center;
    color: #EDEDED;
    font-weight: bold;
}

QProgressBar::chunk {
    background-color: #CC1B1B;
    margin: 1px;
}

QLabel {
    background: transparent;
    color: #EDEDED;
}

QSplitter::handle {
    background-color: #161616;
}

QScrollBar:vertical {
    background: #1F1F1F;
    width: 16px;
    border: 2px solid #3A3A3A;
}

QScrollBar::handle:vertical {
    background-color: #3A3A3A;
    border: 1px solid #0D0D0D;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background-color: #CC1B1B;
}

QScrollBar:horizontal {
    background: #1F1F1F;
    height: 16px;
    border: 2px solid #3A3A3A;
}

QScrollBar::handle:horizontal {
    background-color: #3A3A3A;
    border: 1px solid #0D0D0D;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #CC1B1B;
}

QTabWidget#mainTabs::pane {
    border-top: none;
    top: 0px;
}

QSizeGrip {
    background-color: #161616;
    width: 16px;
    height: 16px;
}

QToolTip {
    background-color: #1F1F1F;
    color: #EDEDED;
    border: 2px solid #CC1B1B;
    border-radius: 0px;
    padding: 4px 6px;
}

/* ---------------------------------------------------------------------
   Propaganda side panel (src/torrent2000/ui/widgets/propaganda_panel.py)
   -- the extra strip of window width shown only under this theme.
   --------------------------------------------------------------------- */

QWidget#cccpPropagandaPanel {
    background-color: #0D0D0D;
    border-left: 3px solid #CC1B1B;
}

QLabel#propagandaHeader {
    color: #CC1B1B;
    font-weight: bold;
    font-size: 10pt;
}

QLabel#propagandaMessage {
    color: #EDEDED;
    font-size: 9pt;
}

QFrame#propagandaDivider {
    background-color: #CC1B1B;
    border: none;
}
