/* Torrent 2000 -- "Windows Classic" XP retro skin, DARK variant.

   Real XP predates any system dark mode, so this is a reimagining: same
   beveled-3D control shapes as luna.qss, recolored onto a dark gray base
   while keeping the XP "hot-track" blue accent for hover/selection.

   Reference colors:
     window / button face   #3C3A36
     button highlight       #6B6864   (top/left bevel on raised controls)
     button shadow          #1C1B19   (bottom/right bevel on raised controls)
     button dark shadow     #0A0A09   (outer-most bottom/right line)
     window text            #EDEAE3
     disabled text          #79766B

   The title bar is NOT drawn by this stylesheet -- see
   src/torrent2000/ui/widgets/app_title_bar.py
*/

/* + focus/hover/disabled/tab-hover/scrollbar/tooltip polish pass */

* {
    font-family: "Tahoma", "MS Shell Dlg 2", sans-serif;
    font-size: 9pt;
}

QMainWindow, QWidget#centralWidget {
    background-color: #3C3A36;
}

QWidget {
    background-color: #3C3A36;
    color: #EDEAE3;
}

QTabWidget::pane {
    border: 1px solid #6B6858;
    background-color: #3C3A36;
    top: -1px;
}

QTabBar::tab {
    background-color: #2E2C29;
    border: 1px solid #6B6858;
    border-bottom: none;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    padding: 4px 14px;
    margin-right: 1px;
    color: #EDEAE3;
}

QTabBar::tab:selected {
    background-color: #3C3A36;
    border-color: #6B6858;
    border-bottom: 1px solid #3C3A36;
    margin-top: 0px;
}

QTabBar::tab:!selected {
    margin-top: 2px;
}

QTabBar::tab:hover:!selected {
    background-color: #35332F;
}

QTabBar::tab:focus {
    border-color: #4C8CE0;
}

QGroupBox {
    border: 1px solid #6B6858;
    border-right-color: #1C1B19;
    border-bottom-color: #1C1B19;
    border-radius: 0px;
    margin-top: 10px;
    padding-top: 6px;
    background-color: #3C3A36;
    font-weight: bold;
    color: #EDEAE3;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #EDEAE3;
}

QPushButton {
    background-color: #3C3A36;
    border-width: 1px;
    border-style: outset;
    border-radius: 3px;
    border-top-color: #6B6864;
    border-left-color: #6B6864;
    border-right-color: #0A0A09;
    border-bottom-color: #0A0A09;
    padding: 4px 12px;
    min-height: 18px;
    color: #EDEAE3;
}

QPushButton:hover:!pressed {
    background-color: #3C3A36;
    border-color: #4C8CE0;
}

QPushButton:focus {
    border-width: 2px;
    border-color: #4C8CE0;
}

QPushButton:pressed {
    background-color: #2E2C29;
    border-style: inset;
    border-top-color: #1C1B19;
    border-left-color: #1C1B19;
    border-right-color: #6B6864;
    border-bottom-color: #6B6864;
    padding: 5px 11px 3px 13px;
}

QPushButton:default {
    border-width: 2px;
}

QPushButton:disabled {
    background-color: #3C3A36;
    border-width: 1px;
    border-style: outset;
    border-top-color: #6B6864;
    border-left-color: #6B6864;
    border-right-color: #6B6858;
    border-bottom-color: #6B6858;
    color: #79766B;
}

QPushButton#dangerButton {
    background-color: #6B3630;
    border-width: 1px;
    border-style: outset;
    border-radius: 3px;
    border-top-color: #8A4A42;
    border-left-color: #8A4A42;
    border-right-color: #2A1310;
    border-bottom-color: #2A1310;
    padding: 2px 10px;
    min-height: 16px;
    color: #EDEAE3;
}

QPushButton#dangerButton:hover:!pressed {
    background-color: #7C4038;
    border-color: #4C8CE0;
}

QPushButton#dangerButton:focus {
    border-width: 2px;
    border-color: #4C8CE0;
}

QPushButton#dangerButton:pressed {
    background-color: #4A231F;
    border-style: inset;
    border-top-color: #2A1310;
    border-left-color: #2A1310;
    border-right-color: #8A4A42;
    border-bottom-color: #8A4A42;
    padding: 3px 9px 1px 11px;
}

QLineEdit, QSpinBox, QAbstractSpinBox {
    background-color: #201F1D;
    border-width: 1px;
    border-style: inset;
    border-top-color: #1C1B19;
    border-left-color: #1C1B19;
    border-right-color: #6B6864;
    border-bottom-color: #6B6864;
    padding: 2px 4px;
    color: #EDEAE3;
    selection-background-color: #4C8CE0;
    selection-color: #FFFFFF;
}

QLineEdit:hover, QSpinBox:hover, QAbstractSpinBox:hover {
    border-color: #4C8CE0;
}

QLineEdit:focus, QSpinBox:focus, QAbstractSpinBox:focus {
    border-width: 2px;
    border-color: #4C8CE0;
}

QComboBox {
    background-color: #201F1D;
    border-width: 1px;
    border-style: inset;
    border-top-color: #1C1B19;
    border-left-color: #1C1B19;
    border-right-color: #6B6864;
    border-bottom-color: #6B6864;
    padding: 2px 4px;
    color: #EDEAE3;
}

QComboBox:hover {
    border-color: #4C8CE0;
}

QComboBox:focus {
    border-width: 2px;
    border-color: #4C8CE0;
}

QComboBox:disabled {
    background-color: #3C3A36;
    border-top-color: #6B6864;
    border-left-color: #6B6864;
    border-right-color: #6B6858;
    border-bottom-color: #6B6858;
    color: #79766B;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: right;
    width: 18px;
    background-color: #3C3A36;
    border-width: 1px;
    border-style: outset;
    border-top-color: #6B6864;
    border-left-color: #6B6864;
    border-right-color: #0A0A09;
    border-bottom-color: #0A0A09;
}

QComboBox::down-arrow {
    width: 8px;
    height: 8px;
    image: none;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-top: 4px solid #EDEAE3;
}

QComboBox QAbstractItemView {
    background-color: #201F1D;
    color: #EDEAE3;
    border: 1px solid #1C1B19;
    selection-background-color: #4C8CE0;
    selection-color: #FFFFFF;
}

QCheckBox::indicator {
    width: 12px;
    height: 12px;
    background-color: #201F1D;
    border-width: 1px;
    border-style: inset;
    border-top-color: #1C1B19;
    border-left-color: #1C1B19;
    border-right-color: #6B6864;
    border-bottom-color: #6B6864;
}

QCheckBox::indicator:checked {
    background-color: #201F1D;
    image: url(theme:checkmark.png);
}

QCheckBox::indicator:hover {
    border-color: #4C8CE0;
}

QCheckBox::indicator:focus {
    border-width: 2px;
    border-color: #4C8CE0;
}

QCheckBox::indicator:disabled {
    background-color: #3C3A36;
    border-top-color: #6B6864;
    border-left-color: #6B6864;
    border-right-color: #6B6858;
    border-bottom-color: #6B6858;
}

QSlider::groove:horizontal {
    height: 4px;
    background-color: #6B6858;
    border: 1px solid #1C1B19;
}

QSlider::handle:horizontal {
    width: 12px;
    margin: -6px 0;
    background-color: #3C3A36;
    border-width: 1px;
    border-style: outset;
    border-top-color: #6B6864;
    border-left-color: #6B6864;
    border-right-color: #0A0A09;
    border-bottom-color: #0A0A09;
}

QSlider::handle:horizontal:focus {
    border-width: 2px;
    border-color: #4C8CE0;
}

QSlider::handle:horizontal:disabled {
    border-top-color: #6B6864;
    border-left-color: #6B6864;
    border-right-color: #6B6858;
    border-bottom-color: #6B6858;
}

QTableWidget, QTreeWidget {
    background-color: #201F1D;
    alternate-background-color: #2A2926;
    gridline-color: #2E2C29;
    border: 1px solid #1C1B19;
    color: #EDEAE3;
    selection-background-color: #4C8CE0;
    selection-color: #FFFFFF;
}

QHeaderView::section {
    background-color: #3C3A36;
    border-width: 1px;
    border-style: outset;
    border-top-color: #6B6864;
    border-left-color: #6B6864;
    border-right-color: #1C1B19;
    border-bottom-color: #1C1B19;
    padding: 3px;
    font-weight: bold;
    color: #EDEAE3;
}

QProgressBar {
    border: 1px solid #1C1B19;
    background-color: #201F1D;
    text-align: center;
    color: #EDEAE3;
}

QProgressBar::chunk {
    background-color: #4C8CE0;
    margin: 1px;
}

QLabel {
    background: transparent;
    color: #EDEAE3;
}

QToolTip {
    background-color: #201F1D;
    border: 1px solid #6B6864;
    padding: 3px 6px;
    color: #EDEAE3;
}

QSplitter::handle {
    background-color: #3C3A36;
}

QScrollBar:vertical {
    background: #3C3A36;
    width: 16px;
    border: 1px solid #1C1B19;
}

QScrollBar::handle:vertical {
    background-color: #3C3A36;
    border-width: 1px;
    border-style: outset;
    border-top-color: #6B6864;
    border-left-color: #6B6864;
    border-right-color: #0A0A09;
    border-bottom-color: #0A0A09;
    min-height: 24px;
}

QScrollBar:horizontal {
    background: #3C3A36;
    height: 16px;
    border: 1px solid #1C1B19;
}

QScrollBar::handle:horizontal {
    background-color: #3C3A36;
    border-width: 1px;
    border-style: outset;
    border-top-color: #6B6864;
    border-left-color: #6B6864;
    border-right-color: #0A0A09;
    border-bottom-color: #0A0A09;
    min-width: 24px;
}

QTabWidget#mainTabs::pane {
    border-top: none;
    top: 0px;
}

QSizeGrip {
    background-color: #3C3A36;
    width: 16px;
    height: 16px;
}
