/* Torrent 2000 -- "CCCP" skin, DARK variant: the same black/white/red
   constructivist balance as cccp.qss, pushed toward pure black with a
   slightly brighter red so it still pops against the deeper background.

   Reference colors:
     window background        #0A0A0A  (near-pure black)
     panel background          #151515
     recessed input background  #050505
     red accent                  #E2261F  (brighter, for contrast on the darker base)
     border white                  #D8D8D8
     text                            #E8E8E8
     disabled text                     #5A5A5A
*/
/* + focus/hover/disabled/tab-hover/scrollbar/tooltip polish pass */

* {
    font-family: "Arial", "Segoe UI", sans-serif;
    font-size: 9pt;
}

QMainWindow, QWidget#centralWidget {
    background-color: #0A0A0A;
}

QWidget {
    background-color: #0A0A0A;
    color: #E8E8E8;
}

QTabWidget::pane {
    border: 2px solid #D8D8D8;
    background-color: #0A0A0A;
    top: -1px;
}

QTabBar::tab {
    background-color: #151515;
    border: 2px solid #D8D8D8;
    border-bottom: none;
    border-radius: 0px;
    padding: 5px 16px;
    margin-right: 1px;
    color: #E8E8E8;
    font-weight: bold;
}

QTabBar::tab:hover:!selected {
    background-color: #201F1F;
    color: #FFFFFF;
}

QTabBar::tab:selected {
    background-color: #0A0A0A;
    border-color: #D8D8D8;
    border-bottom: 3px solid #E2261F;
    margin-top: 0px;
    color: #E2261F;
}

QTabBar::tab:!selected {
    margin-top: 2px;
}

QTabBar::tab:focus {
    outline: 2px solid #E2261F;
    outline-offset: -3px;
}

QGroupBox {
    border: 2px solid #D8D8D8;
    border-radius: 0px;
    margin-top: 10px;
    padding-top: 6px;
    background-color: #151515;
    font-weight: bold;
    color: #E2261F;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #E2261F;
}

QPushButton {
    background-color: #151515;
    border: 2px solid #D8D8D8;
    border-radius: 0px;
    padding: 4px 12px;
    min-height: 18px;
    color: #E8E8E8;
    font-weight: bold;
}

QPushButton:hover:!pressed {
    background-color: #201F1F;
    border: 2px solid #E2261F;
    color: #E2261F;
}

QPushButton:pressed {
    background-color: #050505;
    border: 2px solid #E2261F;
}

QPushButton:focus {
    outline: 2px solid #E2261F;
    outline-offset: 2px;
}

QPushButton:default {
    border-width: 3px;
    border-color: #E2261F;
}

QPushButton:disabled {
    background-color: #151515;
    border: 2px solid #303030;
    color: #5A5A5A;
}

QPushButton#dangerButton {
    background-color: #E2261F;
    border: 2px solid #D8D8D8;
    border-radius: 0px;
    padding: 2px 10px;
    min-height: 16px;
    color: #FFFFFF;
    font-weight: bold;
}

QPushButton#dangerButton:hover:!pressed {
    background-color: #F04338;
    border: 2px solid #FFFFFF;
}

QPushButton#dangerButton:pressed {
    background-color: #9E1712;
    border: 2px solid #D8D8D8;
}

QPushButton#dangerButton:focus {
    outline: 2px solid #FFFFFF;
    outline-offset: 2px;
}

QLineEdit, QSpinBox, QAbstractSpinBox {
    background-color: #050505;
    border: 2px solid #303030;
    border-radius: 0px;
    padding: 2px 4px;
    color: #E8E8E8;
    selection-background-color: #E2261F;
    selection-color: #FFFFFF;
}

QLineEdit:hover, QSpinBox:hover, QAbstractSpinBox:hover {
    border: 2px solid #E2261F;
}

QLineEdit:focus, QSpinBox:focus, QAbstractSpinBox:focus {
    outline: 2px solid #E2261F;
    outline-offset: 1px;
}

QComboBox {
    background-color: #050505;
    border: 2px solid #303030;
    border-radius: 0px;
    padding: 2px 4px;
    color: #E8E8E8;
}

QComboBox:hover {
    border: 2px solid #E2261F;
}

QComboBox:focus {
    outline: 2px solid #E2261F;
    outline-offset: 1px;
}

QComboBox:disabled {
    background-color: #050505;
    border: 2px solid #303030;
    color: #5A5A5A;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: right;
    width: 20px;
    background-color: #151515;
    border-left: 2px solid #303030;
}

QComboBox::down-arrow {
    width: 8px;
    height: 8px;
    image: none;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-top: 4px solid #E8E8E8;
}

QComboBox::down-arrow:disabled {
    border-top: 4px solid #5A5A5A;
}

QComboBox QAbstractItemView {
    background-color: #050505;
    color: #E8E8E8;
    border: 2px solid #E2261F;
    selection-background-color: #E2261F;
    selection-color: #FFFFFF;
}

QCheckBox::indicator {
    width: 13px;
    height: 13px;
    background-color: #050505;
    border: 2px solid #303030;
}

QCheckBox::indicator:hover {
    border: 2px solid #E2261F;
}

QCheckBox::indicator:focus {
    outline: 2px solid #E2261F;
    outline-offset: 1px;
}

QCheckBox::indicator:checked {
    background-color: #E2261F;
    image: url(theme:checkmark.png);
}

QCheckBox::indicator:disabled {
    background-color: #151515;
    border: 2px solid #303030;
}

QCheckBox::indicator:checked:disabled {
    background-color: #5A5A5A;
    border: 2px solid #303030;
}

QSlider::groove:horizontal {
    height: 4px;
    background-color: #303030;
    border: 2px solid #050505;
}

QSlider::handle:horizontal {
    width: 14px;
    margin: -6px 0;
    background-color: #E2261F;
    border: 2px solid #D8D8D8;
}

QSlider::handle:horizontal:focus {
    outline: 2px solid #E2261F;
    outline-offset: 1px;
}

QSlider::handle:horizontal:disabled {
    background-color: #5A5A5A;
    border: 2px solid #303030;
}

QTableWidget, QTreeWidget {
    background-color: #050505;
    alternate-background-color: #121212;
    gridline-color: #303030;
    border: 2px solid #303030;
    color: #E8E8E8;
    selection-background-color: #E2261F;
    selection-color: #FFFFFF;
}

QHeaderView::section {
    background-color: #151515;
    border: 2px solid #303030;
    padding: 3px;
    font-weight: bold;
    color: #E2261F;
}

QProgressBar {
    border: 2px solid #303030;
    background-color: #050505;
    text-align: center;
    color: #E8E8E8;
    font-weight: bold;
}

QProgressBar::chunk {
    background-color: #E2261F;
    margin: 1px;
}

QLabel {
    background: transparent;
    color: #E8E8E8;
}

QSplitter::handle {
    background-color: #0A0A0A;
}

QScrollBar:vertical {
    background: #151515;
    width: 16px;
    border: 2px solid #303030;
}

QScrollBar::handle:vertical {
    background-color: #303030;
    border: 1px solid #050505;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background-color: #E2261F;
}

QScrollBar:horizontal {
    background: #151515;
    height: 16px;
    border: 2px solid #303030;
}

QScrollBar::handle:horizontal {
    background-color: #303030;
    border: 1px solid #050505;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #E2261F;
}

QTabWidget#mainTabs::pane {
    border-top: none;
    top: 0px;
}

QSizeGrip {
    background-color: #0A0A0A;
    width: 16px;
    height: 16px;
}

QToolTip {
    background-color: #151515;
    color: #E8E8E8;
    border: 2px solid #E2261F;
    border-radius: 0px;
    padding: 4px 6px;
}

/* ---------------------------------------------------------------------
   Propaganda side panel (src/torrent2000/ui/widgets/propaganda_panel.py)
   -- the extra strip of window width shown only under this theme.
   --------------------------------------------------------------------- */

QWidget#cccpPropagandaPanel {
    background-color: #050505;
    border-left: 3px solid #E2261F;
}

QLabel#propagandaHeader {
    color: #E2261F;
    font-weight: bold;
    font-size: 10pt;
}

QLabel#propagandaMessage {
    color: #E8E8E8;
    font-size: 9pt;
}

QFrame#propagandaDivider {
    background-color: #E2261F;
    border: none;
}
