/* Torrent 2000 -- "Windows 10" skin (Fluent Design), LIGHT variant.

   Every token below comes from a real measurement or a first-party
   Microsoft source (see the scratch style-guide for the full method):

     bg              #FFFFFF   measured -- Windows 10 Settings app main
                                content pane (real screenshot, sampled)
     surface         #F3F3F3   measured #F2F2F2 (Settings app left-nav
                                sidebar), rounded to Fluent's documented
                                "secondary surface" #F3F3F3 -- tab strip
                                track, table header row, menu/dialog chrome
     border          #ADADAD   documented Win32 COLOR_BTNSHADOW default;
                                corroborated by measured dropdown border
     border-light    #E5E5E5   documented Fluent hairline divider stroke --
                                pane/table/splitter dividers
     text            #1B1B1B   documented Fluent near-black primary text
     text-muted      #5F5F5F   measured directly (secondary/list text
                                sample from official MSFT control gallery)
     accent          #0078D4   measured directly -- the exact fill color of
                                the "selected" combo item in Microsoft's own
                                Color-in-Windows doc image; matches the
                                independently documented Windows accent
                                #0078D7 within compression tolerance
     accent-pressed  #005FB8   measured directly -- filled
                                button/checkbox/toggle/slider fill in the
                                same official image
     danger          #D13438   Microsoft FluentUI token source (red.primary)
     danger-pressed  #BC2F32   FluentUI red.shade10

   Supporting tints derived from the palette above (not independently
   measured, just literal mixes used for specific interaction states):
     #E4F0FB / #BFDDF4   accent-tinted hover / pressed "reveal" wash
                         (~12% / ~25% accent over white)
     #A0A0A0 / #D6D6D6   disabled text / disabled border

   Fully flat design -- zero gradients, zero 3D bevels, sharp square
   corners everywhere (window_corner_radius = 0 in theme_manager.py).
   Every interactive state (hover/focus/pressed/disabled/selected) gets an
   immediate, crisp, unambiguous visual change. The title bar is NOT drawn
   by this stylesheet -- see src/torrent2000/ui/widgets/app_title_bar.py.
*/

* {
    font-family: "Segoe UI", "MS Shell Dlg 2", sans-serif;
    font-size: 9pt;
}

QMainWindow, QWidget#centralWidget, QWidget {
    background-color: #FFFFFF;
    color: #1B1B1B;
}

QDialog {
    background-color: #FFFFFF;
    color: #1B1B1B;
}

/* ---------------------------------------------------------------------
   Themed pointer -- an original, hand-drawn flat Fluent arrow (see
   assets/cursors/win10/arrow.png), loaded through the "theme:" search
   path set up in theme_manager.py::init_theme_runtime(). Hotspot is the
   arrow's tip, pixel (1,1) in that 20x32 PNG.

   Scoped to background/container widgets only -- window chrome, panels,
   tab strip, table viewport -- NEVER a bare `QWidget`/`*` rule, which
   would leak into every child and steal the native I-beam off
   QLineEdit/QAbstractSpinBox or override the hand/affordance cursors
   already-interactive controls (buttons, checkboxes, combo boxes) define
   for themselves via hover state.
   --------------------------------------------------------------------- */

QMainWindow, QWidget#centralWidget, QGroupBox, QTabBar,
QTableWidget, QTreeWidget {
    cursor: url(theme:cursors/win10/arrow.png) 1 1;
}

/* ---------------------------------------------------------------------
   Tabs -- flat, minimal; the selected tab is marked with a thin accent
   underline rather than a raised 3D look, matching Fluent Design.
   --------------------------------------------------------------------- */

QTabWidget::pane {
    border: 1px solid #E5E5E5;
    background-color: #FFFFFF;
    top: -1px;
}

QTabWidget#mainTabs::pane {
    border-top: none;
    top: 0px;
}

QTabBar::tab {
    background-color: #F3F3F3;
    border: 1px solid #E5E5E5;
    border-bottom: none;
    padding: 7px 18px;
    margin-right: 1px;
    color: #5F5F5F;
}

QTabBar::tab:selected {
    background-color: #FFFFFF;
    border-color: #E5E5E5;
    border-bottom: 2px solid #0078D4;
    margin-top: 0px;
    color: #1B1B1B;
}

QTabBar::tab:!selected {
    margin-top: 2px;
}

QTabBar::tab:hover:!selected {
    background-color: #E4F0FB;
    border-bottom: 2px solid #BFDDF4;
    color: #1B1B1B;
}

QTabBar::tab:focus {
    outline: 2px solid #0078D4;
    outline-offset: -3px;
}

/* ---------------------------------------------------------------------
   Group boxes -- thin flat border, plain title, no rounding.
   --------------------------------------------------------------------- */

QGroupBox {
    border: 1px solid #E5E5E5;
    border-radius: 0px;
    margin-top: 10px;
    padding-top: 6px;
    background-color: #FFFFFF;
    font-weight: normal;
    color: #1B1B1B;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #1B1B1B;
}

/* ---------------------------------------------------------------------
   Buttons -- flat rectangle, thin border, immediate accent "reveal" wash
   on hover. No gradients, no bevel, sharp corners.
   --------------------------------------------------------------------- */

QPushButton {
    background-color: #FBFBFB;
    border: 1px solid #ADADAD;
    border-radius: 0px;
    padding: 4px 12px;
    min-height: 18px;
    color: #1B1B1B;
}

QPushButton:hover:!pressed {
    background-color: #E4F0FB;
    border: 1px solid #0078D4;
}

QPushButton:pressed {
    background-color: #BFDDF4;
    border: 1px solid #005FB8;
}

QPushButton:focus {
    outline: 2px solid #0078D4;
    outline-offset: 1px;
}

QPushButton:default {
    background-color: #0078D4;
    border: 1px solid #005FB8;
    color: #FFFFFF;
}

QPushButton:default:hover:!pressed {
    background-color: #106EBE;
    border: 1px solid #005FB8;
    color: #FFFFFF;
}

QPushButton:default:pressed {
    background-color: #005FB8;
    border: 1px solid #004578;
    color: #FFFFFF;
}

QPushButton:disabled {
    background-color: #F3F3F3;
    border: 1px solid #D6D6D6;
    color: #A0A0A0;
}

/* Secondary destructive actions -- flat button, muted red tint, using the
   FluentUI-sourced danger red rather than the title bar's close-hover red. */
QPushButton#dangerButton {
    background-color: #F9DEDE;
    border: 1px solid #D13438;
    border-radius: 0px;
    padding: 2px 10px;
    min-height: 16px;
    color: #1B1B1B;
}

QPushButton#dangerButton:hover:!pressed {
    background-color: #FCE9E9;
    border: 1px solid #0078D4;
}

QPushButton#dangerButton:pressed {
    background-color: #EFB9BA;
    border: 1px solid #BC2F32;
}

QPushButton#dangerButton:disabled {
    background-color: #F3F3F3;
    border: 1px solid #D6D6D6;
    color: #A0A0A0;
}

QPushButton#dangerButton:focus {
    outline: 2px solid #0078D4;
    outline-offset: 1px;
}

/* ---------------------------------------------------------------------
   Inputs -- flat white boxes, thin gray border, accent-blue on focus.
   --------------------------------------------------------------------- */

QLineEdit, QSpinBox, QAbstractSpinBox {
    background-color: #FFFFFF;
    border: 1px solid #ADADAD;
    border-radius: 0px;
    padding: 2px 4px;
    color: #1B1B1B;
    selection-background-color: #0078D4;
    selection-color: #FFFFFF;
}

QLineEdit:hover, QSpinBox:hover, QAbstractSpinBox:hover {
    border: 1px solid #0078D4;
}

QLineEdit:focus, QSpinBox:focus, QAbstractSpinBox:focus {
    border: 1px solid #0078D4;
    outline: 2px solid #0078D4;
    outline-offset: 1px;
}

QLineEdit:disabled, QSpinBox:disabled, QAbstractSpinBox:disabled {
    background-color: #F3F3F3;
    border: 1px solid #D6D6D6;
    color: #A0A0A0;
}

QAbstractSpinBox::up-button, QAbstractSpinBox::down-button {
    subcontrol-origin: border;
    width: 16px;
    background-color: #FBFBFB;
    border-left: 1px solid #ADADAD;
}

QAbstractSpinBox::up-button {
    subcontrol-position: top right;
    border-bottom: 1px solid #E5E5E5;
}

QAbstractSpinBox::down-button {
    subcontrol-position: bottom right;
}

QAbstractSpinBox::up-button:hover, QAbstractSpinBox::down-button:hover {
    background-color: #E4F0FB;
}

QAbstractSpinBox::up-button:pressed, QAbstractSpinBox::down-button:pressed {
    background-color: #BFDDF4;
}

QAbstractSpinBox::up-arrow {
    width: 0px;
    height: 0px;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-bottom: 4px solid #1B1B1B;
}

QAbstractSpinBox::down-arrow {
    width: 0px;
    height: 0px;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-top: 4px solid #1B1B1B;
}

QComboBox {
    background-color: #FFFFFF;
    border: 1px solid #ADADAD;
    border-radius: 0px;
    padding: 2px 4px;
    color: #1B1B1B;
    /* Also required on QComboBox itself, not just on the popup's
       QAbstractItemView below -- without this, the popup's currently
       selected row opens with no visible highlight at all (confirmed by
       rendering the popup offscreen; harmonization pass, matches the
       win7 family's own documented fix for the same Qt behavior). */
    selection-background-color: #0078D4;
    selection-color: #FFFFFF;
}

QComboBox:hover {
    border: 1px solid #0078D4;
}

QComboBox:focus {
    border: 1px solid #0078D4;
    outline: 2px solid #0078D4;
    outline-offset: 1px;
}

QComboBox:disabled {
    background-color: #F3F3F3;
    border: 1px solid #D6D6D6;
    color: #A0A0A0;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: right;
    width: 22px;
    background-color: #FBFBFB;
    border-left: 1px solid #ADADAD;
}

QComboBox::drop-down:hover {
    background-color: #E4F0FB;
}

QComboBox::down-arrow {
    width: 8px;
    height: 8px;
    image: none;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-top: 4px solid #1B1B1B;
}

/* Popup listbox for the open combo -- see module docstring for the
   win7-v1 regression this must NOT reproduce: the CURRENTLY SELECTED item
   must stay legible. Selected fill is the accent blue with white text --
   always the opposite-luminance color from its own fill, on every state
   (resting, hover, selected), so it can never render text-on-same-color. */
QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #ADADAD;
    outline: none;
    padding: 2px;
    color: #1B1B1B;
    selection-background-color: #0078D4;
    selection-color: #FFFFFF;
}

QComboBox QAbstractItemView::item {
    padding: 4px 8px;
    min-height: 20px;
    color: #1B1B1B;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #E4F0FB;
    color: #1B1B1B;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #0078D4;
    color: #FFFFFF;
}

/* ---------------------------------------------------------------------
   Checkboxes -- flat white box, accent-blue check, sharp corners.
   --------------------------------------------------------------------- */

QCheckBox::indicator {
    width: 13px;
    height: 13px;
    background-color: #FFFFFF;
    border: 1px solid #ADADAD;
    border-radius: 0px;
}

QCheckBox::indicator:hover {
    border: 1px solid #0078D4;
}

QCheckBox::indicator:focus {
    outline: 2px solid #0078D4;
    outline-offset: 1px;
}

QCheckBox::indicator:disabled {
    background-color: #F3F3F3;
    border: 1px solid #D6D6D6;
}

QCheckBox::indicator:checked {
    background-color: #0078D4;
    border: 1px solid #0078D4;
    /* Original white checkmark (assets/icons/win10/), not the project's
       shared black checkmark.png -- Microsoft's own official light+dark
       control-gallery references (learn.microsoft.com "Color in Windows")
       both show a WHITE glyph on the solid accent-blue fill, never black. */
    image: url(theme:icons/win10/checkmark_white.png);
}

QCheckBox::indicator:checked:hover {
    background-color: #005FB8;
    border: 1px solid #005FB8;
}

QCheckBox::indicator:checked:disabled {
    background-color: #C7C7C7;
    border: 1px solid #C7C7C7;
}

/* ---------------------------------------------------------------------
   Sliders -- thin flat groove, small round accent handle.
   --------------------------------------------------------------------- */

QSlider::groove:horizontal {
    height: 3px;
    background-color: #C7C7C7;
}

QSlider::handle:horizontal {
    width: 12px;
    height: 12px;
    margin: -5px 0;
    background-color: #0078D4;
    border: 1px solid #005FB8;
    border-radius: 6px;
}

QSlider::handle:horizontal:hover {
    background-color: #106EBE;
}

QSlider::handle:horizontal:focus {
    outline: 2px solid #0078D4;
    outline-offset: 2px;
}

QSlider::handle:horizontal:disabled {
    background-color: #D6D6D6;
    border: 1px solid #ADADAD;
}

/* ---------------------------------------------------------------------
   Tables / trees / lists -- flat white surface, solid accent selection.
   --------------------------------------------------------------------- */

QTableWidget, QTreeWidget {
    background-color: #FFFFFF;
    alternate-background-color: #F7F7F7;
    gridline-color: #E5E5E5;
    border: 1px solid #E5E5E5;
    color: #1B1B1B;
    selection-background-color: #0078D4;
    selection-color: #FFFFFF;
}

QHeaderView::section {
    background-color: #F3F3F3;
    border: 1px solid #E5E5E5;
    padding: 3px 6px;
    font-weight: normal;
    color: #1B1B1B;
}

QListWidget {
    background-color: #FFFFFF;
    border: 1px solid #E5E5E5;
    outline: none;
    color: #1B1B1B;
    padding: 2px;
}

QListWidget::item {
    padding: 4px 8px;
}

QListWidget::item:hover {
    background-color: #E4F0FB;
}

QListWidget::item:selected {
    background-color: #0078D4;
    color: #FFFFFF;
}

QListWidget::item:focus {
    outline: 2px solid #0078D4;
    outline-offset: -2px;
}

/* ---------------------------------------------------------------------
   Context menus -- sharp square corners (authentic to Win10, unlike the
   rounded Win11 flyout menus), solid accent selection bar.
   --------------------------------------------------------------------- */

QMenu {
    background-color: #FFFFFF;
    border: 1px solid #ADADAD;
    padding: 2px;
    color: #1B1B1B;
}

QMenu::item {
    background-color: transparent;
    padding: 6px 24px 6px 14px;
    margin: 1px 2px;
    color: #1B1B1B;
}

QMenu::item:selected {
    background-color: #0078D4;
    color: #FFFFFF;
}

QMenu::item:disabled {
    color: #A0A0A0;
}

QMenu::separator {
    height: 1px;
    background-color: #E5E5E5;
    margin: 4px 8px;
}

QMenu::indicator {
    width: 13px;
    height: 13px;
    left: 4px;
}

QProgressBar {
    border: 1px solid #E5E5E5;
    background-color: #E1E1E1;
    text-align: center;
    color: #1B1B1B;
}

QProgressBar::chunk {
    background-color: #0078D4;
    margin: 0px;
}

QLabel {
    background: transparent;
    color: #1B1B1B;
}

QSplitter::handle {
    background-color: #FFFFFF;
}

/* Thin, minimal, flat scrollbars -- Win10 modernized these away from the
   chunky 3D look older Windows versions used. */
QScrollBar:vertical {
    background: #FFFFFF;
    width: 12px;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #C1C1C1;
    border-radius: 0px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background-color: #A6A6A6;
}

QScrollBar:horizontal {
    background: #FFFFFF;
    height: 12px;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #C1C1C1;
    border-radius: 0px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #A6A6A6;
}

/* ---------------------------------------------------------------------
   Tooltip -- flat, matches the tab/panel neutral gray with a thin border.
   --------------------------------------------------------------------- */

QToolTip {
    background-color: #F3F3F3;
    color: #1B1B1B;
    border: 1px solid #ADADAD;
    padding: 4px 8px;
}

QSizeGrip {
    background-color: #FFFFFF;
    width: 16px;
    height: 16px;
}
