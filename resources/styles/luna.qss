/* Torrent 2000 -- Windows XP "Luna" skin (LIGHT / default appearance).

   Rebuilt from scratch from measured pixels, not memory or interpretation.
   Method: downloaded 8 real Windows XP screenshots (Mouse/Keyboard/Date-Time
   Properties, Font dialog, Colour selector, Display Settings, Display
   Properties > Themes, Open-file dialog) from guidebookgallery.org, verified
   as genuine PNGs, and sampled exact pixel colors with Pillow at specific
   widget locations (edit-field border, listbox selection, button gradient
   top-to-bottom, disabled button fill, groupbox title text, tab fill,
   combo drop-down button...). Cross-checked against a documented table of
   Windows XP system colors (Highlight/GrayText/Info) -- values matched the
   pixel measurements almost exactly. Full derivation notes and the resulting
   token table live in the scratch research folder used to build this file.

   Design tokens (measured, not invented):

     window-bg     #ECE9D8   outer dialog/window chrome -- the classic warm
                              tan-gray XP dialog background (NOT a cool
                              blue-gray -- that was the previous redesign's
                              mistake). Measured on the Font dialog (no tab
                              control) throughout, and on the button-row
                              margin of every dialog sampled.
     pane-bg       #FFFFFF   tab-page content area inside a tabbed dialog --
                              measured white/near-white, distinct from the
                              tan outer chrome. GroupBox backgrounds are left
                              transparent so they pick up whichever of these
                              two is behind them, exactly like the real
                              dialogs (tan in the Font dialog, white inside
                              Mouse Properties' tab pages).
     border        #7F9DB9   steel-blue sunken-frame border -- edit fields,
                              combo boxes, listboxes
     border-strong #003C74   push-button outer border (measured on both the
                              default OK button and the plain Cancel button)
     text          #000000   primary window text
     muted-text    #ACA899   disabled text (Windows' own GrayText color;
                              pixel-matched on grayed "Apply"/"Settings...")
     accent        #316AC5   Windows' Highlight color -- listbox/selection
                              background, focus rings, hot-track hover
                              borders. Pixel-matched in the Font dialog's
                              selected listbox row.
     accent-soft   #C5D5FC   flat periwinkle fill used on combo drop-down
                              buttons and scrollbar thumbs (NOT a gradient --
                              measured flat)
     accent-glyph  #4D6185   dark slate-blue arrow/chevron glyph drawn on
                              accent-soft buttons
     title-accent  #0046D5   GroupBox title text -- a more saturated blue
                              than accent
     tab-highlight #F9B838   2px amber sliver on a selected tab's top edge
                              (present on every selected tab observed)
     tooltip-bg    #FFFFE1   Windows' own Info system color

   Button FACES are intentionally near-flat off-white (measured gradient
   #FDFDFC top to #EFEFE9 bottom) -- Luna's "blue" character comes from the
   border and hover ring, not a blue-tinted fill, which is where the
   previous redesign over-interpreted.

   Corner radius: window_corner_radius=0 for "luna_xp" in theme_manager.py
   (square window). Every control here echoes that with border-radius: 0,
   per the project-wide convention of matching control radius to window
   radius.

   The title bar itself (blue gradient caption + red close button) is NOT
   drawn by this stylesheet -- see src/torrent2000/ui/widgets/app_title_bar.py
*/

* {
    font-family: "Tahoma", "MS Shell Dlg 2", "Segoe UI", sans-serif;
    font-size: 8pt;
}

QMainWindow, QWidget#centralWidget {
    background-color: #ECE9D8;
}

QWidget {
    background-color: #ECE9D8;
    color: #000000;
}

QDialog {
    background-color: #ECE9D8;
    color: #000000;
}

/* ---------------------------------------------------------------------
   Themed pointer -- hand-drawn (PIL, not traced from any real OS cursor
   resource) classic arrow: white fill, black outline, faint drop-shadow
   sliver. Hotspot (the actual click point, the arrow's tip) is pixel
   (4, 3) in the 32x32 source image. Scoped to the window chrome and
   plain background containers only -- QMainWindow anchors it so it
   survives FramelessResizeController's setCursor()/unsetCursor() cycles
   on the central widget (unsetCursor() clears that widget's own cursor
   and falls back to this inherited one, never to the bare OS arrow).
   Deliberately NOT a blanket QWidget rule: QLineEdit/QSpinBox etc. set
   their own explicit I-beam cursor in Qt itself, which always wins over
   an inherited ancestor cursor, so this cannot clobber it -- verified
   offscreen (see task notes). Buttons/combos/checkboxes/sliders are left
   off this selector list on purpose too: their hover affordance here is
   the existing color/border change, not a cursor-shape change. */
QMainWindow, QWidget#centralWidget, QGroupBox, QTabBar,
QTableWidget, QTreeWidget, QListWidget {
    cursor: url(theme:cursors/luna/arrow.png) 4 3;
}

/* ---------------------------------------------------------------------
   Tabs -- selected tab merges flush with the white pane below it (both
   near-white); unselected tabs are a faint half-step darker. The amber
   top sliver on the selected tab is a real, easy-to-miss Luna detail.
   --------------------------------------------------------------------- */

QTabWidget::pane {
    border: 1px solid #7F9DB9;
    background-color: #FFFFFF;
    top: -1px;
}

QTabBar::tab {
    background-color: #F2F2ED;
    border: 1px solid #7F9DB9;
    border-bottom: none;
    padding: 5px 16px;
    margin-right: 1px;
    color: #000000;
}

QTabBar::tab:selected {
    background-color: #FCFCFE;
    border-top: 2px solid #F9B838;
    border-left: 1px solid #7F9DB9;
    border-right: 1px solid #7F9DB9;
    padding-top: 4px;
    color: #000000;
}

QTabBar::tab:!selected {
    margin-top: 2px;
}

QTabBar::tab:hover:!selected {
    background-color: #E3EDFC;
}

QTabBar::tab:focus {
    outline: none;
}

/* ---------------------------------------------------------------------
   Group boxes -- background left transparent (see pane-bg note above):
   tan behind a flat dialog, white inside a tab page, exactly like XP.
   --------------------------------------------------------------------- */

QGroupBox {
    border: 1px solid #ACA899;
    margin-top: 10px;
    padding-top: 6px;
    color: #000000;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 9px;
    padding: 0 4px;
    color: #0046D5;
}

/* ---------------------------------------------------------------------
   Buttons -- near-flat off-white face, deep-navy border. Hover adds a
   pale "hot-track" blue wash and brightens the border to accent; pressed
   sinks to a darker blue-gray. Padding compensates so the box never
   changes size across states.
   --------------------------------------------------------------------- */

QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #FDFDFC, stop:1 #EFEFE9);
    border: 1px solid #003C74;
    padding: 4px 14px;
    min-height: 18px;
    color: #000000;
}

QPushButton:hover:!pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #EAF3FF, stop:1 #D8E9FB);
    border: 1px solid #316AC5;
}

QPushButton:focus {
    outline: 2px solid #316AC5;
    outline-offset: 2px;
}

QPushButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #C7D9F0, stop:1 #E8F0FB);
    border: 1px solid #003C74;
    padding: 5px 13px 3px 15px;
}

QPushButton:default {
    border: 2px solid #316AC5;
    padding: 3px 13px;
}

QPushButton:default:pressed {
    padding: 4px 12px 2px 14px;
}

QPushButton:disabled {
    background: #F5F4EA;
    border: 1px solid #C4C0B0;
    color: #ACA899;
}

/* Secondary destructive actions (remove a torrent / remove a tracker row)
   -- there is no real Luna reference for a "red button" (stock XP never
   colored a push button by semantic), so this keeps the same measured
   button anatomy (near-flat face, colored border+text) and recolors just
   the border/text to a muted red, rather than inventing a solid-red block. */
QPushButton#dangerButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #FDFDFC, stop:1 #EFEFE9);
    border: 1px solid #A0342A;
    padding: 4px 14px;
    min-height: 18px;
    color: #7A1F14;
}

QPushButton#dangerButton:hover:!pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #FFF0EE, stop:1 #FADAD4);
    border: 1px solid #C0392B;
}

QPushButton#dangerButton:focus {
    border: 2px solid #C0392B;
    padding: 3px 13px;
}

QPushButton#dangerButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #E8B4AC, stop:1 #F5D9D4);
    border: 1px solid #7A1F14;
    padding: 5px 13px 3px 15px;
}

QPushButton#dangerButton:disabled {
    background: #F5F4EA;
    border: 1px solid #C4C0B0;
    color: #ACA899;
}

/* ---------------------------------------------------------------------
   Inputs -- white field, steel-blue sunken-style border (single weight,
   Luna dropped the classic deep bevel for a flat outline).
   --------------------------------------------------------------------- */

QLineEdit, QSpinBox, QAbstractSpinBox {
    background-color: #FFFFFF;
    border: 1px solid #7F9DB9;
    padding: 3px 6px;
    color: #000000;
    selection-background-color: #316AC5;
    selection-color: #FFFFFF;
}

QLineEdit:hover, QSpinBox:hover, QAbstractSpinBox:hover {
    border: 1px solid #316AC5;
}

QLineEdit:focus, QSpinBox:focus, QAbstractSpinBox:focus {
    border: 1px solid #316AC5;
    outline: 2px solid #316AC5;
    outline-offset: 1px;
}

QLineEdit:disabled, QSpinBox:disabled, QAbstractSpinBox:disabled {
    background-color: #ECE9D8;
    border: 1px solid #C4C0B0;
    color: #ACA899;
}

QAbstractSpinBox::up-button, QAbstractSpinBox::down-button {
    subcontrol-origin: border;
    width: 16px;
    background-color: #C5D5FC;
    border-left: 1px solid #7F9DB9;
}

QAbstractSpinBox::up-button {
    subcontrol-position: top right;
}

QAbstractSpinBox::down-button {
    subcontrol-position: bottom right;
}

QAbstractSpinBox::up-button:hover, QAbstractSpinBox::down-button:hover {
    background-color: #E4ECFC;
}

QAbstractSpinBox::up-arrow {
    width: 0;
    height: 0;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-bottom: 4px solid #4D6185;
}

QAbstractSpinBox::down-arrow {
    width: 0;
    height: 0;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-top: 4px solid #4D6185;
}

QComboBox {
    background-color: #FFFFFF;
    border: 1px solid #7F9DB9;
    padding: 3px 6px;
    min-height: 18px;
    color: #000000;
    /* Also set here (not just on the popup rule below) -- Qt derives the
       popup's effective palette from the combo box's own computed palette,
       and without this the popup's selection-background-color gets
       silently defeated, leaving the current/selected row unhighlighted
       (verified by rendering the open popup and sampling its pixels). */
    selection-background-color: #316AC5;
    selection-color: #FFFFFF;
}

QComboBox:hover {
    border: 1px solid #316AC5;
}

QComboBox:focus {
    border: 1px solid #316AC5;
    outline: 2px solid #316AC5;
    outline-offset: 1px;
}

QComboBox:disabled {
    background-color: #ECE9D8;
    border: 1px solid #C4C0B0;
    color: #ACA899;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: right;
    width: 18px;
    border-left: 1px solid #7F9DB9;
    background-color: #C5D5FC;
}

QComboBox::drop-down:hover {
    background-color: #E4ECFC;
}

QComboBox::down-arrow {
    width: 0;
    height: 0;
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #4D6185;
}

QComboBox::down-arrow:disabled {
    border-top-color: #ACA899;
}

/* Popup list -- every row (including the currently-selected one) must stay
   legible: normal rows are black-on-white, hover is a pale accent wash,
   and the selected/current row is accent-blue with WHITE text -- never the
   same color as its own background, which was the v1 Windows-7 bug this
   family must not repeat. */
QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #316AC5;
    outline: none;
    padding: 1px;
    color: #000000;
    selection-background-color: #316AC5;
    selection-color: #FFFFFF;
}

QComboBox QAbstractItemView::item {
    padding: 3px 6px;
    color: #000000;
    background-color: #FFFFFF;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #DCEAFB;
    color: #000000;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #316AC5;
    color: #FFFFFF;
}

/* ---------------------------------------------------------------------
   Checkboxes -- small square well with a faint inset gradient, deep-navy
   border matching the button family.
   --------------------------------------------------------------------- */

QCheckBox {
    spacing: 6px;
    color: #000000;
}

QCheckBox::indicator {
    width: 13px;
    height: 13px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #FFFFFF, stop:1 #E2E2DE);
    border: 1px solid #1C5180;
}

QCheckBox::indicator:hover {
    border: 1px solid #316AC5;
}

QCheckBox::indicator:focus {
    border: 2px solid #316AC5;
}

QCheckBox::indicator:checked {
    background-color: #FFFFFF;
    border: 1px solid #1C5180;
    /* Original glyph (assets/icons/luna/), not the project's shared
       chunky pixel-stepped checkmark.png -- a plain smooth anti-aliased
       tick in the same #1C5180 as the indicator's own border, closer to
       how uxtheme.dll actually rendered Luna's checkbox glyph. */
    image: url(theme:icons/luna/checkmark.png);
}

QCheckBox::indicator:disabled {
    background-color: #ECE9D8;
    border: 1px solid #C4C0B0;
}

QCheckBox:disabled {
    color: #ACA899;
}

/* ---------------------------------------------------------------------
   Sliders -- shallow sunken groove, glossy round-ish thumb (Qt won't do a
   true oval well at this size, kept it small enough to read as one).
   --------------------------------------------------------------------- */

QSlider::groove:horizontal {
    height: 4px;
    background-color: #C7C3B3;
    border: 1px solid #ACA899;
}

QSlider::handle:horizontal {
    width: 12px;
    height: 14px;
    margin: -6px 0;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #FFFFFF, stop:0.5 #DCEAFB, stop:1 #9EC0EC);
    border: 1px solid #316AC5;
}

QSlider::handle:horizontal:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #FFFFFF, stop:0.5 #EAF3FF, stop:1 #B5D3F5);
}

QSlider::handle:horizontal:focus {
    border: 2px solid #003C74;
    margin: -7px -1px;
}

QSlider::handle:horizontal:disabled {
    background: #ECE9D8;
    border: 1px solid #C4C0B0;
}

QSlider::sub-page:horizontal {
    background-color: #7EAEEF;
    border: 1px solid #ACA899;
}

/* ---------------------------------------------------------------------
   Tables / trees -- white grid, accent selection.
   --------------------------------------------------------------------- */

QTableWidget, QTreeWidget {
    background-color: #FFFFFF;
    alternate-background-color: #F1F4FA;
    gridline-color: #D9E0EC;
    border: 1px solid #7F9DB9;
    outline: none;
    selection-background-color: #316AC5;
    selection-color: #FFFFFF;
}

QTableWidget::item:hover, QTreeWidget::item:hover {
    background-color: #DCEAFB;
}

QHeaderView::section {
    background-color: #F2F2ED;
    border: none;
    border-right: 1px solid #ACA899;
    border-bottom: 1px solid #7F9DB9;
    padding: 4px 6px;
    font-weight: bold;
    color: #000000;
}

QHeaderView::section:hover {
    background-color: #DCEAFB;
}

/* ---------------------------------------------------------------------
   List widget.
   --------------------------------------------------------------------- */

QListWidget {
    background-color: #FFFFFF;
    border: 1px solid #7F9DB9;
    outline: none;
    padding: 1px;
    selection-background-color: #316AC5;
    selection-color: #FFFFFF;
}

QListWidget::item {
    padding: 3px 6px;
    color: #000000;
}

QListWidget::item:hover {
    background-color: #DCEAFB;
}

QListWidget::item:selected {
    background-color: #316AC5;
    color: #FFFFFF;
}

/* ---------------------------------------------------------------------
   Menus.
   --------------------------------------------------------------------- */

QMenu {
    background-color: #FFFFFF;
    border: 1px solid #7F9DB9;
    padding: 2px;
}

QMenu::item {
    background-color: transparent;
    padding: 4px 24px 4px 12px;
    color: #000000;
}

QMenu::item:selected {
    background-color: #316AC5;
    color: #FFFFFF;
}

QMenu::item:disabled {
    color: #ACA899;
}

QMenu::separator {
    height: 1px;
    background-color: #ACA899;
    margin: 4px 6px;
}

/* ---------------------------------------------------------------------
   Progress bar, labels, tooltip, splitter, scrollbars, size grip.
   --------------------------------------------------------------------- */

QProgressBar {
    border: 1px solid #7F9DB9;
    background-color: #FFFFFF;
    text-align: center;
    color: #000000;
    min-height: 16px;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #7EB4F7, stop:0.5 #3D7FE0, stop:1 #2A5AA8);
}

QLabel {
    background: transparent;
}

QLabel:disabled {
    color: #ACA899;
}

QToolTip {
    background-color: #FFFFE1;
    border: 1px solid #000000;
    padding: 2px 4px;
    color: #000000;
}

QSplitter::handle {
    background-color: #ECE9D8;
}

QSplitter::handle:hover {
    background-color: #DCEAFB;
}

QScrollBar:vertical {
    background: #ECE9D8;
    width: 17px;
    border-left: 1px solid #ACA899;
}

QScrollBar::handle:vertical {
    background-color: #C5D5FC;
    border: 1px solid #7F9DB9;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #E4ECFC;
    border: 1px solid #316AC5;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 16px;
    background-color: #C5D5FC;
    border-top: 1px solid #ACA899;
    subcontrol-origin: margin;
}

QScrollBar::add-line:vertical:hover, QScrollBar::sub-line:vertical:hover {
    background-color: #E4ECFC;
}

QScrollBar::sub-line:vertical {
    subcontrol-position: top;
    border-top: none;
}

QScrollBar::add-line:vertical {
    subcontrol-position: bottom;
}

QScrollBar::up-arrow:vertical {
    width: 0;
    height: 0;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-bottom: 4px solid #4D6185;
}

QScrollBar::down-arrow:vertical {
    width: 0;
    height: 0;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-top: 4px solid #4D6185;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background: #ECE9D8;
    height: 17px;
    border-top: 1px solid #ACA899;
}

QScrollBar::handle:horizontal {
    background-color: #C5D5FC;
    border: 1px solid #7F9DB9;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #E4ECFC;
    border: 1px solid #316AC5;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 16px;
    background-color: #C5D5FC;
    border-left: 1px solid #ACA899;
    subcontrol-origin: margin;
}

QScrollBar::add-line:horizontal:hover, QScrollBar::sub-line:horizontal:hover {
    background-color: #E4ECFC;
}

QScrollBar::sub-line:horizontal {
    subcontrol-position: left;
    border-left: none;
}

QScrollBar::add-line:horizontal {
    subcontrol-position: right;
}

QScrollBar::left-arrow:horizontal {
    width: 0;
    height: 0;
    border-top: 3px solid transparent;
    border-bottom: 3px solid transparent;
    border-right: 4px solid #4D6185;
}

QScrollBar::right-arrow:horizontal {
    width: 0;
    height: 0;
    border-top: 3px solid transparent;
    border-bottom: 3px solid transparent;
    border-left: 4px solid #4D6185;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

/* ---------------------------------------------------------------------
   Custom title bar (src/torrent2000/ui/widgets/app_title_bar.py) sits
   directly above the tab widget in a frameless window -- drop the pane's
   top border to avoid a double line directly under the caption.
   --------------------------------------------------------------------- */

QTabWidget#mainTabs::pane {
    border-top: none;
    top: 0px;
}

QSizeGrip {
    background-color: #ECE9D8;
    width: 16px;
    height: 16px;
}
