/* Torrent 2000 -- "CCCP" skin: bold Soviet-constructivist propaganda-poster
   red, sharp square corners, thick borders, gold accents. No gradients, no
   glass, no mercy.

   Reference colors:
     window background       #6E0E0E  (poster red)
     panel background         #5A0C0C  (darker maroon)
     recessed input background #3A0A0A
     gold accent               #D4AF37  (selection, progress, hover)
     text                      #F2E4C4  (parchment/cream, like aged paper)
     disabled text              #A97A7A

   The title bar (solid red caption) is NOT drawn by this stylesheet --
   see src/torrent2000/ui/widgets/app_title_bar.py. Two theme-specific
   mechanics live outside QSS entirely: downloading is blocked while this
   theme is active (engine/session_manager.py) and sharing counts for 3x
   toward the level (stats/leveling.py).
*/

* {
    font-family: "Arial", "Segoe UI", sans-serif;
    font-size: 9pt;
}

QMainWindow, QWidget#centralWidget {
    background-color: #6E0E0E;
}

QWidget {
    background-color: #6E0E0E;
    color: #F2E4C4;
}

QTabWidget::pane {
    border: 2px solid #2A0808;
    background-color: #6E0E0E;
    top: -1px;
}

QTabBar::tab {
    background-color: #5A0C0C;
    border: 2px solid #2A0808;
    border-bottom: none;
    border-radius: 0px;
    padding: 5px 16px;
    margin-right: 1px;
    color: #F2E4C4;
    font-weight: bold;
}

QTabBar::tab:selected {
    background-color: #6E0E0E;
    border-color: #D4AF37;
    border-bottom: 2px solid #6E0E0E;
    margin-top: 0px;
    color: #D4AF37;
}

QTabBar::tab:!selected {
    margin-top: 2px;
}

QGroupBox {
    border: 2px solid #2A0808;
    border-radius: 0px;
    margin-top: 10px;
    padding-top: 6px;
    background-color: #5A0C0C;
    font-weight: bold;
    color: #D4AF37;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #D4AF37;
}

QPushButton {
    background-color: #A31515;
    border: 2px solid #2A0808;
    border-radius: 0px;
    padding: 4px 12px;
    min-height: 18px;
    color: #F2E4C4;
    font-weight: bold;
}

QPushButton:hover:!pressed {
    background-color: #B81E1E;
    border: 2px solid #D4AF37;
    color: #D4AF37;
}

QPushButton:pressed {
    background-color: #5C0A0A;
    border: 2px solid #D4AF37;
}

QPushButton:default {
    border-width: 3px;
    border-color: #D4AF37;
}

QPushButton:disabled {
    background-color: #5A0C0C;
    border: 2px solid #3A0A0A;
    color: #A97A7A;
}

/* The one button that gets to be gold instead of red -- retiring a torrent
   isn't "downloading", the rule this theme actually cares about. */
QPushButton#dangerButton {
    background-color: #3A0A0A;
    border: 2px solid #D4AF37;
    border-radius: 0px;
    padding: 2px 10px;
    min-height: 16px;
    color: #D4AF37;
    font-weight: bold;
}

QPushButton#dangerButton:hover:!pressed {
    background-color: #4D0E0E;
    border: 2px solid #FFD700;
    color: #FFD700;
}

QPushButton#dangerButton:pressed {
    background-color: #D4AF37;
    border: 2px solid #D4AF37;
    color: #3A0A0A;
}

QLineEdit, QSpinBox, QAbstractSpinBox {
    background-color: #3A0A0A;
    border: 2px solid #2A0808;
    border-radius: 0px;
    padding: 2px 4px;
    color: #F2E4C4;
    selection-background-color: #D4AF37;
    selection-color: #3A0A0A;
}

QLineEdit:hover, QSpinBox:hover, QAbstractSpinBox:hover {
    border: 2px solid #D4AF37;
}

QComboBox {
    background-color: #3A0A0A;
    border: 2px solid #2A0808;
    border-radius: 0px;
    padding: 2px 4px;
    color: #F2E4C4;
}

QComboBox:hover {
    border: 2px solid #D4AF37;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: right;
    width: 20px;
    background-color: #A31515;
    border-left: 2px solid #2A0808;
}

QComboBox::down-arrow {
    width: 8px;
    height: 8px;
    image: none;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-top: 4px solid #F2E4C4;
}

QComboBox QAbstractItemView {
    background-color: #3A0A0A;
    color: #F2E4C4;
    border: 2px solid #D4AF37;
    selection-background-color: #D4AF37;
    selection-color: #3A0A0A;
}

QCheckBox::indicator {
    width: 13px;
    height: 13px;
    background-color: #3A0A0A;
    border: 2px solid #2A0808;
}

QCheckBox::indicator:hover {
    border: 2px solid #D4AF37;
}

QCheckBox::indicator:checked {
    background-color: #D4AF37;
    image: url(theme:checkmark.png);
}

QSlider::groove:horizontal {
    height: 4px;
    background-color: #3A0A0A;
    border: 2px solid #2A0808;
}

QSlider::handle:horizontal {
    width: 14px;
    margin: -6px 0;
    background-color: #D4AF37;
    border: 2px solid #2A0808;
}

QTableWidget, QTreeWidget {
    background-color: #3A0A0A;
    alternate-background-color: #4A0E0E;
    gridline-color: #2A0808;
    border: 2px solid #2A0808;
    color: #F2E4C4;
    selection-background-color: #D4AF37;
    selection-color: #3A0A0A;
}

QHeaderView::section {
    background-color: #5A0C0C;
    border: 2px solid #2A0808;
    padding: 3px;
    font-weight: bold;
    color: #D4AF37;
}

/* The "People's Progress" -- gold filling on a dark groove. */
QProgressBar {
    border: 2px solid #2A0808;
    background-color: #3A0A0A;
    text-align: center;
    color: #F2E4C4;
    font-weight: bold;
}

QProgressBar::chunk {
    background-color: #D4AF37;
    margin: 1px;
}

QLabel {
    background: transparent;
    color: #F2E4C4;
}

QSplitter::handle {
    background-color: #6E0E0E;
}

QScrollBar:vertical {
    background: #5A0C0C;
    width: 16px;
    border: 2px solid #2A0808;
}

QScrollBar::handle:vertical {
    background-color: #A31515;
    border: 1px solid #2A0808;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background-color: #D4AF37;
}

QTabWidget#mainTabs::pane {
    border-top: none;
    top: 0px;
}

QSizeGrip {
    background-color: #6E0E0E;
    width: 16px;
    height: 16px;
}
