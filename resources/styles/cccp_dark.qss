/* Torrent 2000 -- "CCCP" skin, DARK variant: midnight requisition. Even
   less light gets in, gold burns brighter against the near-black red.

   Reference colors:
     window background       #3D0808
     panel background         #300606
     recessed input background #1A0303
     gold accent               #E8C34A  (brighter, for contrast on the darker red)
     text                      #EFE0BC
     disabled text              #7A5252
*/

* {
    font-family: "Arial", "Segoe UI", sans-serif;
    font-size: 9pt;
}

QMainWindow, QWidget#centralWidget {
    background-color: #3D0808;
}

QWidget {
    background-color: #3D0808;
    color: #EFE0BC;
}

QTabWidget::pane {
    border: 2px solid #150202;
    background-color: #3D0808;
    top: -1px;
}

QTabBar::tab {
    background-color: #300606;
    border: 2px solid #150202;
    border-bottom: none;
    border-radius: 0px;
    padding: 5px 16px;
    margin-right: 1px;
    color: #EFE0BC;
    font-weight: bold;
}

QTabBar::tab:selected {
    background-color: #3D0808;
    border-color: #E8C34A;
    border-bottom: 2px solid #3D0808;
    margin-top: 0px;
    color: #E8C34A;
}

QTabBar::tab:!selected {
    margin-top: 2px;
}

QGroupBox {
    border: 2px solid #150202;
    border-radius: 0px;
    margin-top: 10px;
    padding-top: 6px;
    background-color: #300606;
    font-weight: bold;
    color: #E8C34A;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #E8C34A;
}

QPushButton {
    background-color: #6E1212;
    border: 2px solid #150202;
    border-radius: 0px;
    padding: 4px 12px;
    min-height: 18px;
    color: #EFE0BC;
    font-weight: bold;
}

QPushButton:hover:!pressed {
    background-color: #821818;
    border: 2px solid #E8C34A;
    color: #E8C34A;
}

QPushButton:pressed {
    background-color: #1A0303;
    border: 2px solid #E8C34A;
}

QPushButton:default {
    border-width: 3px;
    border-color: #E8C34A;
}

QPushButton:disabled {
    background-color: #300606;
    border: 2px solid #1A0303;
    color: #7A5252;
}

QPushButton#dangerButton {
    background-color: #1A0303;
    border: 2px solid #E8C34A;
    border-radius: 0px;
    padding: 2px 10px;
    min-height: 16px;
    color: #E8C34A;
    font-weight: bold;
}

QPushButton#dangerButton:hover:!pressed {
    background-color: #260505;
    border: 2px solid #FFD700;
    color: #FFD700;
}

QPushButton#dangerButton:pressed {
    background-color: #E8C34A;
    border: 2px solid #E8C34A;
    color: #1A0303;
}

QLineEdit, QSpinBox, QAbstractSpinBox {
    background-color: #1A0303;
    border: 2px solid #150202;
    border-radius: 0px;
    padding: 2px 4px;
    color: #EFE0BC;
    selection-background-color: #E8C34A;
    selection-color: #1A0303;
}

QLineEdit:hover, QSpinBox:hover, QAbstractSpinBox:hover {
    border: 2px solid #E8C34A;
}

QComboBox {
    background-color: #1A0303;
    border: 2px solid #150202;
    border-radius: 0px;
    padding: 2px 4px;
    color: #EFE0BC;
}

QComboBox:hover {
    border: 2px solid #E8C34A;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: right;
    width: 20px;
    background-color: #6E1212;
    border-left: 2px solid #150202;
}

QComboBox::down-arrow {
    width: 8px;
    height: 8px;
    image: none;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-top: 4px solid #EFE0BC;
}

QComboBox QAbstractItemView {
    background-color: #1A0303;
    color: #EFE0BC;
    border: 2px solid #E8C34A;
    selection-background-color: #E8C34A;
    selection-color: #1A0303;
}

QCheckBox::indicator {
    width: 13px;
    height: 13px;
    background-color: #1A0303;
    border: 2px solid #150202;
}

QCheckBox::indicator:hover {
    border: 2px solid #E8C34A;
}

QCheckBox::indicator:checked {
    background-color: #E8C34A;
    image: url(theme:checkmark.png);
}

QSlider::groove:horizontal {
    height: 4px;
    background-color: #1A0303;
    border: 2px solid #150202;
}

QSlider::handle:horizontal {
    width: 14px;
    margin: -6px 0;
    background-color: #E8C34A;
    border: 2px solid #150202;
}

QTableWidget, QTreeWidget {
    background-color: #1A0303;
    alternate-background-color: #240505;
    gridline-color: #150202;
    border: 2px solid #150202;
    color: #EFE0BC;
    selection-background-color: #E8C34A;
    selection-color: #1A0303;
}

QHeaderView::section {
    background-color: #300606;
    border: 2px solid #150202;
    padding: 3px;
    font-weight: bold;
    color: #E8C34A;
}

QProgressBar {
    border: 2px solid #150202;
    background-color: #1A0303;
    text-align: center;
    color: #EFE0BC;
    font-weight: bold;
}

QProgressBar::chunk {
    background-color: #E8C34A;
    margin: 1px;
}

QLabel {
    background: transparent;
    color: #EFE0BC;
}

QSplitter::handle {
    background-color: #3D0808;
}

QScrollBar:vertical {
    background: #300606;
    width: 16px;
    border: 2px solid #150202;
}

QScrollBar::handle:vertical {
    background-color: #6E1212;
    border: 1px solid #150202;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background-color: #E8C34A;
}

QTabWidget#mainTabs::pane {
    border-top: none;
    top: 0px;
}

QSizeGrip {
    background-color: #3D0808;
    width: 16px;
    height: 16px;
}
