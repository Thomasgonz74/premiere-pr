/* =========================================================================
   Torrent 2000 -- "Windows 11" skin (Mica), HIGH-CONTRAST DARK variant.

   Matches the real Windows "High Contrast Black" accessibility theme's
   color contract -- the same convention already established across this
   project (see theme_manager.py's dark_hc override, and every sibling
   theme's own *_dark_hc.qss, e.g. win10_dark_hc.qss / win7_dark_hc.qss):
   every surface collapses to pure black, every border/text to pure white,
   and the one universal accent for focus/selection/checked state is
   #FFFF00. What stays THIS theme's own, per win7_dark_hc.qss's precedent of
   keeping its family's shape language in HC mode: the 8px window corner
   radius (theme_manager.py) is echoed on every control, and "Segoe UI
   Variable" stays the font.

   Token palette (dark_hc):
     bg           #000000   window / page background
     surface      #000000   secondary surface -- true HC has no elevation
                             tiers; regions are separated by a white border,
                             never by a different fill
     border       #FFFFFF   every control border, hairline or thick
     text         #FFFFFF   primary text
     text-muted   #D0D0D0   unselected tab label
     text-disabled #7F7F7F  disabled controls -- the Windows HC "GrayText"
                             convention, kept distinct from text-muted so
                             "de-emphasized" and "disabled" don't collapse
                             into the same look
     accent/focus #FFFF00   universal focus ring, selection fill, checked
                             state, hover indication
     danger       #FF3B30   destructive red, kept apart from the yellow
                             accent so destructive controls stay
                             identifiable
   ========================================================================= */

* {
    font-family: "Segoe UI Variable", "Segoe UI", "MS Shell Dlg 2", sans-serif;
    font-size: 9pt;
}

QMainWindow, QWidget#centralWidget {
    background-color: #000000;
    /* Authentic-to-theme pointer over background/non-text zones only -- see
       win11.qss for the full rationale and assets/cursors/win11/arrow.png
       (white-fill/black-outline design stays legible on this variant's
       pure-black surfaces too, so no separate HC image was needed). */
    cursor: url(theme:cursors/win11/arrow.png) 4 3;
}

QWidget {
    background-color: #000000;
    color: #FFFFFF;
    /* Also declared here, not just on the specific popup rule below: Qt's
       QComboBox popup draws its "current item" indicator from the
       application-wide palette this universal rule establishes, not just
       from the more specific QComboBox QAbstractItemView rule -- verified
       empirically (leaving this undeclared made the current row silently
       fall back to a mismatched default color, reproducing the exact
       invisible-selected-item bug this file's popup section guards
       against). */
    selection-background-color: #FFFF00;
    selection-color: #000000;
}

QDialog {
    background-color: #000000;
    color: #FFFFFF;
    cursor: url(theme:cursors/win11/arrow.png) 4 3;
}

QTabWidget::pane {
    border: 2px solid #FFFFFF;
    border-radius: 8px;
    background-color: #000000;
    top: -1px;
    padding: 6px;
}

QTabBar {
    cursor: url(theme:cursors/win11/arrow.png) 4 3;
}

QTabBar::tab {
    background-color: #000000;
    border: 2px solid #FFFFFF;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    padding: 7px 18px;
    margin-right: 3px;
    color: #D0D0D0;
}

QTabBar::tab:selected {
    background-color: #000000;
    border-color: #FFFF00;
    border-bottom: 3px solid #FFFF00;
    margin-top: 0px;
    padding-bottom: 4px;
    color: #FFFFFF;
}

QTabBar::tab:!selected {
    margin-top: 3px;
}

QTabBar::tab:hover:!selected {
    background-color: #1A1A1A;
    border-color: #FFFF00;
    color: #FFFFFF;
}

QTabBar::tab:focus {
    outline: 2px solid #FFFF00;
    outline-offset: -4px;
}

QGroupBox {
    border: 2px solid #FFFFFF;
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 10px;
    background-color: #000000;
    font-weight: 600;
    color: #FFFFFF;
    cursor: url(theme:cursors/win11/arrow.png) 4 3;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    color: #FFFFFF;
}

QPushButton {
    background-color: #000000;
    border: 2px solid #FFFFFF;
    border-radius: 8px;
    padding: 6px 19px;
    min-height: 20px;
    color: #FFFFFF;
}

QPushButton:hover:!pressed {
    border: 2px solid #FFFF00;
    color: #FFFF00;
}

QPushButton:pressed {
    background-color: #FFFF00;
    border: 2px solid #FFFF00;
    color: #000000;
}

QPushButton:focus {
    outline: 2px solid #FFFF00;
    outline-offset: 1px;
}

QPushButton:default {
    background-color: #000000;
    border-width: 3px;
    border-color: #FFFFFF;
    color: #FFFFFF;
}

QPushButton:default:hover:!pressed {
    border-width: 3px;
    border-color: #FFFF00;
    color: #FFFF00;
}

QPushButton:default:pressed {
    background-color: #FFFF00;
    border-width: 3px;
    border-color: #FFFF00;
    color: #000000;
}

QPushButton:disabled {
    background-color: #000000;
    border: 2px solid #7F7F7F;
    color: #7F7F7F;
}

QPushButton#dangerButton {
    background-color: #000000;
    border: 2px solid #FF3B30;
    border-radius: 8px;
    padding: 4px 15px;
    min-height: 18px;
    color: #FF3B30;
}

QPushButton#dangerButton:hover:!pressed {
    border: 2px solid #FFFF00;
    color: #FFFF00;
}

QPushButton#dangerButton:pressed {
    background-color: #FF3B30;
    border: 2px solid #FF3B30;
    color: #000000;
}

QPushButton#dangerButton:focus {
    outline: 2px solid #FFFF00;
    outline-offset: 1px;
}

QPushButton#dangerButton:disabled {
    background-color: #000000;
    border: 2px solid #7F7F7F;
    color: #7F7F7F;
}

QLineEdit, QSpinBox, QAbstractSpinBox {
    background-color: #000000;
    border: 2px solid #FFFFFF;
    border-radius: 8px;
    padding: 4px 9px;
    color: #FFFFFF;
    selection-background-color: #FFFF00;
    selection-color: #000000;
}

QLineEdit:hover, QSpinBox:hover, QAbstractSpinBox:hover {
    border: 2px solid #FFFF00;
}

QLineEdit:focus, QSpinBox:focus, QAbstractSpinBox:focus {
    outline: 2px solid #FFFF00;
    outline-offset: 1px;
}

QLineEdit:disabled, QSpinBox:disabled, QAbstractSpinBox:disabled {
    background-color: #000000;
    border: 2px solid #7F7F7F;
    color: #7F7F7F;
}

QAbstractSpinBox::up-button, QAbstractSpinBox::down-button {
    subcontrol-origin: border;
    width: 18px;
    background-color: #000000;
    border-left: 2px solid #FFFFFF;
}

QAbstractSpinBox::up-button {
    subcontrol-position: top right;
    border-bottom: 2px solid #FFFFFF;
    border-top-right-radius: 6px;
}

QAbstractSpinBox::down-button {
    subcontrol-position: bottom right;
    border-bottom-right-radius: 6px;
}

QAbstractSpinBox::up-button:hover, QAbstractSpinBox::down-button:hover {
    background-color: #1A1A1A;
    border-color: #FFFF00;
}

QAbstractSpinBox::up-button:pressed, QAbstractSpinBox::down-button:pressed {
    background-color: #FFFF00;
}

QAbstractSpinBox::up-arrow {
    width: 0px;
    height: 0px;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-bottom: 4px solid #FFFFFF;
}

QAbstractSpinBox::down-arrow {
    width: 0px;
    height: 0px;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-top: 4px solid #FFFFFF;
}

QComboBox {
    background-color: #000000;
    border: 2px solid #FFFFFF;
    border-radius: 8px;
    padding: 4px 9px;
    min-height: 20px;
    color: #FFFFFF;
}

QComboBox:hover {
    border: 2px solid #FFFF00;
}

QComboBox:focus {
    outline: 2px solid #FFFF00;
    outline-offset: 1px;
}

QComboBox:disabled {
    background-color: #000000;
    border: 2px solid #7F7F7F;
    color: #7F7F7F;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: right;
    width: 26px;
    background-color: #000000;
    border-left: 2px solid #FFFFFF;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
}

QComboBox::drop-down:hover {
    background-color: #1A1A1A;
    border-left: 2px solid #FFFF00;
}

QComboBox::down-arrow {
    width: 8px;
    height: 8px;
    image: none;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-top: 4px solid #FFFFFF;
}

QComboBox::down-arrow:disabled {
    border-top: 4px solid #7F7F7F;
}

/* Open popup -- v1's Windows 7 theme had a bug where the currently-selected
   item became invisible (same text/bg color). Guarded explicitly here, and
   confirmed by actually rendering the popup open offscreen: QComboBox's
   popup paints rows via the view's palette (background-color/color for
   unselected, selection-background-color/selection-color for the current
   row), NOT via ::item/::item:selected pseudo-states -- those silently do
   not paint for a QComboBox popup in this Qt build, verified empirically
   (a saturated debug color placed on ::item:selected rendered zero
   pixels), so this theme relies solely on the mechanism that actually
   renders. */
QComboBox QAbstractItemView {
    background-color: #000000;
    color: #FFFFFF;
    border: 2px solid #FFFFFF;
    border-radius: 8px;
    outline: none;
    padding: 4px;
    selection-background-color: #FFFF00;
    selection-color: #000000;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    background-color: #000000;
    border: 2px solid #FFFFFF;
    border-radius: 4px;
}

QCheckBox::indicator:hover {
    border: 2px solid #FFFF00;
}

QCheckBox::indicator:focus {
    outline: 2px solid #FFFF00;
    outline-offset: 1px;
}

QCheckBox::indicator:disabled {
    background-color: #000000;
    border: 2px solid #7F7F7F;
}

QCheckBox::indicator:checked {
    background-color: #FFFF00;
    border: 2px solid #FFFF00;
    /* Deliberately kept on the shared solid-black checkmark.png (not the
       new smooth white assets/icons/win11/checkmark_white.png used by
       the light/dark variants): black-on-yellow is exactly the strong
       contrast HC mode wants, and every other theme's dark_hc file
       (win7/win95/cccp/win10) makes the same choice for the same fill
       color -- HC mode's own convention, not this theme's Fluent look. */
    image: url(theme:checkmark.png);
}

QCheckBox::indicator:checked:hover {
    background-color: #FFFFFF;
    border: 2px solid #FFFFFF;
}

QCheckBox::indicator:checked:disabled {
    background-color: #7F7F7F;
    border: 2px solid #7F7F7F;
}

QCheckBox:disabled {
    color: #7F7F7F;
}

QSlider::groove:horizontal {
    height: 4px;
    background-color: #FFFFFF;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    width: 16px;
    height: 16px;
    margin: -6px 0;
    background-color: #FFFF00;
    border: 2px solid #FFFF00;
    border-radius: 8px;
}

QSlider::handle:horizontal:hover {
    background-color: #FFFFFF;
    border: 2px solid #FFFFFF;
}

QSlider::handle:horizontal:focus {
    outline: 2px solid #FFFF00;
    outline-offset: 3px;
}

QSlider::handle:horizontal:disabled {
    background-color: #000000;
    border: 2px solid #7F7F7F;
}

QTableWidget, QTreeWidget {
    background-color: #000000;
    alternate-background-color: #1A1A1A;
    gridline-color: #7F7F7F;
    border: 2px solid #FFFFFF;
    border-radius: 8px;
    color: #FFFFFF;
    selection-background-color: #FFFF00;
    selection-color: #000000;
    /* Widget-level cursor, not per-item -- a cell's editor (when one is
       actually spawned) is a separate QLineEdit with its own default
       I-beam, untouched by this rule. */
    cursor: url(theme:cursors/win11/arrow.png) 4 3;
}

QTableWidget::item, QTreeWidget::item {
    padding: 3px;
}

QTableWidget::item:hover, QTreeWidget::item:hover {
    background-color: #1A1A1A;
    color: #FFFF00;
}

QTableWidget::item:selected, QTreeWidget::item:selected {
    background-color: #FFFF00;
    color: #000000;
}

QHeaderView::section {
    background-color: #000000;
    border: none;
    border-right: 2px solid #FFFFFF;
    border-bottom: 2px solid #FFFFFF;
    padding: 6px 8px;
    font-weight: 600;
    color: #FFFFFF;
}

QListWidget {
    background-color: #000000;
    border: 2px solid #FFFFFF;
    border-radius: 8px;
    outline: none;
    color: #FFFFFF;
    padding: 4px;
    cursor: url(theme:cursors/win11/arrow.png) 4 3;
}

QListWidget::item {
    padding: 6px 10px;
    border-radius: 6px;
    color: #FFFFFF;
    margin: 1px 2px;
}

QListWidget::item:hover {
    background-color: #1A1A1A;
    color: #FFFF00;
}

QListWidget::item:selected {
    background-color: #FFFF00;
    color: #000000;
}

QListWidget::item:focus {
    outline: 2px solid #FFFF00;
    outline-offset: -3px;
}

/* ---------------------------------------------------------------------
   Context menus
   --------------------------------------------------------------------- */

QMenu {
    background-color: #000000;
    border: 2px solid #FFFFFF;
    border-radius: 8px;
    padding: 6px;
}

QMenu::item {
    background-color: transparent;
    padding: 7px 16px;
    border-radius: 6px;
    margin: 1px 4px;
    color: #FFFFFF;
}

QMenu::item:selected {
    background-color: #FFFF00;
    color: #000000;
}

QMenu::item:disabled {
    color: #7F7F7F;
    background-color: transparent;
}

QMenu::separator {
    height: 2px;
    background-color: #FFFFFF;
    margin: 6px 10px;
}

QProgressBar {
    border: 2px solid #FFFFFF;
    border-radius: 8px;
    background-color: #000000;
    text-align: center;
    color: #FFFFFF;
    min-height: 16px;
}

QProgressBar::chunk {
    background-color: #FFFF00;
    border-radius: 6px;
    margin: 1px;
}

QLabel {
    background: transparent;
    color: #FFFFFF;
}

QSplitter::handle {
    background-color: #000000;
}

QScrollBar:vertical {
    background: #000000;
    width: 14px;
    border: 2px solid #FFFFFF;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background-color: #FFFFFF;
    border-radius: 6px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background-color: #FFFF00;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background: #000000;
    height: 14px;
    border: 2px solid #FFFFFF;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background-color: #FFFFFF;
    border-radius: 6px;
    min-width: 28px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #FFFF00;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* ---------------------------------------------------------------------
   Custom title bar sits directly above the tab widget in a frameless
   window -- drop the pane's top border to avoid a double line/gap.
   --------------------------------------------------------------------- */

QTabWidget#mainTabs::pane {
    border-top: none;
    top: 0px;
}

QToolTip {
    background-color: #000000;
    color: #FFFFFF;
    border: 2px solid #FFFFFF;
    border-radius: 8px;
    padding: 5px 10px;
}

QSizeGrip {
    background-color: #000000;
    width: 16px;
    height: 16px;
}
