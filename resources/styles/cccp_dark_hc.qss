/* Torrent 2000 -- "CCCP" skin, HIGH-CONTRAST DARK variant.

   Matches the real Windows "High Contrast Black" accessibility theme's
   color contract (pure black background, pure white text/borders, yellow
   focus/selection accent, no gradients) while keeping this theme's sharp
   square corners, thick borders, and bold font -- the gold star color
   already IS the high-contrast yellow, so this variant needed barely any
   thematic compromise at all.
*/

* {
    font-family: "Arial", "Segoe UI", sans-serif;
    font-size: 9pt;
}

QMainWindow, QWidget#centralWidget {
    background-color: #000000;
}

QWidget {
    background-color: #000000;
    color: #FFFFFF;
}

QTabWidget::pane {
    border: 2px solid #FFFFFF;
    background-color: #000000;
    top: -1px;
}

QTabBar::tab {
    background-color: #000000;
    border: 2px solid #FFFFFF;
    border-bottom: none;
    padding: 5px 16px;
    margin-right: 1px;
    color: #FFFFFF;
    font-weight: bold;
}

QTabBar::tab:selected {
    background-color: #000000;
    border-color: #FFFF00;
    border-bottom: 2px solid #000000;
    margin-top: 0px;
    color: #FFFF00;
}

QTabBar::tab:!selected {
    margin-top: 2px;
}

QGroupBox {
    border: 2px solid #FFFFFF;
    border-radius: 0px;
    margin-top: 10px;
    padding-top: 6px;
    background-color: #000000;
    font-weight: bold;
    color: #FFFF00;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #FFFF00;
}

QPushButton {
    background-color: #000000;
    border: 2px solid #FFFFFF;
    border-radius: 0px;
    padding: 4px 12px;
    min-height: 18px;
    color: #FFFFFF;
    font-weight: bold;
}

QPushButton:hover:!pressed {
    border: 2px solid #FFFF00;
    color: #FFFF00;
}

QPushButton:pressed {
    background-color: #FFFF00;
    border: 2px solid #FFFF00;
    color: #000000;
}

QPushButton:default {
    border-width: 3px;
}

QPushButton:disabled {
    background-color: #000000;
    border: 2px solid #7F7F7F;
    color: #7F7F7F;
}

QPushButton#dangerButton {
    background-color: #000000;
    border: 2px solid #FFFF00;
    border-radius: 0px;
    padding: 2px 10px;
    min-height: 16px;
    color: #FFFF00;
    font-weight: bold;
}

QPushButton#dangerButton:hover:!pressed {
    background-color: #1A1A00;
    border: 2px solid #FFFF00;
}

QPushButton#dangerButton:pressed {
    background-color: #FFFF00;
    border: 2px solid #FFFF00;
    color: #000000;
}

QLineEdit, QSpinBox, QAbstractSpinBox {
    background-color: #000000;
    border: 2px solid #FFFFFF;
    padding: 2px 4px;
    color: #FFFFFF;
    selection-background-color: #FFFF00;
    selection-color: #000000;
}

QLineEdit:hover, QSpinBox:hover, QAbstractSpinBox:hover {
    border: 2px solid #FFFF00;
}

QComboBox {
    background-color: #000000;
    border: 2px solid #FFFFFF;
    padding: 2px 4px;
    color: #FFFFFF;
}

QComboBox:hover {
    border: 2px solid #FFFF00;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: right;
    width: 20px;
    background-color: #000000;
    border-left: 2px solid #FFFFFF;
}

QComboBox::down-arrow {
    width: 8px;
    height: 8px;
    image: none;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-top: 4px solid #FFFFFF;
}

QComboBox QAbstractItemView {
    background-color: #000000;
    color: #FFFFFF;
    border: 2px solid #FFFF00;
    selection-background-color: #FFFF00;
    selection-color: #000000;
}

QCheckBox::indicator {
    width: 13px;
    height: 13px;
    background-color: #000000;
    border: 2px solid #FFFFFF;
}

QCheckBox::indicator:hover {
    border: 2px solid #FFFF00;
}

QCheckBox::indicator:checked {
    background-color: #FFFF00;
    image: url(theme:checkmark.png);
}

QSlider::groove:horizontal {
    height: 4px;
    background-color: #FFFFFF;
    border: none;
}

QSlider::handle:horizontal {
    width: 14px;
    margin: -6px 0;
    background-color: #FFFF00;
    border: 2px solid #FFFF00;
}

QTableWidget, QTreeWidget {
    background-color: #000000;
    alternate-background-color: #1A1A1A;
    gridline-color: #7F7F7F;
    border: 2px solid #FFFFFF;
    color: #FFFFFF;
    selection-background-color: #FFFF00;
    selection-color: #000000;
}

QHeaderView::section {
    background-color: #000000;
    border: 2px solid #FFFFFF;
    padding: 3px;
    font-weight: bold;
    color: #FFFF00;
}

QProgressBar {
    border: 2px solid #FFFFFF;
    background-color: #000000;
    text-align: center;
    color: #FFFFFF;
    font-weight: bold;
}

QProgressBar::chunk {
    background-color: #FFFF00;
    margin: 1px;
}

QLabel {
    background: transparent;
    color: #FFFFFF;
}

QSplitter::handle {
    background-color: #000000;
}

QScrollBar:vertical {
    background: #000000;
    width: 16px;
    border: 2px solid #FFFFFF;
}

QScrollBar::handle:vertical {
    background-color: #FFFFFF;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background-color: #FFFF00;
}

QTabWidget#mainTabs::pane {
    border-top: none;
    top: 0px;
}

QSizeGrip {
    background-color: #000000;
    width: 16px;
    height: 16px;
}

/* ---------------------------------------------------------------------
   Propaganda side panel (src/torrent2000/ui/widgets/propaganda_panel.py)
   -- the extra strip of window width shown only under this theme.
   --------------------------------------------------------------------- */

QWidget#cccpPropagandaPanel {
    background-color: #000000;
    border-left: 3px solid #FFFFFF;
}

QLabel#propagandaHeader {
    color: #FFFF00;
    font-weight: bold;
    font-size: 10pt;
}

QLabel#propagandaMessage {
    color: #FFFFFF;
    font-size: 9pt;
}

QFrame#propagandaDivider {
    background-color: #FFFF00;
    border: none;
}
