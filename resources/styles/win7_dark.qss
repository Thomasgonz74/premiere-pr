/* Torrent 2000 -- "Windows 7 (Aero)" skin, DARK variant.

   Same glossy gradient control shapes as win7.qss, recolored onto a dark
   base while keeping the Aero accent blue for hover/selection glow.

   Reference colors:
     window background      #1F1F1F
     Aero accent blue        #3D95F2  (hover glow, selection, progress)
     button face gradient    #4A4A4A -> #303030, glassy rounded look
     text                    #F0F0F0
     disabled text           #7A7A7A

   The title bar is NOT drawn by this stylesheet -- see
   src/torrent2000/ui/widgets/app_title_bar.py.
*/

* {
    font-family: "Segoe UI", "MS Shell Dlg 2", sans-serif;
    font-size: 9pt;
}

QMainWindow, QWidget#centralWidget {
    background-color: #1F1F1F;
}

QWidget {
    background-color: #1F1F1F;
    color: #F0F0F0;
}

QTabWidget::pane {
    border: 1px solid #4A4A4A;
    background-color: #1F1F1F;
    top: -1px;
}

QTabBar::tab {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #3A3A3A, stop:1 #26364A);
    border: 1px solid #4A4A4A;
    border-bottom: none;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    padding: 5px 16px;
    margin-right: 2px;
    color: #F0F0F0;
}

QTabBar::tab:selected {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #3A3A3A, stop:1 #1F1F1F);
    border-color: #4A4A4A;
    border-bottom: 1px solid #1F1F1F;
    margin-top: 0px;
}

QTabBar::tab:!selected {
    margin-top: 2px;
}

QGroupBox {
    border: 1px solid #4A4A4A;
    border-radius: 4px;
    margin-top: 10px;
    padding-top: 6px;
    background-color: #1F1F1F;
    font-weight: normal;
    color: #F0F0F0;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #F0F0F0;
}

QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #4A4A4A, stop:0.5 #3A3A3A, stop:1 #2B2B2B);
    border: 1px solid #5A5A5A;
    border-radius: 4px;
    padding: 4px 12px;
    min-height: 18px;
    color: #F0F0F0;
}

QPushButton:hover:!pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #2C3D4F, stop:0.5 #223244, stop:1 #182838);
    border: 1px solid #3D95F2;
}

QPushButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #182838, stop:1 #223244);
    border: 1px solid #2A6FCB;
    padding: 5px 11px 3px 13px;
}

QPushButton:default {
    border-width: 2px;
    border-color: #3D95F2;
}

QPushButton:disabled {
    background: #1F1F1F;
    border: 1px solid #3A3A3A;
    color: #7A7A7A;
}

QPushButton#dangerButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #5A322E, stop:0.5 #4A2622, stop:1 #3A1B18);
    border: 1px solid #8A4A42;
    border-radius: 4px;
    padding: 2px 10px;
    min-height: 16px;
    color: #F0F0F0;
}

QPushButton#dangerButton:hover:!pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #6B3B36, stop:1 #4A2622);
    border: 1px solid #3D95F2;
}

QPushButton#dangerButton:pressed {
    background: #3A1B18;
    border: 1px solid #2A1310;
    padding: 3px 9px 1px 11px;
}

QLineEdit, QSpinBox, QAbstractSpinBox {
    background-color: #2A2A2A;
    border: 1px solid #4A4A4A;
    border-radius: 3px;
    padding: 2px 4px;
    color: #F0F0F0;
    selection-background-color: #3D95F2;
    selection-color: #FFFFFF;
}

QLineEdit:hover, QSpinBox:hover, QAbstractSpinBox:hover {
    border: 1px solid #3D95F2;
}

QComboBox {
    background-color: #2A2A2A;
    border: 1px solid #4A4A4A;
    border-radius: 3px;
    padding: 2px 4px;
    color: #F0F0F0;
}

QComboBox:hover {
    border: 1px solid #3D95F2;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: right;
    width: 20px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #3A3A3A, stop:1 #2B2B2B);
    border-left: 1px solid #4A4A4A;
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
}

QComboBox::down-arrow {
    width: 8px;
    height: 8px;
    image: none;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-top: 4px solid #D0D0D0;
}

QComboBox QAbstractItemView {
    background-color: #2A2A2A;
    color: #F0F0F0;
    border: 1px solid #4A4A4A;
    selection-background-color: #3D95F2;
    selection-color: #FFFFFF;
}

QCheckBox::indicator {
    width: 13px;
    height: 13px;
    background-color: #2A2A2A;
    border: 1px solid #4A4A4A;
    border-radius: 3px;
}

QCheckBox::indicator:hover {
    border: 1px solid #3D95F2;
}

QCheckBox::indicator:checked {
    background-color: #2A2A2A;
    border: 1px solid #3D95F2;
    image: url(theme:checkmark.png);
}

QSlider::groove:horizontal {
    height: 4px;
    background-color: #4A4A4A;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    width: 14px;
    height: 14px;
    margin: -6px 0;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #3A3A3A, stop:1 #223244);
    border: 1px solid #3D95F2;
    border-radius: 7px;
}

QTableWidget, QTreeWidget {
    background-color: #2A2A2A;
    alternate-background-color: #232A34;
    gridline-color: #3A3A3A;
    border: 1px solid #4A4A4A;
    border-radius: 3px;
    color: #F0F0F0;
    selection-background-color: #3D95F2;
    selection-color: #FFFFFF;
}

QHeaderView::section {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #3A3A3A, stop:1 #262626);
    border: 1px solid #4A4A4A;
    padding: 3px;
    font-weight: normal;
    color: #F0F0F0;
}

QProgressBar {
    border: 1px solid #4A4A4A;
    border-radius: 3px;
    background-color: #2A2A2A;
    text-align: center;
    color: #F0F0F0;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #6FC4FB, stop:1 #2A85E0);
    border-radius: 2px;
    margin: 1px;
}

QLabel {
    background: transparent;
    color: #F0F0F0;
}

QSplitter::handle {
    background-color: #1F1F1F;
}

QScrollBar:vertical {
    background: #1F1F1F;
    width: 16px;
    border: 1px solid #3A3A3A;
}

QScrollBar::handle:vertical {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #4A4A4A, stop:1 #3A3A3A);
    border: 1px solid #5A5A5A;
    border-radius: 3px;
    min-height: 24px;
}

QTabWidget#mainTabs::pane {
    border-top: none;
    top: 0px;
}

QSizeGrip {
    background-color: #1F1F1F;
    width: 16px;
    height: 16px;
}
