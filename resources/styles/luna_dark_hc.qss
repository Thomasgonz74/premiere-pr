/* Torrent 2000 -- Windows XP "Luna" skin, HIGH-CONTRAST DARK variant.

   Matches the real Windows "High Contrast Black" accessibility theme's own
   convention -- solid black surfaces, solid white text/borders, and a
   single yellow (#FFFF00) accent for every focus/selection/hot-track
   state -- which is also this project's established universal dark_hc
   convention (see the title bar's dark_hc override in theme_manager.py).
   No gradients, no subtlety: every state must be distinguishable by a
   human with significantly reduced color/contrast perception, so this
   trades Luna's glossy character for flat, maximum-contrast blocks.

   Corner radius stays 0 (square), matching luna.qss/luna_dark.qss and
   window_corner_radius=0 for "luna_xp" in theme_manager.py.
*/

* {
    font-family: "Tahoma", "MS Shell Dlg 2", "Segoe UI", sans-serif;
    font-size: 8pt;
}

QMainWindow, QWidget#centralWidget {
    background-color: #000000;
}

QWidget {
    background-color: #000000;
    color: #FFFFFF;
}

QDialog {
    background-color: #000000;
    color: #FFFFFF;
}

/* Themed pointer -- same shared arrow.png as luna.qss/luna_dark.qss (see
   that file for scope/rationale). The white fill stays fully legible on
   this file's solid #000000 background even though the black outline
   blends into it -- same tradeoff every solid-white OS cursor makes on a
   black background, so no separate HC-only image is warranted. Hotspot
   (4, 3). */
QMainWindow, QWidget#centralWidget, QGroupBox, QTabBar,
QTableWidget, QTreeWidget, QListWidget {
    cursor: url(theme:cursors/luna/arrow.png) 4 3;
}

QTabWidget::pane {
    border: 1px solid #FFFFFF;
    background-color: #000000;
    top: -1px;
}

QTabBar::tab {
    background-color: #000000;
    border: 1px solid #FFFFFF;
    border-bottom: none;
    padding: 5px 16px;
    margin-right: 1px;
    color: #FFFFFF;
}

QTabBar::tab:selected {
    background-color: #000000;
    border-top: 2px solid #FFFF00;
    border-left: 1px solid #FFFFFF;
    border-right: 1px solid #FFFFFF;
    padding-top: 4px;
    color: #FFFF00;
}

QTabBar::tab:!selected {
    margin-top: 2px;
}

QTabBar::tab:hover:!selected {
    border: 1px solid #FFFF00;
    color: #FFFF00;
}

QTabBar::tab:focus {
    outline: none;
}

QGroupBox {
    border: 1px solid #FFFFFF;
    margin-top: 10px;
    padding-top: 6px;
    color: #FFFFFF;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 9px;
    padding: 0 4px;
    color: #FFFF00;
}

QPushButton {
    background-color: #000000;
    border: 2px solid #FFFFFF;
    padding: 3px 13px;
    min-height: 18px;
    color: #FFFFFF;
}

QPushButton:hover:!pressed {
    background-color: #000000;
    border: 2px solid #FFFF00;
    color: #FFFF00;
}

QPushButton:focus {
    outline: 2px solid #FFFF00;
    outline-offset: 2px;
}

QPushButton:pressed {
    background-color: #FFFF00;
    border: 2px solid #FFFF00;
    color: #000000;
}

QPushButton:default {
    border: 2px solid #FFFF00;
}

QPushButton:disabled {
    background-color: #000000;
    border: 2px solid #6E6E6E;
    color: #6E6E6E;
}

QPushButton#dangerButton {
    background-color: #000000;
    border: 2px solid #FF6E5A;
    padding: 3px 13px;
    min-height: 18px;
    color: #FF6E5A;
}

QPushButton#dangerButton:hover:!pressed {
    background-color: #000000;
    border: 2px solid #FFFF00;
    color: #FFFF00;
}

QPushButton#dangerButton:focus {
    outline: 2px solid #FFFF00;
    outline-offset: 2px;
}

QPushButton#dangerButton:pressed {
    background-color: #FF6E5A;
    border: 2px solid #FFFF00;
    color: #000000;
}

QPushButton#dangerButton:disabled {
    background-color: #000000;
    border: 2px solid #6E6E6E;
    color: #6E6E6E;
}

QLineEdit, QSpinBox, QAbstractSpinBox {
    background-color: #000000;
    border: 1px solid #FFFFFF;
    padding: 3px 6px;
    color: #FFFFFF;
    selection-background-color: #FFFF00;
    selection-color: #000000;
}

QLineEdit:hover, QSpinBox:hover, QAbstractSpinBox:hover {
    border: 1px solid #FFFF00;
}

QLineEdit:focus, QSpinBox:focus, QAbstractSpinBox:focus {
    border: 1px solid #FFFF00;
    outline: 2px solid #FFFF00;
    outline-offset: 1px;
}

QLineEdit:disabled, QSpinBox:disabled, QAbstractSpinBox:disabled {
    background-color: #000000;
    border: 1px solid #6E6E6E;
    color: #6E6E6E;
}

QAbstractSpinBox::up-button, QAbstractSpinBox::down-button {
    subcontrol-origin: border;
    width: 16px;
    background-color: #000000;
    border-left: 1px solid #FFFFFF;
}

QAbstractSpinBox::up-button {
    subcontrol-position: top right;
}

QAbstractSpinBox::down-button {
    subcontrol-position: bottom right;
}

QAbstractSpinBox::up-button:hover, QAbstractSpinBox::down-button:hover {
    background-color: #333300;
}

QAbstractSpinBox::up-arrow {
    width: 0;
    height: 0;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-bottom: 4px solid #FFFF00;
}

QAbstractSpinBox::down-arrow {
    width: 0;
    height: 0;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-top: 4px solid #FFFF00;
}

QComboBox {
    background-color: #000000;
    border: 1px solid #FFFFFF;
    padding: 3px 6px;
    min-height: 18px;
    color: #FFFFFF;
    /* Also set here (not just on the popup rule below) -- Qt derives the
       popup's effective palette from the combo box's own computed palette,
       and without this the popup's selection-background-color gets
       silently defeated, leaving the current/selected row unhighlighted
       (verified by rendering the open popup and sampling its pixels). */
    selection-background-color: #FFFF00;
    selection-color: #000000;
}

QComboBox:hover {
    border: 1px solid #FFFF00;
}

QComboBox:focus {
    border: 1px solid #FFFF00;
    outline: 2px solid #FFFF00;
    outline-offset: 1px;
}

QComboBox:disabled {
    background-color: #000000;
    border: 1px solid #6E6E6E;
    color: #6E6E6E;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: right;
    width: 18px;
    border-left: 1px solid #FFFFFF;
    background-color: #000000;
}

QComboBox::drop-down:hover {
    background-color: #333300;
}

QComboBox::down-arrow {
    width: 0;
    height: 0;
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #FFFF00;
}

QComboBox::down-arrow:disabled {
    border-top-color: #6E6E6E;
}

/* Popup list -- the state this family's known bug lives in: the CURRENT/
   selected row must never render white-on-white or black-on-black. Normal
   rows are white-on-black, hover is yellow-on-black, and the selected/
   current row is solid yellow with BLACK text -- maximum contrast in
   every state, verified by rendering the open popup and reading it. */
QComboBox QAbstractItemView {
    background-color: #000000;
    border: 2px solid #FFFF00;
    outline: none;
    padding: 1px;
    color: #FFFFFF;
    selection-background-color: #FFFF00;
    selection-color: #000000;
}

QComboBox QAbstractItemView::item {
    padding: 3px 6px;
    color: #FFFFFF;
    background-color: #000000;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #333300;
    color: #FFFF00;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #FFFF00;
    color: #000000;
}

QCheckBox {
    spacing: 6px;
    color: #FFFFFF;
}

QCheckBox::indicator {
    width: 13px;
    height: 13px;
    background-color: #000000;
    border: 1px solid #FFFFFF;
}

QCheckBox::indicator:hover {
    border: 1px solid #FFFF00;
}

QCheckBox::indicator:focus {
    border: 2px solid #FFFF00;
}

QCheckBox::indicator:checked {
    background-color: #000000;
    border: 1px solid #FFFF00;
    /* Original yellow glyph (assets/icons/luna/) -- the shared
       checkmark.png is solid black on transparent, which on this file's
       black checked background rendered a checked box with NO visible
       checkmark at all (confirmed by rendering it offscreen and sampling
       pixels: 100% black inside the border). #FFFF00 matches the
       universal dark_hc accent used for every other selection/focus
       state in this file. */
    image: url(theme:icons/luna/checkmark_hc.png);
}

QCheckBox::indicator:disabled {
    background-color: #000000;
    border: 1px solid #6E6E6E;
}

QCheckBox:disabled {
    color: #6E6E6E;
}

QSlider::groove:horizontal {
    height: 4px;
    background-color: #000000;
    border: 1px solid #FFFFFF;
}

QSlider::handle:horizontal {
    width: 12px;
    height: 14px;
    margin: -6px 0;
    background-color: #FFFF00;
    border: 1px solid #FFFFFF;
}

QSlider::handle:horizontal:hover {
    background-color: #FFFF66;
}

QSlider::handle:horizontal:focus {
    border: 2px solid #FFFFFF;
    margin: -7px -1px;
}

QSlider::handle:horizontal:disabled {
    background-color: #6E6E6E;
    border: 1px solid #6E6E6E;
}

QSlider::sub-page:horizontal {
    background-color: #FFFF00;
    border: 1px solid #FFFFFF;
}

QTableWidget, QTreeWidget {
    background-color: #000000;
    alternate-background-color: #1A1A1A;
    gridline-color: #6E6E6E;
    border: 1px solid #FFFFFF;
    outline: none;
    selection-background-color: #FFFF00;
    selection-color: #000000;
}

QTableWidget::item:hover, QTreeWidget::item:hover {
    background-color: #333300;
    color: #FFFF00;
}

QHeaderView::section {
    background-color: #000000;
    border: none;
    border-right: 1px solid #FFFFFF;
    border-bottom: 1px solid #FFFFFF;
    padding: 4px 6px;
    font-weight: bold;
    color: #FFFFFF;
}

QHeaderView::section:hover {
    background-color: #333300;
    color: #FFFF00;
}

QListWidget {
    background-color: #000000;
    border: 1px solid #FFFFFF;
    outline: none;
    padding: 1px;
    selection-background-color: #FFFF00;
    selection-color: #000000;
}

QListWidget::item {
    padding: 3px 6px;
    color: #FFFFFF;
}

QListWidget::item:hover {
    background-color: #333300;
    color: #FFFF00;
}

QListWidget::item:selected {
    background-color: #FFFF00;
    color: #000000;
}

QMenu {
    background-color: #000000;
    border: 1px solid #FFFFFF;
    padding: 2px;
}

QMenu::item {
    background-color: transparent;
    padding: 4px 24px 4px 12px;
    color: #FFFFFF;
}

QMenu::item:selected {
    background-color: #FFFF00;
    color: #000000;
}

QMenu::item:disabled {
    color: #6E6E6E;
}

QMenu::separator {
    height: 1px;
    background-color: #FFFFFF;
    margin: 4px 6px;
}

QProgressBar {
    border: 1px solid #FFFFFF;
    background-color: #000000;
    text-align: center;
    color: #FFFFFF;
    min-height: 16px;
}

QProgressBar::chunk {
    background-color: #FFFF00;
}

QLabel {
    background: transparent;
}

QLabel:disabled {
    color: #6E6E6E;
}

QToolTip {
    background-color: #000000;
    border: 2px solid #FFFF00;
    padding: 2px 4px;
    color: #FFFF00;
}

QSplitter::handle {
    background-color: #000000;
}

QSplitter::handle:hover {
    background-color: #333300;
}

QScrollBar:vertical {
    background: #000000;
    width: 17px;
    border-left: 1px solid #FFFFFF;
}

QScrollBar::handle:vertical {
    background-color: #FFFF00;
    border: 1px solid #FFFFFF;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #FFFF66;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 16px;
    background-color: #000000;
    border-top: 1px solid #FFFFFF;
    subcontrol-origin: margin;
}

QScrollBar::add-line:vertical:hover, QScrollBar::sub-line:vertical:hover {
    background-color: #333300;
}

QScrollBar::sub-line:vertical {
    subcontrol-position: top;
    border-top: none;
}

QScrollBar::add-line:vertical {
    subcontrol-position: bottom;
}

QScrollBar::up-arrow:vertical {
    width: 0;
    height: 0;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-bottom: 4px solid #FFFF00;
}

QScrollBar::down-arrow:vertical {
    width: 0;
    height: 0;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-top: 4px solid #FFFF00;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background: #000000;
    height: 17px;
    border-top: 1px solid #FFFFFF;
}

QScrollBar::handle:horizontal {
    background-color: #FFFF00;
    border: 1px solid #FFFFFF;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #FFFF66;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 16px;
    background-color: #000000;
    border-left: 1px solid #FFFFFF;
    subcontrol-origin: margin;
}

QScrollBar::add-line:horizontal:hover, QScrollBar::sub-line:horizontal:hover {
    background-color: #333300;
}

QScrollBar::sub-line:horizontal {
    subcontrol-position: left;
    border-left: none;
}

QScrollBar::add-line:horizontal {
    subcontrol-position: right;
}

QScrollBar::left-arrow:horizontal {
    width: 0;
    height: 0;
    border-top: 3px solid transparent;
    border-bottom: 3px solid transparent;
    border-right: 4px solid #FFFF00;
}

QScrollBar::right-arrow:horizontal {
    width: 0;
    height: 0;
    border-top: 3px solid transparent;
    border-bottom: 3px solid transparent;
    border-left: 4px solid #FFFF00;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

QTabWidget#mainTabs::pane {
    border-top: none;
    top: 0px;
}

QSizeGrip {
    background-color: #000000;
    width: 16px;
    height: 16px;
}
