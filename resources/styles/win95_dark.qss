/* Torrent 2000 -- "Windows 95" skin, DARK variant. Full rebuild.

   Real 95 predates any system dark mode -- there is no screenshot to
   measure here, so unlike win95.qss (built from pixel-sampled real
   screenshots + measured proportions, see that file's header and
   scratchpad/win95research/charte_graphique_win95.md) this is an original
   recoloring: same square-cornered, 2px-bevel grammar and geometric ratios
   as the light variant (2px border/bevel thickness confirmed as Windows
   95's fixed OS metric, not font-relative -- see win95.qss), rebuilt on a
   charcoal base.

   Token palette:
     bg            #454545   window / dialog / menu / button face
     bg-secondary  #202020   editable surfaces: fields, lists, tables, dropdowns
     border-shadow #1C1C1C   dark "shadow" bevel edge / gridline tone
     border-frame  #000000   deepest outer shadow, theme-invariant
     highlight     #767676   stands in for "white" as the raised bevel edge
                             (true white would be jarring on a dark face)
     text          #E6E6E6   window text
     text-muted    #8C8C8C   disabled text
     accent        #33509E   navy-family selection / focus, darkened to sit
                             comfortably on the charcoal face
     accent-hover  #5B8DEF   brighter blue, interactive hover feedback ONLY
                             (same restrained hover-is-a-border-tint approach
                             as the light variant -- 95 itself never had hover)
     danger        #A8433A   brick red, destructive-action accent (kept warm
                             and legible rather than the near-black maroon
                             that would vanish against this dark face)

   Same square corners, same 2px bevels, same absence of gradients as the
   light variant -- only the palette changes. The title bar is NOT drawn
   by this stylesheet -- see src/torrent2000/ui/widgets/app_title_bar.py.

   CURSOR: shares the light variant's assets/cursors/win95/arrow.png
   (a real cursor doesn't reshape itself for dark mode) -- see win95.qss's
   header for the full rationale, hotspot note, and the verified reason
   this can't be wired from a .qss file (Qt Style Sheets don't support a
   general `cursor` property).
*/

* {
    font-family: "MS Sans Serif", "Tahoma", sans-serif;
    font-size: 9pt;
}

QMainWindow, QWidget#centralWidget {
    cursor: url(theme:cursors/win95/arrow.png) 0 0;
    background-color: #454545;
}

QWidget {
    background-color: #454545;
    color: #E6E6E6;
}

/* ---------------------------------------------------------------------
   Tabs
   --------------------------------------------------------------------- */

QTabBar {
    cursor: url(theme:cursors/win95/arrow.png) 0 0;
}

QTabWidget::pane {
    border-width: 2px;
    border-style: solid;
    border-top-color: #767676;
    border-left-color: #767676;
    border-right-color: #000000;
    border-bottom-color: #000000;
    border-radius: 0px;
    background-color: #454545;
    top: -1px;
}

QTabWidget#mainTabs::pane {
    border-top: none;
    top: 0px;
}

QTabBar::tab {
    background-color: #454545;
    border-width: 2px;
    border-style: outset;
    border-top-color: #767676;
    border-left-color: #767676;
    border-right-color: #1C1C1C;
    border-bottom: none;
    border-radius: 0px;
    padding: 4px 14px;
    margin-right: 0px;
    color: #E6E6E6;
}

QTabBar::tab:selected {
    background-color: #454545;
    border-bottom: 2px solid #454545;
    margin-top: 0px;
}

QTabBar::tab:!selected {
    margin-top: 2px;
    color: #C4C4C4;
}

QTabBar::tab:hover:!selected {
    border-top-color: #5B8DEF;
    border-left-color: #5B8DEF;
    color: #E6E6E6;
}

QTabBar::tab:disabled {
    color: #8C8C8C;
}

QTabBar::tab:focus {
    outline: 2px solid #5B8DEF;
    outline-offset: 1px;
}

/* ---------------------------------------------------------------------
   Group boxes -- etched (sunken) frame
   --------------------------------------------------------------------- */

QGroupBox {
    cursor: url(theme:cursors/win95/arrow.png) 0 0;
    border-width: 2px;
    border-style: solid;
    border-top-color: #1C1C1C;
    border-left-color: #1C1C1C;
    border-right-color: #767676;
    border-bottom-color: #767676;
    border-radius: 0px;
    margin-top: 10px;
    padding-top: 6px;
    background-color: #454545;
    font-weight: bold;
    color: #E6E6E6;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #E6E6E6;
}

/* ---------------------------------------------------------------------
   Buttons -- raised bevel, inverts to sunken when pressed
   --------------------------------------------------------------------- */

QPushButton {
    background-color: #454545;
    border-width: 2px;
    border-style: outset;
    border-radius: 0px;
    border-top-color: #767676;
    border-left-color: #767676;
    border-right-color: #000000;
    border-bottom-color: #000000;
    padding: 4px 12px;
    min-height: 18px;
    color: #E6E6E6;
}

QPushButton:hover:!pressed {
    border-top-color: #767676;
    border-left-color: #767676;
    border-right-color: #5B8DEF;
    border-bottom-color: #5B8DEF;
}

QPushButton:focus {
    outline: 2px solid #5B8DEF;
    outline-offset: 2px;
}

QPushButton:pressed {
    background-color: #454545;
    border-style: inset;
    border-top-color: #000000;
    border-left-color: #000000;
    border-right-color: #767676;
    border-bottom-color: #767676;
    padding: 5px 11px 3px 13px;
}

QPushButton:default {
    border-width: 3px;
}

QPushButton:disabled {
    background-color: #454545;
    border-width: 2px;
    border-style: outset;
    border-top-color: #767676;
    border-left-color: #767676;
    border-right-color: #1C1C1C;
    border-bottom-color: #1C1C1C;
    color: #8C8C8C;
}

QPushButton#dangerButton {
    background-color: #6E3C36;
    border-width: 2px;
    border-style: outset;
    border-radius: 0px;
    border-top-color: #8F534B;
    border-left-color: #8F534B;
    border-right-color: #A8433A;
    border-bottom-color: #A8433A;
    padding: 2px 10px;
    min-height: 16px;
    color: #E6E6E6;
}

QPushButton#dangerButton:hover:!pressed {
    border-top-color: #8F534B;
    border-left-color: #8F534B;
    border-right-color: #5B8DEF;
    border-bottom-color: #5B8DEF;
}

QPushButton#dangerButton:focus {
    outline: 2px solid #5B8DEF;
    outline-offset: 2px;
}

QPushButton#dangerButton:pressed {
    background-color: #4A2925;
    border-style: inset;
    border-top-color: #A8433A;
    border-left-color: #A8433A;
    border-right-color: #8F534B;
    border-bottom-color: #8F534B;
    padding: 3px 9px 1px 11px;
}

QPushButton#dangerButton:disabled {
    background-color: #454545;
    border-top-color: #767676;
    border-left-color: #767676;
    border-right-color: #1C1C1C;
    border-bottom-color: #1C1C1C;
    color: #8C8C8C;
}

/* ---------------------------------------------------------------------
   Text fields / spin boxes -- sunken bevel, dark editable surface
   --------------------------------------------------------------------- */

QLineEdit, QSpinBox, QAbstractSpinBox {
    background-color: #202020;
    border-width: 2px;
    border-style: inset;
    border-top-color: #1C1C1C;
    border-left-color: #1C1C1C;
    border-right-color: #767676;
    border-bottom-color: #767676;
    border-radius: 0px;
    padding: 2px 4px;
    color: #E6E6E6;
    selection-background-color: #33509E;
    selection-color: #FFFFFF;
}

QLineEdit:hover, QSpinBox:hover, QAbstractSpinBox:hover {
    border-top-color: #5B8DEF;
    border-left-color: #5B8DEF;
}

QLineEdit:focus, QSpinBox:focus, QAbstractSpinBox:focus {
    outline: 2px solid #5B8DEF;
    outline-offset: 1px;
}

QLineEdit:disabled, QSpinBox:disabled, QAbstractSpinBox:disabled {
    background-color: #454545;
    border-top-color: #1C1C1C;
    border-left-color: #1C1C1C;
    border-right-color: #454545;
    border-bottom-color: #454545;
    color: #8C8C8C;
}

QAbstractSpinBox::up-button, QAbstractSpinBox::down-button {
    subcontrol-origin: border;
    width: 15px;
    background-color: #454545;
    border-width: 1px;
    border-style: outset;
    border-top-color: #767676;
    border-left-color: #767676;
    border-right-color: #000000;
    border-bottom-color: #000000;
}

QAbstractSpinBox::up-button {
    subcontrol-position: top right;
}

QAbstractSpinBox::down-button {
    subcontrol-position: bottom right;
}

QAbstractSpinBox::up-button:pressed, QAbstractSpinBox::down-button:pressed {
    border-style: inset;
    border-top-color: #000000;
    border-left-color: #000000;
    border-right-color: #767676;
    border-bottom-color: #767676;
}

QAbstractSpinBox::up-arrow {
    image: none;
    width: 0px;
    height: 0px;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-bottom: 4px solid #E6E6E6;
}

QAbstractSpinBox::down-arrow {
    image: none;
    width: 0px;
    height: 0px;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-top: 4px solid #E6E6E6;
}

QAbstractSpinBox::up-arrow:disabled, QAbstractSpinBox::down-arrow:disabled {
    border-bottom-color: #8C8C8C;
    border-top-color: #8C8C8C;
}

/* ---------------------------------------------------------------------
   Combo boxes
   --------------------------------------------------------------------- */

QComboBox {
    background-color: #202020;
    border-width: 2px;
    border-style: inset;
    border-top-color: #1C1C1C;
    border-left-color: #1C1C1C;
    border-right-color: #767676;
    border-bottom-color: #767676;
    border-radius: 0px;
    padding: 2px 4px;
    color: #E6E6E6;
    /* Also required on QComboBox itself, not just on the popup's
       QAbstractItemView below -- without this, the popup's currently
       selected row opens with no visible highlight at all (confirmed by
       rendering the popup offscreen; matches the win7 family's own
       documented fix for the same Qt behavior; regression-tested by
       tests/test_theme_qss_validity.py::test_qcombobox_popup_selection_is_actually_visible). */
    selection-background-color: #33509E;
    selection-color: #FFFFFF;
}

QComboBox:hover {
    border-top-color: #5B8DEF;
    border-left-color: #5B8DEF;
}

QComboBox:focus {
    outline: 2px solid #5B8DEF;
    outline-offset: 1px;
}

QComboBox:disabled {
    background-color: #454545;
    color: #8C8C8C;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: right;
    width: 18px;
    background-color: #454545;
    border-width: 2px;
    border-style: outset;
    border-top-color: #767676;
    border-left-color: #767676;
    border-right-color: #000000;
    border-bottom-color: #000000;
}

QComboBox::drop-down:hover {
    border-top-color: #767676;
    border-left-color: #767676;
    border-right-color: #5B8DEF;
    border-bottom-color: #5B8DEF;
}

QComboBox::down-arrow {
    width: 8px;
    height: 8px;
    image: none;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-top: 4px solid #E6E6E6;
}

QComboBox::down-arrow:disabled {
    border-top-color: #8C8C8C;
}

/* Popup list -- explicitly gives every item, including the CURRENTLY
   SELECTED one, its own text color via item:selected so it can never
   land on the same color as its background (the known Windows 7 v1 bug
   this rebuild must not repeat). */
QComboBox QAbstractItemView {
    background-color: #202020;
    color: #E6E6E6;
    border: 2px solid #000000;
    border-radius: 0px;
    padding: 1px;
    outline: none;
    selection-background-color: #33509E;
    selection-color: #FFFFFF;
}

QComboBox QAbstractItemView::item {
    color: #E6E6E6;
    background-color: #202020;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #33509E;
    color: #FFFFFF;
}

/* ---------------------------------------------------------------------
   Checkboxes
   --------------------------------------------------------------------- */

QCheckBox::indicator {
    width: 12px;
    height: 12px;
    background-color: #202020;
    border-width: 2px;
    border-style: inset;
    border-top-color: #1C1C1C;
    border-left-color: #1C1C1C;
    border-right-color: #767676;
    border-bottom-color: #767676;
}

QCheckBox::indicator:checked {
    background-color: #202020;
    image: url(theme:icons/win95/checkmark.png);
}

QCheckBox::indicator:hover {
    border-top-color: #5B8DEF;
    border-left-color: #5B8DEF;
}

QCheckBox::indicator:focus {
    outline: 2px solid #5B8DEF;
    outline-offset: 1px;
}

QCheckBox::indicator:disabled {
    background-color: #454545;
    border-top-color: #1C1C1C;
    border-left-color: #1C1C1C;
    border-right-color: #454545;
    border-bottom-color: #454545;
}

QCheckBox:disabled {
    color: #8C8C8C;
}

/* ---------------------------------------------------------------------
   Sliders
   --------------------------------------------------------------------- */

QSlider::groove:horizontal {
    height: 4px;
    background-color: #1C1C1C;
    border: 2px solid #000000;
}

QSlider::handle:horizontal {
    width: 12px;
    margin: -6px 0;
    background-color: #454545;
    border-width: 2px;
    border-style: outset;
    border-top-color: #767676;
    border-left-color: #767676;
    border-right-color: #000000;
    border-bottom-color: #000000;
}

QSlider::handle:horizontal:hover {
    border-right-color: #5B8DEF;
    border-bottom-color: #5B8DEF;
}

QSlider::handle:horizontal:focus {
    outline: 2px solid #5B8DEF;
    outline-offset: 2px;
}

QSlider::handle:horizontal:disabled {
    border-top-color: #767676;
    border-left-color: #767676;
    border-right-color: #1C1C1C;
    border-bottom-color: #1C1C1C;
}

/* ---------------------------------------------------------------------
   Tables / trees / lists -- sunken bevel, dark content surface
   --------------------------------------------------------------------- */

QTableWidget, QTreeWidget, QListWidget {
    cursor: url(theme:cursors/win95/arrow.png) 0 0;
    background-color: #202020;
    alternate-background-color: #292929;
    gridline-color: #1C1C1C;
    border-width: 2px;
    border-style: inset;
    border-top-color: #1C1C1C;
    border-left-color: #1C1C1C;
    border-right-color: #767676;
    border-bottom-color: #767676;
    border-radius: 0px;
    color: #E6E6E6;
    selection-background-color: #33509E;
    selection-color: #FFFFFF;
    outline: none;
}

QListWidget::item {
    padding: 2px 4px;
}

QListWidget::item:selected {
    background-color: #33509E;
    color: #FFFFFF;
}

QListWidget::item:hover:!selected {
    background-color: rgba(91, 141, 239, 0.22);
    color: #E6E6E6;
}

QHeaderView::section {
    background-color: #454545;
    border-width: 1px;
    border-style: outset;
    border-top-color: #767676;
    border-left-color: #767676;
    border-right-color: #000000;
    border-bottom-color: #000000;
    padding: 3px;
    font-weight: bold;
    color: #E6E6E6;
}

/* ---------------------------------------------------------------------
   Menus -- raised bevel popup
   --------------------------------------------------------------------- */

QMenu {
    background-color: #454545;
    border-width: 2px;
    border-style: outset;
    border-top-color: #767676;
    border-left-color: #767676;
    border-right-color: #000000;
    border-bottom-color: #000000;
    border-radius: 0px;
    padding: 2px;
    color: #E6E6E6;
}

QMenu::item {
    background-color: transparent;
    padding: 4px 22px 4px 20px;
    border: 1px solid transparent;
}

QMenu::item:selected {
    background-color: #33509E;
    color: #FFFFFF;
    border: 1px solid #33509E;
}

QMenu::item:disabled {
    color: #8C8C8C;
}

QMenu::separator {
    height: 2px;
    margin: 4px 2px;
    background-color: #1C1C1C;
    border-bottom: 1px solid #767676;
}

/* ---------------------------------------------------------------------
   Dialogs -- must be styled explicitly: top-level QDialog windows do not
   inherit the generic QWidget background at the OS paint layer, so
   without this rule every dialog falls back to native/white chrome.
   --------------------------------------------------------------------- */

QDialog {
    cursor: url(theme:cursors/win95/arrow.png) 0 0;
    background-color: #454545;
    color: #E6E6E6;
}

/* ---------------------------------------------------------------------
   Misc: progress bar, labels, splitter, scrollbars, size grip, tooltip
   --------------------------------------------------------------------- */

QProgressBar {
    border-width: 2px;
    border-style: solid;
    border-top-color: #1C1C1C;
    border-left-color: #1C1C1C;
    border-right-color: #767676;
    border-bottom-color: #767676;
    border-radius: 0px;
    background-color: #202020;
    text-align: center;
    color: #E6E6E6;
}

QProgressBar::chunk {
    background-color: #33509E;
    margin: 1px;
}

QLabel {
    background: transparent;
    color: #E6E6E6;
}

QLabel:disabled {
    color: #8C8C8C;
}

QSplitter::handle {
    background-color: #454545;
}

QScrollBar:vertical {
    background: #454545;
    width: 16px;
    border: 1px solid #000000;
}

QScrollBar::handle:vertical {
    background-color: #454545;
    border-width: 2px;
    border-style: outset;
    border-top-color: #767676;
    border-left-color: #767676;
    border-right-color: #000000;
    border-bottom-color: #000000;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    border-right-color: #5B8DEF;
    border-bottom-color: #5B8DEF;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    subcontrol-origin: margin;
    height: 16px;
    background-color: #454545;
    border-width: 2px;
    border-style: outset;
    border-top-color: #767676;
    border-left-color: #767676;
    border-right-color: #000000;
    border-bottom-color: #000000;
}

QScrollBar::add-line:vertical {
    subcontrol-position: bottom;
}

QScrollBar::sub-line:vertical {
    subcontrol-position: top;
}

QScrollBar::up-arrow:vertical {
    width: 0px;
    height: 0px;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-bottom: 4px solid #E6E6E6;
}

QScrollBar::down-arrow:vertical {
    width: 0px;
    height: 0px;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-top: 4px solid #E6E6E6;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: #454545;
}

QScrollBar:horizontal {
    background: #454545;
    height: 16px;
    border: 1px solid #000000;
}

QScrollBar::handle:horizontal {
    background-color: #454545;
    border-width: 2px;
    border-style: outset;
    border-top-color: #767676;
    border-left-color: #767676;
    border-right-color: #000000;
    border-bottom-color: #000000;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    border-right-color: #5B8DEF;
    border-bottom-color: #5B8DEF;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    subcontrol-origin: margin;
    width: 16px;
    background-color: #454545;
    border-width: 2px;
    border-style: outset;
    border-top-color: #767676;
    border-left-color: #767676;
    border-right-color: #000000;
    border-bottom-color: #000000;
}

QScrollBar::add-line:horizontal {
    subcontrol-position: right;
}

QScrollBar::sub-line:horizontal {
    subcontrol-position: left;
}

QScrollBar::left-arrow:horizontal {
    width: 0px;
    height: 0px;
    border-top: 3px solid transparent;
    border-bottom: 3px solid transparent;
    border-right: 4px solid #E6E6E6;
}

QScrollBar::right-arrow:horizontal {
    width: 0px;
    height: 0px;
    border-top: 3px solid transparent;
    border-bottom: 3px solid transparent;
    border-left: 4px solid #E6E6E6;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: #454545;
}

QSizeGrip {
    background-color: #454545;
    width: 16px;
    height: 16px;
}

QToolTip {
    background-color: #202020;
    border: 1px solid #767676;
    color: #E6E6E6;
    padding: 3px 6px;
}
